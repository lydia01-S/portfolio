---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

import StuTabs from '../components/StuTabs.astro';

import assetsImg from '../../public/assets.png';
import iconsImg from '../../public/icons.png';
import card1Img from '../../public/card1.png';
import card2Img from '../../public/card2.png';
import card3Img from '../../public/card3.png';
import card4Img from '../../public/card4.png';
import card5Img from '../../public/card5.png';


const colorTokens = [
  { name: 'Brand purple', hex: '#7500F3', usage: 'Main buttons, active states and brand accents', contrast: 'White text 6.9:1 (AA)' },
  { name: 'Dark surface', hex: '#18181B', usage: 'Dark buttons, headers and heavy text', contrast: 'White text 17.7:1 (AAA)' },
  { name: 'Accent lime', hex: '#D4FF00', usage: 'Highlight pills, status labels and badges', contrast: 'Dark text 15.3:1 (AAA)' },
  { name: 'Neutral canvas', hex: '#F6F5F0', usage: 'Page background and light card fills', contrast: 'Dark text 16.2:1 (AAA)' },
];

// Every number here can be checked on this page.
const systemMetrics = [
  { value: "4", label: "Core colour tokens", detail: "Each paired with a text colour and checked for contrast.", color: "sage" },
  { value: "AA", label: "Every core pairing", detail: "All four pass WCAG 2.1 AA for text, and three pass AAA.", color: "mint" },
  { value: "3", label: "Button states", detail: "Default, active and disabled, each with icon variants.", color: "lavender" }
];


// Example: { label: "Heading", meta: "Inter Bold, 28px", family: "'Inter', sans-serif", size: "1.75rem", weight: 700, sample: "Today's deadlines" }
const type: { label: string; meta: string; family: string; size: string; weight: number; sample: string }[] = [];

const components = [
  { cls: "alert-banner", tag: "Alert banner", img: card4Img, alt: "Alert banner component with icon and message" },
  { cls: "side-card", tag: "Navigation module", img: card2Img, alt: "Side navigation module component" },
  { cls: "testimonial-card", tag: "Callout block", img: card3Img, alt: "Callout block component" },
  { cls: "purple-card", tag: "Info card", img: card1Img, alt: "Information card in brand purple" },
  { cls: "accordion-item", tag: "Accordion", img: card5Img, alt: "Accordion component, expanded" },
];


---

<Layout title="STU: design system" bg="#fbfaf4">

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,500;0,700;1,500&family=JetBrains+Mono:wght@500;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <div class="progress" aria-hidden="true"><div id="bar"></div></div>
  <a class="skip" href="#content">Skip to design system</a>

  <main class="sg" id="sg">
    <div class="container">

      <header class="sg-header reveal">
        <StuTabs current="system" />

        <div class="hero">
          <p class="chips">
            <span class="chip" style="--c: var(--lavender)">Design system</span>
            <span class="chip" style="--c: var(--mint)" id="readTime">2 min read</span>
          </p>
          <h1>STU design system</h1>
          <p class="lead">The colours, buttons, icons and cards behind every STU screen. Students told me they value simplicity over looks, so the system is small: a few strong colours, rounded pill buttons and cards that stack the same way on phone and web.</p>

          <div class="kpis">
            {systemMetrics.map((m) => (
              <div class="kpi" style={`--c: var(--${m.color})`}>
                <p class="kpi-value">{m.value}</p>
                <p class="kpi-label">{m.label}</p>
                <p class="kpi-detail">{m.detail}</p>
              </div>
            ))}
          </div>
        </div>
      </header>

      <div id="content">
        <section class="card token-section reveal" id="tokens" aria-labelledby="tokens-title">
          <div class="card-header">
            <div>
              <h2 id="tokens-title">Colour</h2>
              <p class="desc">Four core colours, each checked against the text that sits on it. Select a swatch to copy its hex code.</p>
            </div>
            <span class="chip" style="--c: var(--sage)">Tokens</span>
          </div>
          <div class="color-grid">
            {colorTokens.map((c) => (
              <button type="button" class="swatch copy-token" data-hex={c.hex} aria-label={`Copy hex code ${c.hex} for ${c.name}`}>
                <span class="swatch-preview" style={`background-color: ${c.hex};`}>
                  <span class="toast" aria-hidden="true">Copy hex</span>
                </span>
                <span class="swatch-info">
                  <span class="swatch-head"><span class="swatch-name">{c.name}</span><code>{c.hex}</code></span>
                  <span class="swatch-usage">{c.usage}</span>
                  <span class="swatch-contrast">{c.contrast}</span>
                </span>
              </button>
            ))}
          </div>
          <p class="sr" role="status" id="copyStatus"></p>
        </section>

        {type.length > 0 && (
          <section class="card token-section reveal" aria-labelledby="type-title">
            <div class="card-header">
              <div>
                <h2 id="type-title">Typography</h2>
                <p class="desc">The type scale used across the app.</p>
              </div>
              <span class="chip" style="--c: var(--yellow)">Type</span>
            </div>
            <div class="specimen">
              {type.map((t) => (
                <div class="spec-row">
                  <p class="spec-meta">{t.label}<br />{t.meta}</p>
                  <p class="spec-sample" style={`font-family:${t.family};font-size:${t.size};font-weight:${t.weight}`}>{t.sample}</p>
                </div>
              ))}
            </div>
          </section>
        )}

        <div class="kit-grid">
          <section class="card full reveal" aria-labelledby="buttons-title">
            <div class="card-header">
              <div>
                <h2 id="buttons-title">Buttons and states</h2>
                <p class="desc">Pill buttons in dark and outline styles, with and without icons.</p>
              </div>
              <span class="chip" style="--c: var(--amber)">Components</span>
            </div>

            <div class="rows">
              <div class="state-row">
                <div><p class="state-label">Default</p><p class="state-hint">Ready to use</p></div>
                <div class="btn-group">
                  <button type="button" class="btn btn-dark">Submit work</button>
                  <button type="button" class="btn btn-dark">Open brief <span aria-hidden="true">↗</span></button>
                  <button type="button" class="btn btn-dark icon-only" aria-label="Open">↗</button>
                  <button type="button" class="btn btn-outline">View grades</button>
                  <button type="button" class="btn btn-outline">Open brief <span aria-hidden="true">↗</span></button>
                  <button type="button" class="btn btn-outline icon-only" aria-label="Open">↗</button>
                </div>
              </div>
              <div class="state-row">
                <div><p class="state-label">Active</p><p class="state-hint">Selected or pressed</p></div>
                <div class="btn-group">
                  <button type="button" class="btn btn-purple">Submit work</button>
                  <button type="button" class="btn btn-purple">Open brief <span aria-hidden="true">↗</span></button>
                  <button type="button" class="btn btn-purple icon-only" aria-label="Open">↗</button>
                  <button type="button" class="btn btn-dark2">View grades</button>
                  <button type="button" class="btn btn-dark2">Open brief <span aria-hidden="true">↗</span></button>
                  <button type="button" class="btn btn-purple2 icon-only" aria-label="Open">↗</button>
                </div>
              </div>
              <div class="state-row">
                <div><p class="state-label">Disabled</p><p class="state-hint">Not available yet</p></div>
                <div class="btn-group">
                  <button type="button" class="btn btn-disabled" disabled>Submit work</button>
                  <button type="button" class="btn btn-disabled" disabled>Open brief <span aria-hidden="true">↗</span></button>
                  <button type="button" class="btn btn-disabled icon-only" disabled aria-label="Open">↗</button>
                  <button type="button" class="btn btn-outline-disabled" disabled>View grades</button>
                  <button type="button" class="btn btn-outline-disabled" disabled>Open brief <span aria-hidden="true">↗</span></button>
                  <button type="button" class="btn btn-outline-disabled icon-only" disabled aria-label="Open">↗</button>
                </div>
              </div>
            </div>
          </section>

          <section class="card reveal">
            <div class="card-header"><div><h2>Brand assets</h2><p class="desc">The mascot, badges and logo marks.</p></div></div>
            <button type="button" class="zoom preview" aria-label="Enlarge brand assets">
              <Image src={assetsImg} alt="STU brand assets: mascot, badges and logo marks" class="preview-img" loading="lazy" />
            </button>
          </section>
          <section class="card reveal">
            <div class="card-header"><div><h2>Icons</h2><p class="desc">Vector icons for navigation and actions.</p></div></div>
            <button type="button" class="zoom preview" aria-label="Enlarge icons">
              <Image src={iconsImg} alt="STU vector icon set for navigation and actions" class="preview-img icons-img" loading="lazy" />
            </button>
          </section>
          <section class="card full reveal">
            <div class="card-header"><div><h2>Cards and blocks</h2><p class="desc">The building blocks of the home screen and course pages. Select one to enlarge it.</p></div></div>
            <div class="components">
              {components.map((c) => (
                <figure class="component">
                  <button type="button" class="zoom" aria-label={`Enlarge ${c.tag.toLowerCase()}`}>
                    <Image class="card-img" src={c.img} alt={c.alt} loading="lazy" />
                  </button>
                  <figcaption>{c.tag}</figcaption>
                </figure>
              ))}
            </div>
          </section>
        </div>
      </div>
      <p class="end"><a class="end-link" href="/stu">Back to the STU case study</a></p>
    </div>

    <button type="button" id="top" class="top" aria-label="Back to top">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 15l-6-6-6 6"/></svg>
    </button>

    <dialog id="lightbox" aria-label="Enlarged image">
      <button type="button" id="closeLb" class="close">Close</button>
      <img id="lbImg" alt="" />
    </dialog>
  </main>
</Layout>

<script>
  function init() {
    const root = document.getElementById('sg');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    root.classList.add('js');
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const rt = document.getElementById('readTime');
    const words = (root.textContent || '').trim().split(/\s+/).length;
    if (rt) rt.textContent = `${Math.max(1, Math.ceil(words / 220))} min read`;

    const bar = document.getElementById('bar');
    const top = document.getElementById('top');
    const onScroll = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      if (bar) bar.style.width = `${max > 0 ? (scrollY / max) * 100 : 0}%`;
      top?.classList.toggle('show', scrollY > 300);
    };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    top?.addEventListener('click', () => scrollTo({ top: 0, behavior: still ? 'auto' : 'smooth' }));

    const reveal = new IntersectionObserver((es) => es.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add('visible'); reveal.unobserve(e.target); }
    }), { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.reveal').forEach((el) => reveal.observe(el));

    // Copy hex tokens
    const status = document.getElementById('copyStatus');
    document.querySelectorAll<HTMLButtonElement>('.copy-token').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const hex = btn.dataset.hex;
        const toast = btn.querySelector('.toast');
        if (!hex || !toast) return;
        let msg = 'Copied!';
        try { await navigator.clipboard.writeText(hex); } catch { msg = 'Copy failed'; }
        toast.textContent = msg;
        toast.classList.add('copied');
        if (status) status.textContent = msg === 'Copied!' ? `${hex} copied to clipboard` : 'Could not copy. Select the hex code manually.';
        setTimeout(() => { toast.textContent = 'Copy hex'; toast.classList.remove('copied'); }, 1800);
      });
    });

    // Lightbox
    const lb = document.getElementById('lightbox') as HTMLDialogElement | null;
    const lbImg = document.getElementById('lbImg') as HTMLImageElement | null;
    document.querySelectorAll<HTMLButtonElement>('.zoom').forEach((b) => b.addEventListener('click', () => {
      const img = b.querySelector('img');
      if (!lb || !lbImg || !img) return;
      lbImg.src = img.currentSrc || img.src; lbImg.alt = img.alt; lb.showModal();
    }));
    document.getElementById('closeLb')?.addEventListener('click', () => lb?.close());
    lb?.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
  }
  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .sg {
    --bg: #fbfaf4; --card: #fff; --ink: #1f2430; --muted: #5a6070; --border: #d3d6df;
    --deep: #3f6b52; --shadow: 0 8px 28px rgba(31, 36, 48, .08);
    --yellow: #f6e7b0; --sage: #b5d0bf; --mint: #d0e1d4; --amber: #efd3ac; --lavender: #d3c6ea;
    --brand: #7500f3;
    --serif: 'Bodoni Moda', 'Playfair Display', Georgia, serif;
    --mono: 'JetBrains Mono', ui-monospace, monospace;
    --sans: 'Inter', system-ui, -apple-system, sans-serif;
    background: var(--bg); color: var(--ink); font: 16px/1.65 var(--sans); -webkit-font-smoothing: antialiased;
    min-height: 100vh; padding: 24px 24px 120px;
  }
  .container { max-width: 1200px; margin: 0 auto; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .sg a { color: inherit; }
  .sg :focus-visible, .top:focus-visible { outline: 3px solid var(--deep); outline-offset: 3px; border-radius: 8px; }
  .skip { position: absolute; left: -999px; top: 8px; z-index: 100; background: #fff; color: #1f2430; padding: 10px 18px; border-radius: 999px; font: 600 14px 'Inter', sans-serif; }
  .skip:focus { left: 16px; }
  .progress { position: fixed; inset: 0 0 auto 0; height: 4px; z-index: 50; pointer-events: none; }
  #bar { height: 100%; width: 0; background: var(--deep); }
  h1, h2 { font-family: var(--serif); font-weight: 500; margin: 0; text-wrap: balance; }
  p { margin: 0; }

  .chip { display: inline-block; font: 500 12px/1 var(--mono); background: var(--c); color: var(--ink); padding: 7px 12px; border-radius: 999px; white-space: nowrap; }
  .chips { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 18px; }

  /* Header */
  .sg-header { margin-bottom: 40px; }
  .hero { background: var(--card); border: 1px solid var(--border); border-radius: 20px; box-shadow: var(--shadow); padding: 48px; }
  h1 { font-size: clamp(2.5rem, 4.8vw, 4rem); line-height: 1.08; margin-bottom: 18px; }
  .lead { font-size: 18px; line-height: 1.6; color: #2d3340; max-width: 62ch; margin-bottom: 40px; }
  .kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; padding-top: 32px; border-top: 1px solid var(--border); }
  .kpi { background: var(--bg); border: 1px solid var(--border); border-top: 6px solid var(--c); border-radius: 16px; padding: 22px; }
  .kpi-value { font: 500 2.8rem/1 var(--serif); margin-bottom: 10px; }
  .kpi-label { font: 600 14px var(--mono); margin-bottom: 4px; }
  .kpi-detail { font-size: 14px; color: var(--muted); }

  /* Cards */
  .card { background: var(--card); border: 1px solid var(--border); border-radius: 20px; box-shadow: var(--shadow); padding: 36px; }
  .card-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; margin-bottom: 28px; padding-bottom: 16px; border-bottom: 1px solid var(--border); }
  .card-header h2 { font-size: 1.8rem; line-height: 1.2; margin-bottom: 4px; }
  .desc { font-size: 14px; color: var(--muted); max-width: 70ch; }
  .token-section { margin-bottom: 28px; }
  .kit-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
  .full { grid-column: 1 / -1; }
  .kit-grid > .card:not(.full) { display: flex; flex-direction: column; }
  .kit-grid > .card:not(.full) .preview { flex: 1; }

  /* Swatches */
  .color-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 16px; }
  .swatch { display: block; text-align: left; padding: 0; font: inherit; color: inherit; background: var(--card); border: 1px solid var(--border); border-radius: 16px; overflow: hidden; cursor: pointer; transition: transform .2s, border-color .2s, box-shadow .2s; }
  .swatch:hover { transform: translateY(-3px); border-color: var(--ink); box-shadow: var(--shadow); }
  .swatch-preview { height: 88px; display: flex; align-items: center; justify-content: center; border-bottom: 1px solid var(--border); }
  .toast { font: 600 12px var(--mono); background: var(--ink); color: #fff; padding: 6px 12px; border-radius: 999px; opacity: 0; transform: translateY(4px); transition: opacity .2s, transform .2s; }
  .swatch:hover .toast, .swatch:focus-visible .toast, .toast.copied { opacity: 1; transform: none; }
  .toast.copied { background: #d4ff00; color: #0d0d0d; }
  .swatch-info { display: block; padding: 16px; }
  .swatch-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 6px; }
  .swatch-name { font-weight: 600; font-size: 15px; }
  .swatch code { font: 600 12px var(--mono); color: var(--ink); background: var(--bg); padding: 3px 8px; border-radius: 6px; }
  .swatch-usage, .swatch-contrast { display: block; font-size: 13px; color: var(--muted); line-height: 1.45; }
  .swatch-contrast { margin-top: 8px; font: 500 12px var(--mono); color: var(--ink); }

  /* Typography */
  .specimen { border: 1px solid var(--border); border-radius: 14px; overflow: hidden; }
  .spec-row { display: grid; grid-template-columns: 170px 1fr; gap: 24px; align-items: baseline; padding: 20px 24px; border-bottom: 1px solid var(--border); }
  .spec-row:last-child { border-bottom: 0; }
  .spec-meta { font: 500 12px/1.5 var(--mono); color: var(--muted); }
  .spec-sample { line-height: 1.2; }

  /* Buttons */
  .rows { display: flex; flex-direction: column; gap: 14px; }
  .state-row { display: grid; grid-template-columns: 170px 1fr; align-items: center; gap: 16px; padding: 18px; border-radius: 14px; background: var(--bg); border: 1px solid var(--border); }
  .state-label { font-weight: 600; font-size: 14px; }
  .state-hint { font-size: 13px; color: var(--muted); }
  .btn-group { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
  .btn { padding: 10px 18px; min-height: 44px; border-radius: 999px; font: 600 14px var(--sans); border: 0; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 6px; transition: transform .2s, box-shadow .2s; }
  .btn:not([disabled]):hover { transform: translateY(-2px); box-shadow: 0 6px 14px rgba(31, 36, 48, .12); }
  .btn-dark { background: #18181b; color: #fff; }
  .btn-dark2 { background: #261493; color: #fff; }
  .btn-purple { background: var(--brand); color: #fff; }
  .btn-purple2 { background: #5600b3; color: #fff; }
  .btn-outline { background: #fff; border: 1px solid #8a8a93; color: #18181b; }
  .btn-disabled { background: #e4e4e7; color: #52525b; cursor: not-allowed; }
  .btn-outline-disabled { background: transparent; border: 1px dashed #8a8a93; color: #52525b; cursor: not-allowed; }
  .icon-only { width: 44px; padding: 0; border-radius: 50%; }

  /* Assets and components */
  .preview { display: flex; justify-content: center; align-items: center; width: 100%; padding: 20px; background: var(--bg); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; cursor: zoom-in; transition: border-color .2s; }
  .preview:hover { border-color: var(--ink); }
  .preview-img { width: 100%; height: auto; display: block; object-fit: contain; transition: transform .35s; }
  .preview:hover .preview-img { transform: scale(1.02); }
  .icons-img { max-width: 300px; }
  .components { columns: 2; column-gap: 20px; }
  .component { margin: 0 0 20px; break-inside: avoid; background: var(--bg); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; transition: transform .2s, border-color .2s; }
  .component:hover { transform: translateY(-3px); border-color: var(--ink); }
  .component .zoom { display: block; width: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; }
  .component figcaption { margin: 0; padding: 10px 14px; font: 500 12px var(--mono); color: var(--muted); border-top: 1px solid var(--border); background: var(--card); }
  .card-img { width: 100%; height: auto; display: block; }

  dialog { border: 0; border-radius: 16px; padding: 12px; max-width: min(1200px, 94vw); max-height: 94vh; background: var(--card); }
  dialog::backdrop { background: rgba(31, 36, 48, .7); }
  dialog img { max-width: 100%; max-height: 82vh; display: block; margin: 12px auto 0; }
  .close { font: 600 13px var(--mono); min-height: 44px; padding: 0 16px; border-radius: 999px; border: 1px solid var(--border); background: var(--bg); cursor: pointer; }

  .end { margin-top: 72px; text-align: center; }
  .end-link { display: inline-flex; align-items: center; min-height: 48px; font: 600 13px var(--mono); text-decoration: none; padding: 0 24px; border: 1px solid var(--border); border-radius: 999px; background: var(--card); transition: background .2s; }
  .end-link:hover { background: var(--mint); }
  .top { position: fixed; right: 24px; bottom: 24px; width: 48px; height: 48px; display: grid; place-items: center; background: var(--ink); color: #fff; border: 0; border-radius: 50%; box-shadow: var(--shadow); cursor: pointer; opacity: 0; visibility: hidden; z-index: 90; transition: opacity .2s, visibility .2s, transform .2s, background .2s; }
  .top.show { opacity: 1; visibility: visible; }
  .top:hover { background: var(--deep); transform: translateY(-2px); }

  /* Hidden state applies only when JS runs and motion is allowed */
  @media (prefers-reduced-motion: no-preference) {
    .js .reveal { opacity: 0; transform: translateY(20px); transition: opacity .6s ease, transform .6s ease; }
    .js .reveal.visible { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .swatch, .btn, .component, .preview-img, .top { transition: none; }
    .swatch:hover, .btn:not([disabled]):hover, .component:hover { transform: none; }
  }

  @media (max-width: 900px) {
    .kit-grid, .kpis { grid-template-columns: 1fr; }
    .hero { padding: 28px 22px; }
    .card { padding: 24px; }
    .state-row, .spec-row { grid-template-columns: 1fr; gap: 12px; }
    .components { columns: 1; }
    .card-header { flex-direction: column; }
  }
    @media (max-width: 768px) {
    .sg { padding: 0 0 72px; }
    .hero { padding: 24px 18px; }
    .card { padding: 20px; }
    .color-grid { grid-template-columns: 1fr; }
    .state-row { padding: 14px; }
  }
</style>