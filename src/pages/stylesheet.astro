---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';

// Import image assets directly for Astro image processing
import assetsImg from '../../public/assets.png';
import iconsImg from '../../public/icons.png';
import card1Img from '../../public/card1.png';
import card2Img from '../../public/card2.png';
import card3Img from '../../public/card3.png';
import card4Img from '../../public/card4.png';
import card5Img from '../../public/card5.png';
---

<Layout title="STU: UI Kit & Style Guide">
  <main class="style-guide-bg">
    
    <!-- Header & Navigation -->
    <header class="sg-header reveal-on-scroll">
      <div class="header-top">
        <a href="/work" class="back-link" aria-label="Back to Work">← Back to Work</a>
        
        <nav class="project-nav" aria-label="Project Sections">
          <a href="/stylesheet" class="nav-tab active">Style Guide</a>
          <a href="/wireframe" class="nav-tab">Wireframes & Site Map</a>
          <a href="/research" class="nav-tab">Research</a>
        </nav>
      </div>

      <div class="header-content">
        <span class="section-tag">Design System</span>
        <h1 class="sg-title">UI Kit & Style Guide</h1>
        <p class="sg-subtitle">
          Foundational design tokens, button states, typography, and reusable component libraries powering the STU platform.
        </p>
      </div>
    </header>

    <!-- UI Kit Grid Container -->
    <div class="ui-kit-grid">
      
      <!-- TOP ROW: Buttons Section (Full Width) -->
      <section class="ui-card full-width reveal-on-scroll">
        <div class="card-header">
          <h2 class="card-title">Buttons & Interactive States</h2>
          <span class="card-badge">Base Components</span>
        </div>
        
        <div class="table-container">
          <div class="state-row">
            <span class="state-label">Default</span>
            <div class="btn-group">
              <button class="btn btn-dark">Button Title</button>
              <button class="btn btn-dark">Button Title <span class="icon">↗</span></button>
              <button class="btn btn-dark icon-only">↗</button>
              <button class="btn btn-outline">Button Title</button>
              <button class="btn btn-outline">Button Title <span class="icon">↗</span></button>
              <button class="btn btn-dark icon-only">↗</button>
            </div>
          </div>

          <div class="state-row">
            <span class="state-label">Pressed</span>
            <div class="btn-group">
              <button class="btn btn-purple">Button Title</button>
              <button class="btn btn-purple">Button Title <span class="icon">↗</span></button>
              <button class="btn btn-purple icon-only">↗</button>
              <button class="btn btn-dark2">Button Title</button>
              <button class="btn btn-dark2">Button Title <span class="icon">↗</span></button>
              <button class="btn btn-purple2 icon-only">↗</button>
            </div>
          </div>

          <div class="state-row">
            <span class="state-label">Disabled</span>
            <div class="btn-group">
              <button class="btn btn-disabled">Button Title</button>
              <button class="btn btn-disabled">Button Title <span class="icon">↗</span></button>
              <button class="btn btn-disabled icon-only">↗</button>
              <button class="btn btn-outline-disabled">Button Title</button>
              <button class="btn btn-outline-disabled">Button Title <span class="icon">↗</span></button>
              <button class="btn btn-outline-disabled icon-only">↗</button>
            </div>
          </div>
        </div>
      </section>

      <!-- LEFT COLUMN: Assets & Icons -->
      <div class="column-left">
        <!-- Assets -->
        <section class="ui-card reveal-on-scroll">
          <div class="card-header">
            <h2 class="card-title">Assets & Branding</h2>
          </div>
          <div class="asset-preview-wrapper">
            <Image id="assets" src={assetsImg} alt="UI Assets" class="preview-img" />
          </div>
        </section>

        <!-- Icons -->
        <section class="ui-card reveal-on-scroll">
          <div class="card-header">
            <h2 class="card-title">System Icons</h2>
          </div>
          <div class="asset-preview-wrapper">
            <Image id="icons" src={iconsImg} alt="UI Icons" class="preview-img icons-img" />
          </div>
        </section>
      </div>

      <!-- RIGHT COLUMN: Cards & Other Components -->
      <div class="column-right">
        <section class="ui-card reveal-on-scroll">
          <div class="card-header">
            <h2 class="card-title">Cards & Modules</h2>
          </div>
          <div class="components-stack">
            
            <!-- Alert Banner -->
            <div class="component-item alert-banner">
              <Image class="card-img" src={card4Img} alt="Alert Card Component" />
            </div>

            <!-- Side Card -->
            <div class="component-item side-card">
              <Image class="card-img" src={card2Img} alt="Side Navigation Card Component" />
            </div>

            <!-- Testimonial Card -->
            <div class="component-item testimonial-card">
              <Image class="card-img" src={card3Img} alt="Testimonial Card Component" />
            </div>

            <!-- Address / Purple Info Block -->
            <div class="component-item purple-card">
              <Image class="card-img" src={card1Img} alt="Information Block Component" />
            </div>

            <!-- Accordion items -->
            <div class="component-item accordion-item">
              <Image class="card-img" src={card5Img} alt="Accordion Menu Component" />
            </div>

          </div>
        </section>
      </div>

    </div>
  </main>

</Layout>

<script>
  // Scroll Reveal Observer
  function initScrollReveal() {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });

    document.querySelectorAll('.reveal-on-scroll').forEach(el => observer.observe(el));
  }

  document.addEventListener('DOMContentLoaded', initScrollReveal);
  document.addEventListener('astro:page-load', initScrollReveal);
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

  html {
    scroll-behavior: smooth;
  }

  /* --- Base Typography & Reset --- */
  .style-guide-bg,
  .style-guide-bg p,
  .style-guide-bg span,
  .style-guide-bg button,
  .style-guide-bg a {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  .style-guide-bg h1,
  .style-guide-bg h2 {
    font-family: 'Bodoni Moda', 'Playfair Display', serif;
  }

  .style-guide-bg {
    background-color: #f8f7f4;
    color: #1a1a1a;
    min-height: 100vh;
    padding: 40px 5% 120px;
    max-width: 1280px;
    margin: 0 auto;
  }

  /* --- Scroll Reveal Animations --- */
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), 
                transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .reveal-on-scroll.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* --- Header & Sub-Navigation --- */
  .sg-header {
    margin-bottom: 50px;
  }

  .header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 32px;
    flex-wrap: wrap;
    gap: 16px;
  }

  .back-link {
    font-size: 14px;
    font-weight: 500;
    color: #666;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: #000;
  }

  .project-nav {
    display: flex;
    background: #eae8e1;
    padding: 4px;
    border-radius: 100px;
    gap: 4px;
  }

  .nav-tab {
    padding: 6px 16px;
    font-size: 13px;
    font-weight: 500;
    color: #555;
    text-decoration: none;
    border-radius: 100px;
    transition: all 0.2s ease;
  }

  .nav-tab.active,
  .nav-tab:hover {
    background: #ffffff;
    color: #0c0c0c;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  }

  .section-tag {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #7500f3;
    display: block;
    margin-bottom: 8px;
  }

  .sg-title {
    font-size: clamp(2.2rem, 4.5vw, 3.6rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }

  .sg-subtitle {
    font-size: 17px;
    line-height: 1.5;
    color: #555;
    max-width: 680px;
  }

  /* --- Outer Layout Grid --- */
  .ui-kit-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .full-width {
    grid-column: 1 / -1;
  }

  .column-left,
  .column-right {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* --- UI Card Container Base --- */
  .ui-card {
    background: #ffffff;
    border: 1px solid #e5e3dc;
    border-radius: 20px;
    padding: 28px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.02);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 1px solid #f0eee6;
  }

  .card-title {
    font-size: 1.4rem;
    font-weight: 400;
  }

  .card-badge {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    background: #f0eafc;
    color: #7500f3;
    padding: 4px 10px;
    border-radius: 100px;
  }

  /* --- Button Grid & Rows --- */
  .table-container {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .state-row {
    display: grid;
    grid-template-columns: 100px 1fr;
    align-items: center;
    gap: 12px;
  }

  .state-label {
    font-size: 13px;
    color: #71717a;
    font-weight: 500;
  }

  .btn-group {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }

  /* Button Styles */
  .btn {
    padding: 10px 20px;
    border-radius: 100px;
    font-size: 13px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.2s ease;
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .btn-dark { background: #18181b; color: #fff; }
  .btn-dark2 { background: #261493; color: #fff; }
  .btn-purple { background: #7500f3; color: #fff; }
  .btn-purple2 { background: #5600b3; color: #fff; }
  .btn-outline { background: transparent; border: 1px solid #d4d4d8; color: #18181b; }
  .btn-disabled { background: #e4e4e7; color: #a1a1aa; cursor: not-allowed; }
  .btn-outline-disabled { background: transparent; border: 1px solid #e4e4e7; color: #a1a1aa; cursor: not-allowed; }
  
  .icon-only {
    padding: 10px 14px;
    border-radius: 50%;
  }

  /* --- Image Previews --- */
  .asset-preview-wrapper {
    background: #fbfbf9;
    border: 1px solid #f0ede6;
    border-radius: 12px;
    padding: 16px;
    display: flex;
    justify-content: center;
  }

  .preview-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }

  .icons-img {
    max-width: 320px;
  }

  /* --- Components Stack --- */
  .components-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .component-item {
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.2s ease;
  }

  .component-item:hover {
    transform: translateY(-2px);
  }

  .alert-banner,
  .testimonial-card {
    flex: 1 1 calc(58% - 6px);
  }

  .side-card,
  .purple-card {
    flex: 1 1 calc(42% - 6px);
  }

  .accordion-item {
    flex: 1 1 100%;
  }

  .card-img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 12px;
  }

  /* --- Responsive Styles --- */
  @media (max-width: 860px) {
    .ui-kit-grid {
      grid-template-columns: 1fr;
    }

    .state-row {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .alert-banner,
    .side-card,
    .testimonial-card,
    .purple-card {
      flex: 1 1 100%;
    }

    .header-top {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>