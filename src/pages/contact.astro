---
// src/pages/contact.astro
import Layout from '../layouts/Layout.astro';

const email = "lydiastew01@gmail.com";
const phone = "087 453 7335"; // set to "" to hide it
const tel = phone ? '+353' + phone.replace(/\s/g, '').replace(/^0/, '') : '';
const cvHref = "/cv.pdf"; 


const profiles: { label: string; href: string }[] = [
  // { label: "LinkedIn", href: "https://www.linkedin.com/in/your-name" },
];

const replyTime = "I usually reply within two working days.";

const reasons = [
  { title: "Graduate UI roles", text: "I'm looking for a team where I can work on real projects from day one and learn from experienced designers.", color: "mint" },
  { title: "Questions about my work", text: "Happy to talk through any project in more detail, including the decisions that didn't make it onto the page.", color: "yellow" },
  { title: "Feedback on my portfolio", text: "If something in my work could be better, I'd genuinely like to hear it.", color: "lavender" }
];
---

<Layout title="Contact: Lydia Stewart" bg="#fbfaf4">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,500;0,700;1,500&family=JetBrains+Mono:wght@500;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <a class="skip" href="#main">Skip to content</a>

  <main class="contact-page" id="main">
    <div class="inner">
      <header class="hero">
        <p class="chips">
          <span class="chip" style="--c: var(--yellow)">Contact</span>
        
        </p>
        <h1>Let's talk.</h1>
        <p class="lead">Whether it's a role, a question about my work or feedback on my portfolio, the quickest way to reach me is by email. {replyTime}</p>
      </header>

      <section class="card" aria-labelledby="reach">
        <h2 id="reach" class="sr">Ways to reach me</h2>

        <div class="primary">
          <p class="label">Email</p>
          <a class="email" href={`mailto:${email}`}>{email}</a>
          <div class="email-actions">
            <a class="btn dark" href={`mailto:${email}`}>Write an email</a>
            <button type="button" class="btn" id="copyEmail" data-email={email}>Copy address</button>
          </div>
          <p class="status" id="copyStatus" role="status" aria-live="polite"></p>
        </div>

        <dl class="details">
          {phone && (
            <div>
              <dt class="label">Phone</dt>
              <dd><a href={`tel:${tel}`}>{phone}</a></dd>
            </div>
          )}
          <div>
            <dt class="label">CV</dt>
            <dd><a href={cvHref} download>Download my CV <span class="hint">(PDF)</span></a></dd>
          </div>
          {profiles.map((p) => (
            <div>
              <dt class="label">{p.label}</dt>
              <dd><a href={p.href} target="_blank" rel="noopener noreferrer">View profile<span class="sr"> (opens in a new tab)</span></a></dd>
            </div>
          ))}
        </dl>
      </section>

      <section class="reasons" aria-labelledby="why">
        <h2 id="why">Good reasons to get in touch.</h2>
        <div class="cards">
          {reasons.map((r) => (
            <article style={`--c: var(--${r.color})`}><h3>{r.title}</h3><p>{r.text}</p></article>
          ))}
        </div>
      </section>

      <p class="more">
        <a class="btn" href="/work">See my work</a>
        <a class="btn" href="/aboutMe">More about me</a>
      </p>
    </div>
  </main>
</Layout>

<script>
  function initContact() {
    const btn = document.getElementById('copyEmail') as HTMLButtonElement | null;
    const status = document.getElementById('copyStatus');
    if (!btn || btn.dataset.ready) return;
    btn.dataset.ready = '1';
    btn.addEventListener('click', async () => {
      const address = btn.dataset.email || '';
      try {
        await navigator.clipboard.writeText(address);
        btn.textContent = 'Copied';
        if (status) status.textContent = `${address} copied to your clipboard.`;
      } catch {
        if (status) status.textContent = `Couldn't copy automatically. The address is ${address}.`;
      }
      setTimeout(() => { btn.textContent = 'Copy address'; }, 2000);
    });
  }
  initContact();
  document.addEventListener('astro:page-load', initContact);
</script>

<style>
  .contact-page {
    --card: #fff; --ink: #1f2430; --muted: #5a6070; --border: #d3d6df; --border-strong: #868c9a;
    --deep: #3f6b52; --shadow: 0 8px 28px rgba(31, 36, 48, .08);
    --yellow: #f6e7b0; --mint: #d0e1d4; --lavender: #d3c6ea;
    --serif: 'Bodoni Moda', Georgia, serif; --mono: 'JetBrains Mono', ui-monospace, monospace;
    background: transparent; color: var(--ink); font: 16px/1.65 'Inter', system-ui, sans-serif; -webkit-font-smoothing: antialiased;
  }
  .contact-page :focus-visible { outline: 3px solid var(--deep); outline-offset: 3px; border-radius: 6px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .skip { position: absolute; left: -999px; top: 8px; z-index: 100; background: #fff; color: var(--ink); padding: 10px 18px; border-radius: 999px; font: 600 14px 'Inter', sans-serif; }
  .skip:focus { left: 16px; }
  h1, h2, h3 { font-family: var(--serif); font-weight: 500; margin: 0; text-wrap: balance; }
  p { margin: 0; }
  .inner { max-width: 1000px; margin: 0 auto; padding: 72px 24px 48px; }

  /* Hero */
  .chips { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 20px; }
  .chip { font: 500 12px/1 var(--mono); background: var(--c); padding: 7px 12px; border-radius: 999px; }
  h1 { font-size: clamp(3rem, 8vw, 5.5rem); line-height: 1; letter-spacing: -0.02em; margin-bottom: 20px; }
  .lead { font-size: 19px; line-height: 1.6; color: #2d3340; max-width: 54ch; }

  /* Contact card */
  .card { margin-top: 56px; display: grid; grid-template-columns: 1.5fr 1fr; gap: 40px 56px; background: var(--card); border: 1px solid var(--border); border-radius: 24px; box-shadow: var(--shadow); padding: clamp(28px, 5vw, 48px); }
  .label { font: 500 12px/1.4 var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); margin-bottom: 8px; }
  .email { display: inline-block; font: 500 clamp(1.5rem, 3.6vw, 2.4rem)/1.2 var(--serif); color: var(--ink); text-decoration: underline; text-decoration-color: rgba(31, 36, 48, .3); text-underline-offset: 6px; overflow-wrap: anywhere; transition: text-decoration-color .2s; }
  .email:hover { text-decoration-color: var(--ink); }
  .email-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  .status { min-height: 1.5em; margin-top: 10px; font-size: 14px; color: var(--deep); }

  .details { margin: 0; display: grid; gap: 22px; align-content: start; padding-left: 40px; border-left: 1px solid var(--border); }
  .details dd { margin: 0; }
  .details dd a { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; font-size: 17px; font-weight: 500; color: var(--ink); text-decoration: underline; text-decoration-color: rgba(31, 36, 48, .3); text-underline-offset: 5px; }
  .details dd a:hover { text-decoration-color: var(--ink); }
  .hint { font-size: 14px; color: var(--muted); }

  /* Buttons */
  .btn { display: inline-flex; align-items: center; min-height: 48px; padding: 0 24px; border-radius: 999px; border: 1px solid var(--border-strong); background: var(--card); color: var(--ink); font: 600 15px 'Inter', system-ui, sans-serif; text-decoration: none; cursor: pointer; transition: background .2s, border-color .2s; }
  .btn:hover { background: var(--mint); border-color: var(--ink); }
  .btn.dark { background: var(--ink); border-color: var(--ink); color: #fff; }
  .btn.dark:hover { background: var(--deep); border-color: var(--deep); }

  /* Reasons */
  .reasons { margin-top: 96px; }
  .reasons h2 { font-size: clamp(1.6rem, 2.4vw, 2.2rem); line-height: 1.25; margin-bottom: 28px; }
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .cards article { background: var(--card); border: 1px solid var(--border); border-top: 6px solid var(--c); border-radius: 16px; padding: 22px; box-shadow: var(--shadow); }
  .cards h3 { font-size: 1.2rem; margin-bottom: 8px; }
  .cards p { font-size: 15px; color: #333a48; }

  .more { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 64px; }

  @media (max-width: 860px) {
    .card { grid-template-columns: 1fr; }
    .details { padding-left: 0; padding-top: 28px; border-left: 0; border-top: 1px solid var(--border); }
    .cards { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .btn, .email { transition: none; }
  }
</style>