---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import CritterTabs from '../components/CritterTabs.astro';
import ProjectNav from '../components/ProjectNav.astro';
// Replace this file with your own Figma version of the audit (see Figure 1 below).
import audit from '../../public/critter-audit-preview.png';

// Keep the Role consistent with "My role" on the research page.
const metadata = [
  { label: "Role", value: "Co-creator with Thea Rummel: research, interface planning and front-end coding" },
  { label: "Timeline", value: "Final dissertation, 8-week sprint" }, // check the 8 weeks is right
  { label: "Scope", value: "Web game, trading cards and UX research" },
  { label: "Tools", value: "Next.js, Three.js, HTML/CSS, Illustrator (Thea)" } // check this list is right
];

const kpis = [
  { text: "5–8", label: "Age range", detail: "Primary school children, with a short tutorial for the controls.", color: "mint" },
  { text: "9", label: "Native Irish species", detail: "Drawn with recognisable anatomy, after a visit to the National Museum of Ireland.", color: "coral" },
  { text: "0", label: "Timers or leaderboards", detail: "A calm collection loop instead of points.", color: "sage" }
];

const hero = {
  img: "/critter/critter-woodland.jpg",
  alt: "The hand-drawn woodland scene with the back button, information button and a progress counter"
};

// Each screen ties a finding to the decision it led to. These match the Decisions section of the research page.
const screens = [
  { img: "/critter/critter-party.jpg", title: "Hospitality, not capture", insight: "Research on children and nature suggested that catching threatened insects teaches ownership, not respect.", decision: "You deliver birthday party invitations to insect neighbours, and the party is the finale.", alt: "The birthday party finale: the entomologist and insect guests around a table with a Happy Birthday banner" },
  { img: "/critter/critter-cards-menu.png", title: "A calm collection loop", insight: "Children need immediate feedback without competitive pressure.", decision: "Trading cards unlock in a collapsible drawer, with a progress counter in the corner.", alt: "The trading card drawer showing three unlocked insect cards" },
  { img: "/critter/critter-woodland.jpg", title: "Controls in the same place every time", insight: "Nested menus disorient young users, and targets must be large.", decision: "Full-screen scenes with edge-anchored controls: back at top left, information and audio at top right, counter at bottom right.", alt: "The hand-drawn woodland scene with the back button, information button and a progress counter" },
  { img: "/critter/critter-cards.png", title: "Real facts, real anatomy", insight: "Specimens at the museum showed what makes each insect recognisable.", decision: "Insects keep realistic anatomy, and every card pairs real facts with a character.", alt: "All nine insect trading cards in a row" }
];

const nav = [
  ["context", "Context"], ["problem", "Problem"], ["goals", "Goals"], ["process", "Process"],
  ["solution", "Solution"], ["interface", "Interface"], ["reflections", "Reflections"], ["next", "Next steps"]
];
---

<Layout title="Critter & Friends: Case Study" bg="#fbfaf4">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,500;0,700;1,500&family=JetBrains+Mono:wght@500;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <div class="progress" aria-hidden="true"><div id="bar"></div></div>
  <a class="skip" href="#content">Skip to case study</a>

  <main class="cs" id="cs">
    <header class="hero">
      <div class="inner">
        <CritterTabs current="overview" />

        <div class="hero-grid">
          <div>
            <p class="chips">
              <span class="chip" style="--c: var(--yellow)">Case study</span>
              <span class="chip" style="--c: var(--mint)" id="readTime">3 min read</span>
            </p>
            <h1>Critter &amp; Friends: A digital game about Irish insects</h1>
            <p class="lead">A browser-based game that teaches children aged 5 to 8 basic computer skills while they meet nine native Irish insects, by delivering birthday party invitations to them.</p>
            <a class="cta" target="_blank" rel="noopener noreferrer" href="https://critterandfriends.netlify.app/">
              Play the live game
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3.5 10.5l7-7m0 0H4.67m5.83 0v5.83" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span class="sr">(opens in a new tab)</span>
            </a>
          </div>
          <dl class="specs" aria-label="Project overview">
            {metadata.map((m) => (<div><dt>{m.label}</dt><dd>{m.value}</dd></div>))}
          </dl>
        </div>

        <div class="devices single" role="group" aria-label="Key Critter and Friends screen">
          <figure class="device"><img class="device-img" src={hero.img} alt={hero.alt} loading="eager" /></figure>
        </div>

        <div class="kpis">
          {kpis.map((k) => (
            <div class="kpi" style={`--c: var(--${k.color})`}>
              <p class="kpi-value">{k.text}</p>
              <p class="kpi-label">{k.label}</p>
              <p class="kpi-detail">{k.detail}</p>
            </div>
          ))}
        </div>
      </div>
    </header>

    <div class="layout">
      <aside class="toc-wrap">
        <nav class="toc" aria-label="On this page">
          <p class="toc-title">On this page</p>
          {nav.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
        </nav>
      </aside>

      <div class="content" id="content">
        <section id="context" class="reveal">
          <span class="chip" style="--c: var(--sage)">01 Context</span>
          <div class="cols">
            <h2>A playful web game that helps children take their first steps online, and meet the insects on their doorstep.</h2>
            <div class="prose">
              <p>Critter &amp; Friends was my final dissertation project, co-created with Thea Rummel. Children aged 5 to 8 can find dense web interfaces hard, and few tools teach them about local wildlife.</p>
              <p>We built a game where hand-drawn native Irish insects guide each task, so children pick up computer basics in a calm, friendly space.</p>
            </div>
          </div>
        </section>

        <section id="problem" class="reveal">
          <span class="chip" style="--c: var(--coral)">02 Problem</span>
          <div class="cols">
            <h2>Existing tools are either too dry for children or too generic to teach them about Irish nature.</h2>
            <div class="prose">
              <ul class="bullets">
                <li><strong>Scientific databases:</strong> accurate records, but text-heavy and formal.</li>
                <li><strong>Educational games:</strong> reward quick points over understanding local nature.</li>
                <li><strong>Our own first idea:</strong> collecting threatened species risked teaching ownership instead of respect.</li>
              </ul>
            </div>
          </div>
        </section>

        <figure class="shot reveal">
          <div class="shot-bar" style="--c: var(--yellow)"><span>Figure 1: A site built for adults</span><span class="hint">Click to enlarge</span></div>
          <button class="zoom" type="button" aria-label="Enlarge figure 1"><Image class="shot-img" src={audit} alt="Screenshot of the National Biodiversity Data Centre homepage, with text-only menus and specialist terms" loading="lazy" /></button>
          <figcaption>The National Biodiversity Data Centre homepage works well for adult researchers, but not for a five-year-old. Text-only menus, specialist words and numbers without context all assume a confident reader. Screenshot: biodiversityireland.ie, October 2026.</figcaption>
        </figure>

        <section id="goals" class="reveal">
          <span class="chip" style="--c: var(--mint)">03 Goals</span>
          <div class="cols">
            <h2>Make insects feel like friends, and keep learning playful.</h2>
            <div class="prose">
              <ul class="bullets">
                <li><strong>Friends, not specimens:</strong> personified characters with accurate science.</li>
                <li><strong>Calm play:</strong> a collection loop with no timers or leaderboards.</li>
                <li><strong>Simple interactions:</strong> full-screen scenes, large targets and short text, with optional narration.</li>
              </ul>
            </div>
          </div>
        </section>

        <section id="process" class="reveal">
          <span class="chip" style="--c: var(--lavender)">04 Process</span>
          <div class="cols">
            <h2>Research first, then a live site tested with educators.</h2>
            <div class="prose">
              <ul class="bullets">
                <li><strong>Literature review and competitor audit:</strong> to find the gap between dry databases and generic games.</li>
                <li><strong>Museum visit:</strong> photographed specimens with the curator of entomology at the National Museum of Ireland.</li>
                <li><strong>Personas:</strong> a primary learner and an educator.</li>
                <li><strong>Educator testing:</strong> feedback from primary school educators at one school. <a href="/crit-research">See the research</a></li>
              </ul>
              <p>Educators found the tutorial froze if you clicked Continue early, and that buzzing insects looked like glitches. They also found saved progress didn't match the screen after a restart. We haven't tested with children yet.</p>
            </div>
          </div>
        </section>

        <section id="solution" class="reveal">
          <span class="chip" style="--c: var(--sage)">05 Solution</span>
          <div class="cols">
            <h2>A birthday party story told through hand-drawn scenes.</h2>
            <div class="prose">
              <ul class="bullets">
                <li><strong>Hospitality story:</strong> you deliver invitations to insect neighbours.</li>
                <li><strong>Trading cards:</strong> real facts paired with characters, in a collapsible drawer.</li>
                <li><strong>Minimal interface:</strong> few controls, each one a hand-drawn icon by Thea, planned together so a child never has to press many buttons. The look is a children's book.</li>
                <li><strong>Light interaction:</strong> clicking and hovering on clickable insects, introduced by a short tutorial. <a href="/crit-stylesheet">Explore the design system</a></li>
                <li><strong>Accessibility:</strong> designed towards WCAG 2.1 AA, with known gaps (keyboard navigation and focus indicators) listed on the research page.</li>
              </ul>
            </div>
          </div>
        </section>

        <section id="interface" class="reveal">
          <span class="chip" style="--c: var(--sage)">06 Interface</span>
          <h2>Every screen answers one need.</h2>
          <div class="rows">
            {screens.map((s, i) => (
              <article class={`row ${i % 2 ? 'flip' : ''}`}>
                <button type="button" class="zoom phone" aria-label={`Enlarge ${s.title.toLowerCase()}`}>
                  <img class="phone-img" src={s.img} alt={s.alt} loading="lazy" />
                </button>
                <div>
                  <h3>{s.title}</h3>
                  <p><strong>Insight:</strong> {s.insight}</p>
                  <p><strong>Decision:</strong> {s.decision}</p>
                </div>
              </article>
            ))}
          </div>
          <p class="more"><a href="/crit-stylesheet">Explore the design system</a><a href="/crit-research">Read the UX research</a></p>
        </section>

        <section id="reflections" class="reveal">
          <span class="chip" style="--c: var(--amber)">07 Reflections</span>
          <div class="cards">
            <article style="--c: var(--mint)"><h3>Design the message, not just the mechanic</h3><p>Catching insects contradicted our conservation message. Changing the story to hospitality fixed it.</p></article>
            <article style="--c: var(--yellow)"><h3>Motion can read as an error</h3><p>Animation meant to feel lively looked like a glitch to educators. I would tune it to signal "clickable" without looking broken.</p></article>
            <article style="--c: var(--lavender)"><h3>Accessibility starts in the first build</h3><p>Keyboard control and focus indicators weren't in version one. I would plan them from the start.</p></article>
          </div>
        </section>

        <section id="next" class="reveal">
          <span class="chip" style="--c: var(--coral)">08 Next steps</span>
          <div class="cols">
            <h2>Test with children, then fix what testing found.</h2>
            <div class="prose">
              <p>Next I would run structured usability testing with primary school children, fix the tutorial freeze and saved progress, and add keyboard controls, focus indicators and audio cues on hover.</p>
            </div>
          </div>
        </section>
      </div>
    </div>

    <ProjectNav current="critter" />

    <button id="top" class="top" type="button" aria-label="Back to top">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 15l-6-6-6 6"/></svg>
    </button>

    <dialog id="lightbox" aria-label="Enlarged figure">
      <button type="button" id="closeLb" class="close">Close</button>
      <img id="lbImg" alt="" />
    </dialog>
  </main>
</Layout>

<script>
  function init() {
    const root = document.getElementById('cs');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    root.classList.add('js');
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Reading time
    const rt = document.getElementById('readTime');
    const words = (document.getElementById('content')?.textContent || '').trim().split(/\s+/).length;
    if (rt) rt.textContent = `${Math.max(1, Math.ceil(words / 200))} min read`;

    // Progress bar, back-to-top
    const bar = document.getElementById('bar');
    const top = document.getElementById('top');
    const onScroll = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      if (bar) bar.style.width = `${max > 0 ? (scrollY / max) * 100 : 0}%`;
      top?.classList.toggle('show', scrollY > 500);
    };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    top?.addEventListener('click', () => scrollTo({ top: 0, behavior: still ? 'auto' : 'smooth' }));

    // Active section in the index
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
    const spy = new IntersectionObserver((es) => es.forEach((e) => {
      if (e.isIntersecting) links.forEach((a) => a.toggleAttribute('aria-current', a.hash === `#${e.target.id}`));
    }), { rootMargin: '-20% 0px -70% 0px' });
    document.querySelectorAll('.content section').forEach((s) => spy.observe(s));

    // Reveal on scroll
    const reveal = new IntersectionObserver((es) => es.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add('visible'); reveal.unobserve(e.target); }
    }), { threshold: 0.1 });
    document.querySelectorAll('.reveal').forEach((el) => reveal.observe(el));

    // Lightbox for figures
    const lb = document.getElementById('lightbox') as HTMLDialogElement | null;
    const lbImg = document.getElementById('lbImg') as HTMLImageElement | null;
    document.querySelectorAll<HTMLButtonElement>('.zoom').forEach((b) => b.addEventListener('click', () => {
      const img = b.querySelector('img');
      if (!lb || !lbImg || !img) return;
      lbImg.src = img.currentSrc || img.src; lbImg.alt = img.alt; lb.showModal();
    }));
    document.getElementById('closeLb')?.addEventListener('click', () => lb?.close());
    lb?.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
  }
  init();
  document.addEventListener('astro:page-load', init);
</script>


<style>
  .cs {
    --bg: #fbfaf4; --card: #fff; --ink: #1f2430; --muted: #5a6070; --border: #d3d6df;
    --deep: #3f6b52; --shadow: 0 8px 28px rgba(31, 36, 48, .08);
    --yellow: #f6e7b0; --sage: #b5d0bf; --mint: #d0e1d4; --coral: #f0b7ab; --amber: #efd3ac; --lavender: #d3c6ea;
    --serif: 'Bodoni Moda', 'Playfair Display', Georgia, serif;
    --mono: 'JetBrains Mono', ui-monospace, monospace;
    --sans: 'Inter', system-ui, -apple-system, sans-serif;
    background: var(--bg); color: var(--ink); font: 16px/1.65 var(--sans); -webkit-font-smoothing: antialiased; min-height: 100vh;
  }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .cs a { color: inherit; }
  .cs :focus-visible, .top:focus-visible { outline: 3px solid var(--deep); outline-offset: 3px; border-radius: 6px; }
  .progress { position: fixed; inset: 0 0 auto 0; height: 4px; z-index: 50; pointer-events: none; }
  #bar { height: 100%; width: 0; background: var(--deep); }
  h1, h2, h3 { font-family: var(--serif); font-weight: 500; margin: 0; text-wrap: balance; }
  ul { list-style: none; margin: 0; padding: 0; }

  .chip { display: inline-block; font: 500 12px/1 var(--mono); background: var(--c); color: var(--ink); padding: 7px 12px; border-radius: 999px; margin-bottom: 16px; }
  .chips { display: flex; gap: 8px; flex-wrap: wrap; margin: 0 0 16px; }
  .chips .chip { margin: 0; }

  /* Hero */
  .hero { border-bottom: 1px solid var(--border); padding: 24px 0 72px; }
  .inner { max-width: 1100px; margin: 0 auto; padding: 0 24px; }
  .hero-grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: 64px; align-items: start; }
  h1 { font-size: clamp(2.5rem, 4.6vw, 4rem); line-height: 1.08; margin-bottom: 20px; }
  .lead { font-size: 18px; line-height: 1.6; color: #2d3340; max-width: 56ch; margin: 0 0 32px; }
  .cta { display: inline-flex; align-items: center; gap: 10px; background: var(--ink); color: #fff !important; font-weight: 600; text-decoration: none; padding: 14px 26px; border-radius: 999px; transition: transform .2s, background .2s; }
  .cta:hover { background: var(--deep); transform: translateY(-2px); }
  .specs { margin: 0; background: var(--card); border: 1px solid var(--border); border-radius: 16px; box-shadow: var(--shadow); padding: 24px; display: grid; gap: 16px; }
  .specs dt { font: 500 12px var(--mono); color: var(--muted); }
  .specs dd { margin: 2px 0 0; font-weight: 600; }

  .kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 56px; }
  .kpi { background: var(--card); border: 1px solid var(--border); border-top: 6px solid var(--c); border-radius: 16px; padding: 24px; box-shadow: var(--shadow); }
  .kpi-value { font: 500 3rem/1 var(--serif); margin: 0 0 10px; }
  .kpi-label { font: 600 14px var(--mono); margin: 0 0 4px; }
  .kpi-detail { font-size: 14px; color: var(--muted); margin: 0; }

  /* Layout and nav */
  .layout { max-width: 1100px; margin: 0 auto; padding: 80px 24px 120px; display: grid; grid-template-columns: 200px 1fr; gap: 64px; align-items: start; }
  .toc-wrap { position: sticky; top: 32px; }
  .toc { display: flex; flex-direction: column; }
  .toc-title { font: 500 12px var(--mono); color: var(--muted); margin: 0 0 8px; }
  .toc a { font-size: 14px; text-decoration: none; color: var(--muted); padding: 7px 0 7px 14px; border-left: 2px solid var(--border); transition: color .2s, border-color .2s; }
  .toc a:hover { color: var(--ink); }
  .toc a[aria-current] { color: var(--ink); font-weight: 600; border-left-color: var(--deep); background: linear-gradient(90deg, var(--mint), transparent); }

  section { margin-bottom: 96px; scroll-margin-top: 32px; }
  .cols { display: grid; grid-template-columns: 42% 58%; gap: 40px; align-items: start; }
  h2 { font-size: clamp(1.6rem, 2.4vw, 2.2rem); line-height: 1.25; }
  .prose { line-height: 1.7; color: #333a48; max-width: 62ch; }
  .prose p { margin: 0 0 14px; }
  .bullets { margin-top: 14px; }
  .bullets li { position: relative; padding-left: 22px; margin-bottom: 10px; }
  .bullets li::before { content: ""; position: absolute; left: 0; top: .7em; width: 8px; height: 8px; border-radius: 2px; background: var(--deep); }

  /* Figures and lightbox */
  .shot { margin: 0 0 96px; background: var(--card); border: 1px solid var(--border); border-radius: 16px; box-shadow: var(--shadow); padding: 14px; }
  .shot-bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; background: var(--c); border-radius: 10px; padding: 8px 14px; margin-bottom: 14px; font: 500 12px var(--mono); }
  .hint { color: #3a4050; }
  .zoom { display: block; width: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; border-radius: 10px; overflow: hidden; }
  .shot img, .shot-img { width: 100%; height: auto; display: block; background: var(--mint); min-height: 180px; transition: transform .4s; }
  .zoom:hover img { transform: scale(1.015); }
  figcaption { margin-top: 12px; font-size: 13px; color: var(--muted); }
  dialog { border: 0; border-radius: 16px; padding: 12px; max-width: min(1200px, 94vw); max-height: 94vh; background: var(--card); }
  dialog::backdrop { background: rgba(31, 36, 48, .7); }
  dialog img { max-width: 100%; max-height: 82vh; display: block; margin: 12px auto 0; }
  .close { font: 600 13px var(--mono); padding: 10px 16px; border-radius: 999px; border: 1px solid var(--border); background: var(--bg); cursor: pointer; }

  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .cards article { background: var(--card); border: 1px solid var(--border); border-top: 6px solid var(--c); border-radius: 16px; padding: 22px; box-shadow: var(--shadow); transition: transform .2s; }
  .cards article:hover { transform: translateY(-3px); }
  .cards h3 { font-size: 1.15rem; margin-bottom: 8px; }
  .cards p { margin: 0; font-size: 14px; color: #333a48; }

  .top { position: fixed; right: 24px; bottom: 24px; width: 48px; height: 48px; display: grid; place-items: center; background: var(--ink); color: #fff; border: 0; border-radius: 50%; box-shadow: var(--shadow); cursor: pointer; opacity: 0; visibility: hidden; transition: opacity .2s, visibility .2s, transform .2s; }
  .top.show { opacity: 1; visibility: visible; }
  .top:hover { transform: translateY(-2px); background: var(--deep); }

  .skip { position: absolute; left: -999px; top: 8px; z-index: 100; background: #fff; color: #1f2430; padding: 10px 18px; border-radius: 999px; font: 600 14px 'Inter', sans-serif; }
  .skip:focus { left: 16px; }

  .devices { display: flex; justify-content: center; align-items: flex-end; gap: 20px; margin-top: 56px; padding: 40px 24px 0; background: linear-gradient(var(--mint), var(--sage)); border-radius: 24px 24px 0 0; overflow: hidden; }
  .device { margin: 0; width: min(270px, 29%); }
  .device-img { width: 100%; height: auto; display: block; border-radius: 22px 22px 0 0; box-shadow: 0 24px 48px -20px rgba(31, 36, 48, .45); }

  #interface h2 { margin: 4px 0 0; max-width: 24ch; }
  .rows { display: grid; gap: 72px; margin-top: 48px; }
  /* The screens are landscape, so the image column is wider than a phone frame */
  .row { display: grid; grid-template-columns: minmax(280px, 480px) 1fr; gap: 56px; align-items: center; }
  .row.flip { grid-template-columns: 1fr minmax(280px, 480px); }
  .row.flip .phone { order: 2; }
  .phone { width: 100%; padding: 6px; background: var(--card); border: 1px solid var(--border); border-radius: 16px; box-shadow: var(--shadow); overflow: hidden; transition: transform .25s, border-color .25s; }
  .phone:hover { transform: translateY(-4px); border-color: var(--ink); }
  .phone-img { width: 100%; height: auto; display: block; border-radius: 10px; }
  .row h3 { font-size: 1.7rem; margin-bottom: 14px; }
  .row p { margin: 0 0 12px; max-width: 52ch; color: #333a48; }
  .row p strong { color: var(--ink); }
  .more { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 56px; }
  .more a { font: 600 13px var(--mono); text-decoration: none; padding: 12px 20px; border: 1px solid var(--border); border-radius: 999px; background: var(--card); transition: background .2s; }
  .more a:hover { background: var(--mint); }

  /* One wide screenshot in the hero */
  .devices.single { padding-top: 32px; }
  .devices.single .device { width: min(760px, 100%); }
  .devices.single .device-img { border-radius: 14px 14px 0 0; }

  /* Reveal is only hidden when JS is running, and never for reduced motion */
  @media (prefers-reduced-motion: no-preference) {
    .js .reveal { opacity: 0; transform: translateY(20px); transition: opacity .6s ease, transform .6s ease; }
    .js .reveal.visible { opacity: 1; transform: none; }
  }

