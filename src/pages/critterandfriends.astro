---
import Layout from '../layouts/Layout.astro';
import { ClientRouter } from 'astro:transitions';

// Project details
const project = {
  title: "Critter & Friends",
  subtitle: "An interactive, browser-based game experience",
  category: "Web Design & Game Design",
  year: "2026",
  role: "Co-UI/UX Designer, Co-Frontend Developer & Researcher",
  tools: ["Next.js", "HTML/CSS", "JavaScript", "After Effects", "Three.js", "Adobe Illustrator"],
  videoSrc: "/dr.crit2.mp4",
  posterSrc: "/critterandfriends.png",
  liveUrl: "https://critterandfriends.netlify.app/"
};
---

<Layout title="Critter & Friends — Case Study">
  <ClientRouter />

  <main class="case-study-page">
    
    <!-- Top Navigation Bar with Slide Transitions -->
    <div class="top-nav-row reveal-on-scroll">
      <a href="/work" class="back-link">← Back to Portfolio</a>
      <nav class="project-tabs" aria-label="Project Sections">
        <a href="/work/critter-and-friends" class="tab-link active" transition:animate="slide">Overview</a>
        <a href="/work/critter-and-friends/research" class="tab-link" transition:animate="slide">Research</a>
        <a href="/crit-stylesheet" class="tab-link" transition:animate="slide">Design System</a>
      </nav>
    </div>

    <!-- Case Study Header -->
    <header class="case-study-header reveal-on-scroll">
      <span class="category-badge">{project.category}</span>
      <h1 class="project-title">{project.title}</h1>
      
      <p class="project-subtitle">{project.subtitle}</p>

      <div class="project-actions">
        <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="view-site-btn">
          <span>View Live Site</span>
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M3.5 10.5L10.5 3.5M10.5 3.5H4.66667M10.5 3.5V9.33333" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <!-- Project Metadata Grid -->
      <div class="meta-grid">
        <div class="meta-item">
          <span class="meta-label">YEAR</span>
          <span class="meta-value">{project.year}</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">ROLE</span>
          <span class="meta-value">{project.role}</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">TOOLS</span>
          <span class="meta-value">{project.tools.join(" • ")}</span>
        </div>
      </div>
    </header>

    <!-- Centered Loading Screen Video Section -->
    <section class="loading-video-container reveal-on-scroll">
      <div class="screen-frame">
        
        <!-- Simulated App/Browser Header Bar -->
        <div class="screen-header-bar">
          <div class="dot red"></div>
          <div class="dot yellow"></div>
          <div class="dot green"></div>
          <span class="screen-title-text">Critter & Friends — Loading Screen</span>
        </div>

        <!-- Autoplay Video Player -->
        <div class="video-wrapper">
          <video 
            src={project.videoSrc} 
            autoplay 
            muted 
            loop 
            playsinline
            poster={project.posterSrc}
            class="loading-video"
          >
            Your browser does not support the video tag.
          </video>
        </div>

      </div>
    </section>

    <!-- Project Overview Content -->
    <section class="content-section reveal-on-scroll">
      <div class="content-container">
        
        <!-- Paragraph Overview -->
        <div class="overview-block">
          <h2 class="section-heading">Project Overview</h2>
          <p class="overview-text">
            Created as my final dissertation project, <strong>Critter & Friends</strong> is an interactive web experience designed to help primary school children build confidence with basic computer literacy. To make digital learning feel approachable and fun, my partner and I collaborated closely on the overall layout and user experience, building a simple, intuitive interface around their hand-drawn character illustrations. We focused on keeping the UX lightweight and kid-friendly—balancing playful visuals with clean, purposeful web design that guides young users through early digital interactions seamlessly.
          </p>
        </div>

        <!-- Key Focus Areas Grid -->
        <div class="focus-block">
          <h3 class="section-subheading">Key Focus Areas</h3>
          
          <div class="focus-grid">
            <div class="focus-card">
              <span class="focus-num">01</span>
              <h4>Child-Centric UX Architecture</h4>
              <p>Designed intuitive, low-cognitive-load navigation patterns tailored specifically to the digital reading levels and fine motor skills of primary school children.</p>
            </div>

            <div class="focus-card">
              <span class="focus-num">02</span>
              <h4>Collaborative Design & Illustration</h4>
              <p>Partnered closely on interface structure and visual layouts, seamlessly integrating custom hand-drawn character artwork into a cohesive digital design system.</p>
            </div>

            <div class="focus-card">
              <span class="focus-num">03</span>
              <h4>Interactive Literacy Learning</h4>
              <p>Focused on play-driven micro-interactions and visual cues that teach fundamental web navigation and computer literacy through engaging game mechanics.</p>
            </div>

            <div class="focus-card">
              <span class="focus-num">04</span>
              <h4>Responsive & Lightweight Frontend</h4>
              <p>Implemented performant, accessible web components to ensure fast loading times and smooth browser interactions across desktop and tablet screens.</p>
            </div>
          </div>
        </div>

      </div>
    </section>

  </main>
</Layout>

<script>
  // Scroll reveal animation observer
  function initScrollReveal() {
    const observerCallback: IntersectionObserverCallback = (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    };

    const observer = new IntersectionObserver(observerCallback, {
      threshold: 0.05,
      rootMargin: '0px 0px -20px 0px'
    });

    document.querySelectorAll('.reveal-on-scroll').forEach((el) => observer.observe(el));
  }

  document.addEventListener('DOMContentLoaded', initScrollReveal);
  document.addEventListener('astro:page-load', initScrollReveal);
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Bodoni+Moda:wght@400;700;900&family=Inter:wght@400;500;600;700&display=swap');

  html {
    scroll-behavior: smooth;
  }

  /* --- Page Container --- */
  .case-study-page {
    background-color: #f8f7f4;
    min-height: 100vh;
    padding: 36px 24px 120px;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    color: #111111;
  }

  /* --- Top Navigation Bar --- */
  .top-nav-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1000px;
    margin: 0 auto 40px auto;
    padding-bottom: 20px;
    border-bottom: 1px solid #e5e3dc;
  }

  .back-link {
    font-size: 13px;
    font-weight: 600;
    color: #71717a;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: #7500f3;
  }

  .project-tabs {
    display: flex;
    gap: 8px;
  }

  .tab-link {
    font-size: 12px;
    font-weight: 600;
    color: #1a1a1a;
    text-decoration: none;
    padding: 6px 14px;
    border-radius: 100px;
    background: #ffffff;
    border: 1px solid #e5e3dc;
    transition: all 0.2s ease;
  }

  .tab-link:hover {
    border-color: #7500f3;
    color: #7500f3;
    transform: translateY(-1px);
  }

  .tab-link.active {
    background: #111111;
    color: #ffffff;
    border-color: #111111;
  }

  /* --- Case Study Header --- */
  .case-study-header {
    max-width: 1000px;
    margin: 0 auto 50px auto;
  }

  .category-badge {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #7500f3;
    text-transform: uppercase;
    display: block;
    margin-bottom: 12px;
  }

  .project-title {
    font-family: 'Bodoni Moda', 'Playfair Display', serif;
    font-size: clamp(2.5rem, 6vw, 4.2rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin: 0 0 12px 0;
  }

  .project-subtitle {
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    line-height: 1.4;
    color: #555555;
    margin: 0 0 24px 0;
  }

  /* --- Action Button --- */
  .project-actions {
    margin-bottom: 36px;
  }

  .view-site-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    background-color: #111111;
    color: #ffffff;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    border-radius: 100px;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .view-site-btn svg {
    transition: transform 0.25s ease;
  }

  .view-site-btn:hover {
    background-color: #7500f3;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(117, 0, 243, 0.25);
  }

  .view-site-btn:hover svg {
    transform: translate(2px, -2px);
  }

  /* --- Meta Details Grid --- */
  .meta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 24px;
    padding-top: 24px;
    border-top: 1px solid #dcdad4;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .meta-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #888888;
  }

  .meta-value {
    font-size: 14px;
    font-weight: 600;
    color: #1a1a1a;
  }

  /* --- Loading Video Container & Window Frame --- */
  .loading-video-container {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px 0 60px 0;
    max-width: 800px;
    margin: 0 auto;
  }

  .screen-frame {
    width: 100%;
    background: #0c82bd;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.14), 0 2px 6px rgba(0, 0, 0, 0.08);
    border: 1px solid #d0e7f7;
  }

  .screen-header-bar {
    background: #1c1c1e;
    padding: 12px 18px;
    display: flex;
    align-items: center;
    gap: 8px;
    position: relative;
    border-bottom: 1px solid #2c2c2e;
  }

  .dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }

  .dot.red { background-color: #ff5f56; }
  .dot.yellow { background-color: #ffbd2e; }
  .dot.green { background-color: #27c93f; }

  .screen-title-text {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    font-size: 11px;
    font-weight: 600;
    color: #8e8e93;
    letter-spacing: 0.03em;
  }

  .video-wrapper {
    position: relative;
    width: 100%;
    background-color: #9be3ff;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }

  .loading-video {
    width: 100%;
    height: auto;
    max-height: 500px;
    object-fit: contain;
    display: block;
  }

  /* --- Content Section Styling --- */
  .content-section {
    max-width: 1000px;
    margin: 40px auto 0 auto;
  }

  .overview-block {
    max-width: 800px;
    margin-bottom: 56px;
  }

  .section-heading {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #7500f3;
    margin-bottom: 16px;
  }

  .overview-text {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    line-height: 1.7;
    color: #222222;
    font-weight: 400;
  }

  .overview-text strong {
    font-weight: 600;
    color: #111111;
  }

  /* --- Focus Areas Grid --- */
  .section-subheading {
    font-family: 'Bodoni Moda', 'Playfair Display', serif;
    font-size: 1.8rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 24px;
    color: #111111;
  }

  .focus-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }

  .focus-card {
    background: #ffffff;
    padding: 28px 24px;
    border-radius: 12px;
    border: 1px solid #e5e3dc;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .focus-num {
    font-size: 12px;
    font-weight: 700;
    color: #7500f3;
    letter-spacing: 0.05em;
  }

  .focus-card h4 {
    font-size: 1.05rem;
    font-weight: 700;
    color: #111111;
    margin: 0;
  }

  .focus-card p {
    font-size: 14px;
    line-height: 1.6;
    color: #555555;
    margin: 0;
  }

  /* --- Scroll Reveal Animations --- */
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), 
                transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  .reveal-on-scroll.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Custom Agency Slide Transition Speeds */
  ::view-transition-old(root) {
    animation: 300ms cubic-bezier(0.4, 0, 0.2, 1) both slide-out-left;
  }

  ::view-transition-new(root) {
    animation: 300ms cubic-bezier(0.4, 0, 0.2, 1) both slide-in-right;
  }

  @keyframes slide-out-left {
    to { transform: translateX(-20px); opacity: 0; }
  }

  @keyframes slide-in-right {
    from { transform: translateX(20px); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
  }

  @media (max-width: 680px) {
    .case-study-page {
      padding: 24px 16px 80px;
    }

    .top-nav-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }

    .screen-title-text {
      display: none;
    }

    .focus-grid {
      grid-template-columns: 1fr;
    }
  }
</style>