    padding: 24px;
    background: #f5f5f2;
    border: 1px solid #e8e8e3;
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .screenshot-frame img {
    display: block;
    width: 100%;
    height: auto;
