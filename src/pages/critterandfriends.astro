---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import forest from '../../public/forest.png';
import bog from '../../public/bog.png';

// TODO: say what you did versus your partner, e.g. "I led UI and front end; my partner led research."
const metadata = [
  { label: "Role", value: "Co-UI/UX designer, front-end developer and researcher" },
  { label: "Timeline", value: "Final dissertation, 8-week sprint" },
  { label: "Scope", value: "Web game and custom design system" },
  { label: "Tools", value: "Next.js, Three.js, HTML/CSS, Illustrator" } // TODO: add Figma here if you used it
];

// These are design targets, not results. Replace with measured outcomes once you have them
// (number of children tested, Lighthouse score, what changed after testing). Only use numbers you can back up.
const kpis = [
  { text: "5–8", label: "Age range", detail: "Designed for early primary learners.", color: "mint" },
  { text: "48px", label: "Minimum touch target", detail: "Large, forgiving targets for developing motor skills.", color: "coral" },
  { text: "AA", label: "WCAG 2.1 target", detail: "Designed to meet AA contrast and target-size guidance.", color: "sage" }
];

// TODO: add one entry per key screen. Each ties a problem to the decision it led to.
const screens = [
  { img: forest, title: "Drag, drop, done", insight: "Fine cursor control is still developing at ages 5 to 8.", decision: "Micro-games teach click, hover and drag using large, forgiving targets.", alt: "Interactive mini-game flow and computer literacy component mapping" }
];

const nav = [
  ["context", "Context"], ["problem", "Problem"], ["goals", "Goals"], ["process", "Process"],
  ["solution", "Solution"], ["interface", "Interface"], ["reflections", "Reflections"], ["next", "Next steps"]
];
---

<Layout title="Critter & Friends: Case Study">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,500;0,700;1,500&family=JetBrains+Mono:wght@500;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <div class="progress" aria-hidden="true"><div id="bar"></div></div>
  <a class="skip" href="#content">Skip to case study</a>

  <main class="cs" id="cs">
    <header class="hero">
      <div class="inner">
        <div class="topbar">
          <a href="/work" class="back">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 12L4 8l6-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Back to portfolio
          </a>
          <nav class="tabs-top" aria-label="Project pages">
          
            <a href="/crit-stylesheet">Design system</a>
            <a href="/crit-research">UX research</a>
          </nav>
        </div>

        <div class="hero-grid">
          <div>
            <p class="chips">
              <span class="chip" style="--c: var(--yellow)">Case study</span>
              <span class="chip" style="--c: var(--mint)" id="readTime">3 min read</span>
            </p>
            <h1>Critter &amp; Friends: a digital literacy game</h1>
            <p class="lead">A browser-based game that teaches children aged 5 to 8 how to use a computer, through hand-drawn characters, big friendly targets and instant feedback.</p>
            <a class="cta" target="_blank" rel="noopener noreferrer" href="https://critterandfriends.netlify.app/">
              Play the live game
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3.5 10.5l7-7m0 0H4.67m5.83 0v5.83" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span class="sr">(opens in a new tab)</span>
            </a>
          </div>
          <dl class="specs" aria-label="Project overview">
            {metadata.map((m) => (<div><dt>{m.label}</dt><dd>{m.value}</dd></div>))}
          </dl>
        </div>

        <div class="devices single" role="group" aria-label="Key Critter and Friends screen">
          <figure class="device"><Image class="device-img" src={screens[0].img} alt={screens[0].alt} loading="eager" /></figure>
        </div>

        <div class="kpis">
          {kpis.map((k) => (
            <div class="kpi" style={`--c: var(--${k.color})`}>
              <p class="kpi-value">{k.text}</p>
              <p class="kpi-label">{k.label}</p>
              <p class="kpi-detail">{k.detail}</p>
            </div>
          ))}
        </div>
      </div>
    </header>

    <div class="layout">
      <aside class="toc-wrap">
        <nav class="toc" aria-label="On this page">
          <p class="toc-title">On this page</p>
          {nav.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
        </nav>
      </aside>

      <div class="content" id="content">
        <section id="context" class="reveal">
          <span class="chip" style="--c: var(--sage)">01 Context</span>
          <div class="cols">
            <h2>A playful web game that helps children take their first steps online.</h2>
            <div class="prose">
              <p>Critter &amp; Friends was my final dissertation project, designed and built with a partner. Most web tools assume some computer experience, which creates friction for children aged 5 to 8 from the first click.</p>
              <p>We built a visual-first game where hand-drawn characters guide each task, so children learn basic computer skills in a calm, friendly space.</p>
            </div>
          </div>
        </section>

        <section id="problem" class="reveal">
          <span class="chip" style="--c: var(--coral)">02 Problem</span>
          <div class="cols">
            <h2>Standard web interfaces assume skills young children don't have yet.</h2>
            <div class="prose">
              <p>Dense text, subtle cues and precise mouse control tire out early learners:</p>
              <ul class="bullets">
                <li><strong>Motor control:</strong> placing a cursor, clicking and dragging need muscle memory that is still developing.</li>
                <li><strong>Too much reading:</strong> menus and dropdowns need more reading skill than early primary level.</li>
                <li><strong>Unclear feedback:</strong> abstract form elements don't show clearly when an action worked.</li>
              </ul>
            </div>
          </div>
        </section>

        <figure class="shot reveal">
          <div class="shot-bar" style="--c: var(--yellow)"><span>Figure 1: Friction audit</span><span class="hint">Click to enlarge</span></div>
          <button class="zoom" type="button" aria-label="Enlarge figure 1"><Image class="shot-img" src={bog} alt="Critter and Friends interface and character design system" loading="lazy" /></button>
          <figcaption>Audit of where children struggle with standard interfaces, and early character illustrations.</figcaption>
        </figure>

        <section id="goals" class="reveal">
          <span class="chip" style="--c: var(--mint)">03 Goals</span>
          <div class="cols">
            <h2>A low-stress playground that teaches browser basics without overwhelming children.</h2>
            <div class="prose">
              <ul class="bullets">
                <li><strong>Simple interactions:</strong> large, forgiving targets of at least 48px for developing motor skills.</li>
                <li><strong>Visual guidance:</strong> spatial cues, colour-coded paths and character avatars in place of text navigation.</li>
                <li><strong>Accessible and light:</strong> designed to meet WCAG 2.1 AA and load quickly on classroom tablets.</li>
              </ul>
            </div>
          </div>
        </section>

        <section id="process" class="reveal">
          <span class="chip" style="--c: var(--lavender)">04 Process</span>
          <div class="cols">
            <h2>Four phases, from research to classroom testing.</h2>
            <div class="prose">
              <ul class="bullets">
                <li><strong>Discovery:</strong> researched how young children use screens to find layouts that suit spatial memory better than menus.</li>
                <li><strong>Mechanics:</strong> built micro-games to teach left-click precision, hover and sustained drag-and-drop.</li>
                <li><strong>Feedback:</strong> added audio cues, CSS animation and character reactions that confirm correct actions.</li>
                <li><strong>Testing:</strong> ran usability sessions with educators and students to tune touch targets, contrast and audio controls. <a href="/research">See the research</a></li>
              </ul>
              <!-- TODO: add numbers here (how many sessions, how many children) and one change you made because of testing. -->
            </div>
          </div>
        </section>

        <section id="solution" class="reveal">
          <span class="chip" style="--c: var(--sage)">05 Solution</span>
          <div class="cols">
            <h2>A lightweight game built around what a child can see, hear and do.</h2>
            <div class="prose">
              <ul class="bullets">
                <li><strong>Accessible design system:</strong> high-contrast palette and a readable sans-serif, designed to WCAG 2.1 AA. <a href="/crit-stylesheet">Explore the design system</a></li>
                <li><strong>Light front end:</strong> CSS transitions and optimised assets keep pages quick to load.</li>
                <li><strong>Gentle progress:</strong> rewarding animations encourage repeat play without competition.</li>
              </ul>
              <!-- TODO: add a measured load time or Lighthouse score if you have one. -->
            </div>
          </div>
        </section>

        <section id="interface" class="reveal">
          <span class="chip" style="--c: var(--sage)">06 Interface</span>
          <h2>Every screen answers one need.</h2>
          <div class="rows">
            {screens.map((s, i) => (
              <article class={`row ${i % 2 ? 'flip' : ''}`}>
                <button type="button" class="zoom phone" aria-label={`Enlarge ${s.title.toLowerCase()}`}>
                  <Image class="phone-img" src={s.img} alt={s.alt} loading="lazy" />
                </button>
                <div>
                  <h3>{s.title}</h3>
                  <p><strong>Insight:</strong> {s.insight}</p>
                  <p><strong>Decision:</strong> {s.decision}</p>
                </div>
              </article>
            ))}
          </div>
          <p class="more"><a href="/crit-stylesheet">Explore the design system</a><a href="/research">Read the UX research</a></p>
        </section>

        <section id="reflections" class="reveal">
          <span class="chip" style="--c: var(--amber)">07 Reflections</span>
          <div class="cards">
            <article style="--c: var(--mint)"><h3>Different ability levels</h3><p>Children develop motor skills at very different speeds. Flexible target areas and feedback through both sight and sound taught me to design for a range of abilities.</p></article>
            <article style="--c: var(--yellow)"><h3>Art within a performance budget</h3><p>Hand-drawn characters are heavy. Optimising SVGs and sprite sheets kept pages light without losing the illustrated look.</p></article>
            <article style="--c: var(--lavender)"><h3>Small details matter</h3><p>Instant hover responses and sound effects turned frustrating mechanical tasks into small wins for young learners.</p></article>
          </div>
        </section>

        <section id="next" class="reveal">
          <span class="chip" style="--c: var(--coral)">08 Next steps</span>
          <div class="cols">
            <h2>Adapt the difficulty to each child, and give teachers a view of progress.</h2>
            <div class="prose">
              <p>Next I would add a difficulty engine that adjusts challenges to each child's accuracy, and a simple teacher dashboard showing progress and motor-skill mastery.</p>
            </div>
          </div>
        </section>
      </div>
    </div>

    <button id="top" class="top" type="button" aria-label="Back to top">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 15l-6-6-6 6"/></svg>
    </button>

    <dialog id="lightbox" aria-label="Enlarged figure">
      <button type="button" id="closeLb" class="close">Close</button>
      <img id="lbImg" alt="" />
    </dialog>
  </main>
</Layout>

<script>
  function init() {
    const root = document.getElementById('cs');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    root.classList.add('js');
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Reading time
    const rt = document.getElementById('readTime');
    const words = (document.getElementById('content')?.textContent || '').trim().split(/\s+/).length;
    if (rt) rt.textContent = `${Math.max(1, Math.ceil(words / 200))} min read`;

    // Progress bar, back-to-top
    const bar = document.getElementById('bar');
    const top = document.getElementById('top');
    const onScroll = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      if (bar) bar.style.width = `${max > 0 ? (scrollY / max) * 100 : 0}%`;
      top?.classList.toggle('show', scrollY > 500);
    };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    top?.addEventListener('click', () => scrollTo({ top: 0, behavior: still ? 'auto' : 'smooth' }));

    // Active section in the index
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
    const spy = new IntersectionObserver((es) => es.forEach((e) => {
      if (e.isIntersecting) links.forEach((a) => a.toggleAttribute('aria-current', a.hash === `#${e.target.id}`));
    }), { rootMargin: '-20% 0px -70% 0px' });
    document.querySelectorAll('.content section').forEach((s) => spy.observe(s));

    // Reveal on scroll
    const reveal = new IntersectionObserver((es) => es.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add('visible'); reveal.unobserve(e.target); }
    }), { threshold: 0.1 });
    document.querySelectorAll('.reveal').forEach((el) => reveal.observe(el));

    // KPI count-up
    const count = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      count.unobserve(e.target);
      const el = e.target as HTMLElement;
      const to = Number(el.dataset.to);
      if (!to || still) return;
      const t0 = performance.now();
      const step = (t: number) => {
        const p = Math.min(1, (t - t0) / 1100);
        el.textContent = `${el.dataset.prefix}${Math.round(to * (1 - Math.pow(1 - p, 3)))}${el.dataset.suffix}`;
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }), { threshold: 0.6 });
    document.querySelectorAll('.kpi-value').forEach((el) => count.observe(el));

    // Before/after tabs
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
      });
      tab.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') select(tabs[(i + 1) % tabs.length]);
      });
    });

    // Lightbox for figures
    const lb = document.getElementById('lightbox') as HTMLDialogElement | null;
    const lbImg = document.getElementById('lbImg') as HTMLImageElement | null;
    document.querySelectorAll<HTMLButtonElement>('.zoom').forEach((b) => b.addEventListener('click', () => {
      const img = b.querySelector('img');
      if (!lb || !lbImg || !img) return;
      lbImg.src = img.src; lbImg.alt = img.alt; lb.showModal();
    }));
    document.getElementById('closeLb')?.addEventListener('click', () => lb?.close());
    lb?.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
  }
  init();
  document.addEventListener('astro:page-load', init);
</script>


<style>
  .cs {
    --bg: #fbfaf4; --card: #fff; --ink: #1f2430; --muted: #5a6070; --border: #d3d6df;
    --deep: #3f6b52; --shadow: 0 8px 28px rgba(31, 36, 48, .08);
    --yellow: #f6e7b0; --sage: #b5d0bf; --mint: #d0e1d4; --coral: #f0b7ab; --amber: #efd3ac; --lavender: #d3c6ea;
    --serif: 'Bodoni Moda', 'Playfair Display', Georgia, serif;
    --mono: 'JetBrains Mono', ui-monospace, monospace;
    --sans: 'Inter', system-ui, -apple-system, sans-serif;
    background: var(--bg); color: var(--ink); font: 16px/1.65 var(--sans); -webkit-font-smoothing: antialiased; min-height: 100vh;
  }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .cs a { color: inherit; }
  .cs :focus-visible, .top:focus-visible { outline: 3px solid var(--deep); outline-offset: 3px; border-radius: 6px; }
  .progress { position: fixed; inset: 0 0 auto 0; height: 4px; z-index: 50; pointer-events: none; }
  #bar { height: 100%; width: 0; background: var(--deep); }
  h1, h2, h3 { font-family: var(--serif); font-weight: 500; margin: 0; text-wrap: balance; }
  ul { list-style: none; margin: 0; padding: 0; }

  .chip { display: inline-block; font: 500 12px/1 var(--mono); background: var(--c); color: var(--ink); padding: 7px 12px; border-radius: 999px; margin-bottom: 16px; }
  .chips { display: flex; gap: 8px; flex-wrap: wrap; margin: 0 0 16px; }
  .chips .chip { margin: 0; }

  /* Hero */
  .hero { border-bottom: 1px solid var(--border); padding: 24px 0 72px; }
  .inner { max-width: 1100px; margin: 0 auto; padding: 0 24px; }
  .topbar { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; padding-bottom: 20px; margin-bottom: 48px; border-bottom: 1px solid var(--border); }
  .back, .tabs-top a { font: 500 13px var(--mono); text-decoration: none; padding: 8px 12px; border-radius: 999px; transition: background .2s; }
  .back { display: inline-flex; gap: 6px; align-items: center; padding-left: 0; }
  .back:hover, .tabs-top a:hover { background: var(--mint); }
  .tabs-top { display: flex; gap: 6px; flex-wrap: wrap; }
  .tabs-top a { border: 1px solid var(--border); }
  .hero-grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: 64px; align-items: start; }
  h1 { font-size: clamp(2.5rem, 4.6vw, 4rem); line-height: 1.08; margin-bottom: 20px; }
  .lead { font-size: 18px; line-height: 1.6; color: #2d3340; max-width: 56ch; margin: 0 0 32px; }
  .cta { display: inline-flex; align-items: center; gap: 10px; background: var(--ink); color: #fff !important; font-weight: 600; text-decoration: none; padding: 14px 26px; border-radius: 999px; transition: transform .2s, background .2s; }
  .cta:hover { background: var(--deep); transform: translateY(-2px); }
  .specs { margin: 0; background: var(--card); border: 1px solid var(--border); border-radius: 16px; box-shadow: var(--shadow); padding: 24px; display: grid; gap: 16px; }
  .specs dt { font: 500 12px var(--mono); color: var(--muted); }
  .specs dd { margin: 2px 0 0; font-weight: 600; }

  .kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 56px; }
  .kpi { background: var(--card); border: 1px solid var(--border); border-top: 6px solid var(--c); border-radius: 16px; padding: 24px; box-shadow: var(--shadow); }
  .kpi-value { font: 500 3rem/1 var(--serif); margin: 0 0 10px; }
  .kpi-label { font: 600 14px var(--mono); margin: 0 0 4px; }
  .kpi-detail { font-size: 14px; color: var(--muted); margin: 0; }

  /* Layout and nav */
  .layout { max-width: 1100px; margin: 0 auto; padding: 80px 24px 120px; display: grid; grid-template-columns: 200px 1fr; gap: 64px; align-items: start; }
  .toc-wrap { position: sticky; top: 32px; }
  .toc { display: flex; flex-direction: column; }
  .toc-title { font: 500 12px var(--mono); color: var(--muted); margin: 0 0 8px; }
  .toc a { font-size: 14px; text-decoration: none; color: var(--muted); padding: 7px 0 7px 14px; border-left: 2px solid var(--border); transition: color .2s, border-color .2s; }
  .toc a:hover { color: var(--ink); }
  .toc a[aria-current] { color: var(--ink); font-weight: 600; border-left-color: var(--deep); background: linear-gradient(90deg, var(--mint), transparent); }

  section { margin-bottom: 96px; scroll-margin-top: 32px; }
  .cols { display: grid; grid-template-columns: 42% 58%; gap: 40px; align-items: start; }
  h2 { font-size: clamp(1.6rem, 2.4vw, 2.2rem); line-height: 1.25; }
  .prose { line-height: 1.7; color: #333a48; max-width: 62ch; }
  .prose p { margin: 0 0 14px; }
  .bullets { margin-top: 14px; }
  .bullets li { position: relative; padding-left: 22px; margin-bottom: 10px; }
  .bullets li::before { content: ""; position: absolute; left: 0; top: .7em; width: 8px; height: 8px; border-radius: 2px; background: var(--deep); }
  blockquote { margin: 24px 0 0; padding: 18px 20px; background: var(--card); border: 1px solid var(--border); border-left: 6px solid var(--amber); border-radius: 12px; }
  blockquote p { font-style: italic; margin: 0 0 8px; color: var(--ink); }
  cite { font: 500 12px var(--mono); color: var(--muted); font-style: normal; }

  /* Figures and lightbox */
  .shot { margin: 0 0 96px; background: var(--card); border: 1px solid var(--border); border-radius: 16px; box-shadow: var(--shadow); padding: 14px; }
  .shot-bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; background: var(--c); border-radius: 10px; padding: 8px 14px; margin-bottom: 14px; font: 500 12px var(--mono); }
  .hint { color: #3a4050; }
  .zoom { display: block; width: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; border-radius: 10px; overflow: hidden; }
  .shot img, .shot-img { width: 100%; height: auto; display: block; background: var(--mint); min-height: 180px; transition: transform .4s; }
  .zoom:hover img { transform: scale(1.015); }
  figcaption { margin-top: 12px; font-size: 13px; color: var(--muted); }
  dialog { border: 0; border-radius: 16px; padding: 12px; max-width: min(1200px, 94vw); max-height: 94vh; background: var(--card); }
  dialog::backdrop { background: rgba(31, 36, 48, .7); }
  dialog img { max-width: 100%; max-height: 82vh; display: block; margin: 12px auto 0; }
  .close { font: 600 13px var(--mono); padding: 10px 16px; border-radius: 999px; border: 1px solid var(--border); background: var(--bg); cursor: pointer; }

  /* Compare */
  .compare { background: var(--card); border: 1px solid var(--border); border-radius: 16px; box-shadow: var(--shadow); padding: 24px; }
  .tabs { display: flex; gap: 8px; margin-bottom: 20px; flex-wrap: wrap; }
  .tabs button { font: 600 13px var(--mono); min-height: 44px; padding: 10px 18px; border-radius: 999px; border: 1px solid var(--border); background: var(--bg); color: var(--ink); cursor: pointer; transition: background .2s; }
  .tabs button:hover { background: var(--mint); }
  .tabs button[aria-selected="true"].t-before { background: var(--coral); border-color: var(--coral); }
  .tabs button[aria-selected="true"].t-after { background: var(--mint); border-color: var(--deep); }
  .panel h3 { font-size: 1.3rem; margin-bottom: 8px; }
  .panel li { display: flex; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--border); font-size: 15px; }
  .panel li::before { flex: none; width: 1.2em; font-weight: 700; }
  .bad li::before { content: "\00d7"; color: #a8271f; }
  .good li::before { content: "\2713"; color: #1a6b3a; }
  .panel:not([hidden]) { animation: fade .3s; }

  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .cards article { background: var(--card); border: 1px solid var(--border); border-top: 6px solid var(--c); border-radius: 16px; padding: 22px; box-shadow: var(--shadow); transition: transform .2s; }
  .cards article:hover { transform: translateY(-3px); }
  .cards h3 { font-size: 1.15rem; margin-bottom: 8px; }
  .cards p { margin: 0; font-size: 14px; color: #333a48; }

  .top { position: fixed; right: 24px; bottom: 24px; width: 48px; height: 48px; display: grid; place-items: center; background: var(--ink); color: #fff; border: 0; border-radius: 50%; box-shadow: var(--shadow); cursor: pointer; opacity: 0; visibility: hidden; transition: opacity .2s, visibility .2s, transform .2s; }
  .top.show { opacity: 1; visibility: visible; }
