    font-weight: 700;
    letter-spacing: 0.12em;
    color: #111111;
    text-transform: uppercase;
  }

  .wcag-pill {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    background: #eef2ff;
    color: #3730a3;
