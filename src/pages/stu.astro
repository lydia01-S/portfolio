---
import Layout from '../layouts/Layout.astro';
---

<Layout title="STU: UX Case Study — Lydia Stewart">
  <main class="case-study">
    
    <!-- Hero Header with Soft Mesh Background -->
    <header class="case-hero">
      <div class="meta-top">
        <span>UX CASE STUDY</span>
        <span>DESIGN BY LYDIA STEWART</span>
        <span>MARCH 2026</span>
      </div>

      <div class="hero-content">
        <div class="project-badge">
          <!-- Optional App Logo / Icon -->
       <a id="logo-mark" href="https://www.figma.com/proto/p9CXzhnuRkpQyuiRsOBexZ/Untitled?node-id=6-49197&p=f&t=0HX25CITAiz2uw3P-0&scaling=scale-down&content-scaling=fixed&page-id=0%3A1&starting-point-node-id=6%3A49197&show-proto-sidebar=1" target="_blank" rel="noopener noreferrer" class="proto-btn">
  View Prototype
</a>
        
        </div>
        <p class="sub-title">STU:Online Student Platform</p>
        <h1 class="main-title">UX CASE STUDY</h1>
        <p class="tagline">
          STU is an integrated platform helping students organize coursework, manage schedules, and collaborate on group assignments seamlessly.
        </p>
      </div>
    </header>



    <div class="project-components">
 <a href="/stylesheet" class="proto-btn">
  Style Guide
</a>
  <a href="/wireframe" class="proto-btn">
    Wireframes & site map
  </a>
  <a href="/research" class="proto-btn">
    Research
  </a>
</div>

    <div class="content-wrapper">
      
     <!-- Problem Statement (Side-by-Side with Image) -->
      <section class="section split-row">
        <div class="text-content">
          <h2 class="section-heading">Problem Statement</h2>
          <p class="body-text">
            We found that students often struggle to keep track of deadlines across multiple disjointed tools. Due to poor interface hierarchy and excessive notification noise, students frequently miss important assignment updates and struggle to coordinate group deliverables efficiently.
          </p>

       
        </div>
      </section>

      <!-- The Solution -->
      <section class="section">
        <h2 class="section-heading">The Solution</h2>
        <ul class="bullet-list">
          <li>Introducing a centralized hub for coursework, deadlines, and group communication.</li>
          <li>Real-time task synchronization across desktop and mobile views.</li>
          <li>Customizable notification filters to prevent focus disruption.</li>
          <li>Integrated canvas tools for fast peer feedback and submission tracking.</li>
        </ul>
      </section>

      <!-- My Role -->
      <section class="section">
        <h2 class="section-heading">My Role</h2>
        <div class="role-grid">
          <div>
            <h4>Discovery</h4>
            <ul>
              <li>User Interviews</li>
              <li>User Research</li>
              <li>Competitor Analysis</li>
            </ul>
          </div>
          <div>
            <h4>Strategy</h4>
            <ul>
              <li>Affinity Mapping</li>
              <li>Personas</li>
              <li>Empathy Mapping</li>
            </ul>
          </div>
          <div>
            <h4>Structure</h4>
            <ul>
              <li>Card Sorting</li>
              <li>User Flows</li>
              <li>Information Architecture</li>
            </ul>
          </div>
          <div>
            <h4>Design</h4>
            <ul>
              <li>Low-Fidelity Sketches</li>
              <li>High-Fidelity UI</li>
              <li>Usability Testing</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Duration & Tools Stats -->
      <section class="section two-col-stats">
        <div>
          <h2 class="section-heading">Project Duration</h2>
          <div class="stat-group">
            <div class="stat-item">
              <span class="stat-number">14</span>
              <span class="stat-label">Weeks</span>
            </div>
            <div class="stat-item">
              <span class="stat-number">35+</span>
              <span class="stat-label">Screens</span>
            </div>
          </div>
        </div>

        <div>
          <h2 class="section-heading">Tools Used</h2>
          <div class="tools-list">
            <span class="tool-tag">Figma</span>
            <span class="tool-tag">Photoshop</span>
            <span class="tool-tag">Miro</span>
            <span class="tool-tag">Google Forms</span>
          </div>
        </div>
      </section>

    

      <!-- Design Process Flow -->
      <section class="section">
        <h2 class="section-heading">Design Process</h2>
        <div class="process-grid">
          <div class="process-card">
            <div class="process-icon">🔍</div>
            <h3>Empathize</h3>
            <p>User Interview, Research, Competitor Analysis</p>
          </div>
          <div class="process-card">
            <div class="process-icon">👤</div>
            <h3>Define</h3>
            <p>Affinity Map, Personas, Empathy Map</p>
          </div>
          <div class="process-card">
            <div class="process-icon">💡</div>
            <h3>Ideate</h3>
            <p>User Flow, Card Sorting, IA</p>
          </div>
          <div class="process-card">
            <div class="process-icon">🎨</div>
            <h3>Design</h3>
            <p>Low Fidelity, High Fidelity</p>
          </div>
          <div class="process-card">
            <div class="process-icon">📱</div>
            <h3>Test</h3>
            <p>Usability Testing, Iterations</p>
          </div>
        </div>

      

      </section>
    </div>

  </main>
</Layout>

<style>


  .case-study {
    font-family: 'Bodoni Moda', 'Playfair Display', serif;
    color: #2c3e50;
    background-color: #ffffff;
  }

 

  /* --- Top Soft Gradient Hero --- */
  .case-hero {
    /* Forces the element to take up the full width of the screen */
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    box-sizing: border-box; /* Prevents horizontal scrollbars */

    /* Your purple/blue gradient and existing styles */
    background: radial-gradient(circle at 15% 25%, rgba(147, 112, 219, 0.35), transparent 45%),
                radial-gradient(circle at 85% 30%, rgba(66, 153, 225, 0.35), transparent 45%),
                linear-gradient(180deg, #fafafa 0%, #ffffff 100%);
    padding: 60px 24px 80px;
    text-align: center;
  }

  /* --- Side-by-Side Split Row Layout --- */
  .split-row {
    display: grid;
    grid-template-columns: 1fr 1fr; /* 2 equal columns for text and image */
    gap: 48px;
    align-items: center; /* Vertically aligns text with the center of the image */
  }

  .image-content {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .side-image {
    width: 100%;
    max-width: 420px; /* Adjust max-width to control the size of the phone card */
    height: auto;
    border-radius: 16px;

    object-fit: cover;
    display: block;

  }

  /* Mobile Responsive Adjustment */
  @media (max-width: 768px) {
    .split-row {
      grid-template-columns: 1fr; /* Stacks image under text on smaller mobile screens */
      gap: 32px;
    }
  }

.process-card {
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), 
              box-shadow 0.3s ease, 
              border-color 0.3s ease;
}

.process-card:hover {
  transform: translateY(-6px) scale(1.02);
  border-color: #ff7e36;
  box-shadow: 0 12px 24px rgba(0, 0, 0, 0.06);
}

/* Animate the icon inside on hover */
.process-card:hover .process-icon {
  transform: scale(1.2) rotate(5deg);
  transition: transform 0.3s ease;
}

.case-hero {
  background: radial-gradient(circle at 15% 25%, rgba(147, 112, 219, 0.35), transparent 45%),
              radial-gradient(circle at 85% 30%, rgba(66, 153, 225, 0.35), transparent 45%),
              linear-gradient(180deg, #fafafa 0%, #ffffff 100%);
  background-size: 150% 150%;
  animation: gradientShift 8s ease infinite alternate;
}

@keyframes gradientShift {
  0% {
    background-position: 0% 0%;
  }
  100% {
    background-position: 100% 100%;
  }
}

.hero-content > *, .meta-top, .project-components {
  animation: heroEntrance 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
}

/* Stagger delays for each element */
.meta-top { animation-delay: 0.1s; }
.project-badge { animation-delay: 0.2s; }
.sub-title { animation-delay: 0.3s; }
.main-title { animation-delay: 0.4s; }
.tagline { animation-delay: 0.5s; }
.project-components { animation-delay: 0.6s; }

@keyframes heroEntrance {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}




  .meta-top {
    display: flex;
    justify-content: space-between;
    max-width: 1000px;
    margin: 0 auto 60px;
    font-size: 11px;
    letter-spacing: 0.12em;
    color: #7f8c8d;
    font-weight: 600;
  }

  .hero-content {
    max-width: 650px;
    margin: 0 auto;
  }

  .logo-mark {
    background: #3686ff;
    color: #fff;
    padding: 12px 20px;
    border-radius: 50px;
    font-weight: 700;
    display: inline-block;
    margin-bottom: 24px;
  }

  .logo-mark:hover {
  background-color: #0051a8;
  transform: translateY(-1px);
}

  
/* Container to center items and set spacing */
.project-components {
  display: flex;
  justify-content: center; /* Centers buttons horizontally */
  align-items: center;    /* Vertically aligns buttons */
  gap: 16px;              /* Adds space between each button */
  margin: 32px 0;         /* Top/bottom spacing away from header/content */
  width: 100%;            /* Spans full width to ensure proper centering */
}

/* Reusable class for the buttons */
.proto-btn {
  display: inline-block;
  padding: 12px 24px;
  background-color: #7500f3;
  color: #ffffff;
  text-decoration: none;
  font-family: 'Bodoni Moda', 'Playfair Display', serif;
  font-size: 15px;
  font-weight: 600;
  border-radius: 100px;
  border: none;
  cursor: pointer;
  transition: background-color 0.2s ease, transform 0.2s ease;
}

.proto-btn:hover {
  background-color: #0051a8;
  transform: translateY(-1px);
}


  .sub-title {
    font-size: 18px;
    font-weight: 600;
    color: #34495e;
    margin-bottom: 8px;
    margin-top: 8px;
  }

  .main-title {
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 800;
    color: #1a252f;
    letter-spacing: -0.02em;
    margin-bottom: 20px;
  }

  .tagline {
    font-size: 16px;
    line-height: 1.6;
    color: #5a6b7c;
  }

  /* --- Main Body Wrapper --- */
  .content-wrapper {
    max-width: 850px;
    margin: 0 auto;
    padding: 0 24px 100px;
  }

  .section {
    margin-top: 64px;
  }

  /* Accent Orange Indicator Lines on Headings */
  .section-heading {
    font-size: 20px;
    font-weight: 700;
    color: #1a252f;
    margin-bottom: 20px;
    position: relative;
  }

  .section-heading::after {
    content: '';
    display: block;
    width: 28px;
    height: 4px;
    background-color: #ff7e36;
    border-radius: 2px;
    margin-top: 6px;
  }

  .body-text {
    font-size: 15px;
    line-height: 1.7;
    color: #4a5568;
  }

  .bullet-list {
    list-style: none;
    padding: 0;
  }

  .bullet-list li {
    font-size: 15px;
    line-height: 1.6;
    color: #4a5568;
    position: relative;
    padding-left: 20px;
    margin-bottom: 10px;
  }

  .bullet-list li::before {
    content: '•';
    color: #ff7e36;
    font-weight: bold;
    position: absolute;
    left: 0;
  }

  /* --- Role Grid Section --- */
  .role-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .role-grid h4 {
    font-size: 14px;
    margin-bottom: 12px;
    color: #2d3748;
  }

  .role-grid ul {
    list-style: none;
    padding: 0;
  }

  .role-grid li {
    font-size: 13px;
    color: #718096;
    margin-bottom: 6px;
  }

  /* --- Stats and Tools --- */
  .two-col-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }

  .stat-group {
    display: flex;
    gap: 32px;
  }

  .stat-number {
    font-size: 36px;
    font-weight: 800;
    color: #1a252f;
    display: block;
  }

  .stat-label {
    font-size: 13px;
    color: #718096;
  }

  .tools-list {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .tool-tag {
    background: #edf2f7;
    padding: 8px 14px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    color: #4a5568;
  }

  /* --- Process Cards Grid --- */
  .process-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
    text-align: center;
  }

  .process-card {
    background: #f7fafc;
    border: 1px solid #edf2f7;
    padding: 20px 12px;
    border-radius: 12px;
  }

  .process-icon {
    font-size: 24px;
    margin-bottom: 12px;
  }

  .process-card h3 {
    font-size: 14px;
    margin-bottom: 6px;
  }

  .process-card p {
    font-size: 11px;
    color: #718096;
    line-height: 1.4;
  }

  @media (max-width: 768px) {
    .role-grid, .process-grid, .two-col-stats {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .role-grid, .process-grid, .two-col-stats {
      grid-template-columns: 1fr;
    }
  }
</style>