---
import Layout from '../layouts/Layout.astro';
import { ClientRouter } from 'astro:transitions';
---

<Layout title="STU: UX Case Study — Lydia Stewart">
  <main class="case-study">
    
    <!-- Agency Editorial Header -->
    <header class="agency-hero">
      <div class="hero-inner">
        
        <!-- Top Navigation Bar with Slide Transitions -->
        <div class="top-nav-row">
          <a href="/work" class="back-link">← Back to Portfolio</a>
          <nav class="project-tabs" aria-label="Project Sections">
            <a href="/stylesheet" class="tab-link" transition:animate="slide">Style Guide</a>
            <a href="/wireframe" class="tab-link" transition:animate="slide">Wireframes & Site Map</a>
            <a href="/research" class="tab-link" transition:animate="slide">Research</a>
          </nav>
        </div>

        <!-- Main Title & Side-by-Side Metadata Grid -->
        <div class="hero-grid">
          <div class="hero-main">
            <span class="project-category">Featured UX Case Study</span>
            <h1 class="project-title">STU — Reimagining the Digital Campus Ecosystem</h1>
            <p class="project-lead">
              An integrated mobile-first platform designed to replace legacy campus portals, streamlining coursework, schedule tracking, and peer collaboration for modern students.
            </p>
            <div class="hero-actions">
              <a 
                href="https://www.figma.com/proto/p9CXzhnuRkpQyuiRsOBexZ/Untitled?node-id=6-49197&p=f&t=0HX25CITAiz2uw3P-0&scaling=scale-down&content-scaling=fixed&page-id=0%3A1&starting-point-node-id=6%3A49197&show-proto-sidebar=1" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="cta-primary"
              >
                Launch Prototype ↗
              </a>
            </div>
          </div>

          <!-- Quick Metadata Sidebar -->
          <aside class="hero-meta-sidebar">
            <div class="meta-item">
              <span class="meta-label">Role</span>
              <span class="meta-value">Lead UX/UI Designer</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Timeline</span>
              <span class="meta-value">14 Weeks (March 2026)</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Scope</span>
              <span class="meta-value">iOS, Android & Web</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Tools</span>
              <span class="meta-value">Figma, Miro, Photoshop</span>
            </div>
          </aside>
        </div>

      </div>
    </header>

    <div class="content-wrapper">
      
      <!-- Section 01: Problem Context & Product Vision Grid -->
      <section class="section">
        <div class="overview-grid">
          <div class="overview-card">
            <span class="card-badge">01 / The Context & Problem</span>
            <h3>Legacy Debt in Campus Software</h3>
            <p>
              Traditional higher-education portals often suffer from fragmented navigation, cluttered interfaces, and outdated desktop-first paradigms. Built around complex administrative backends, they generate excessive cognitive load and friction for digital-native students managing daily academic schedules.
            </p>
          </div>

          <div class="overview-card vision-card">
            <span class="card-badge">02 / The Product Vision</span>
            <h3>A Modern, Mobile-First Ecosystem</h3>
            <p>
              STU bridges this gap by reimagining the campus portal into a modern, youthful, and mobile-first experience. By prioritizing clean typographic hierarchies, intuitive micro-interactions, and fast task completion, STU reduces focus disruption and aligns with modern software standards.
            </p>
          </div>
        </div>
      </section>

      <!-- Problem Statement -->
      <section class="section">
        <h2 class="section-heading">Problem Statement</h2>
        <p class="body-text">
          We found that students often struggle to keep track of deadlines across multiple disjointed tools. Due to poor interface hierarchy and excessive notification noise, students frequently miss important assignment updates and struggle to coordinate group deliverables efficiently.
        </p>
      </section>

      <!-- The Solution -->
      <section class="section">
        <h2 class="section-heading">The Solution</h2>
        <ul class="bullet-list">
          <li>Centralized hub for coursework, deadlines, and group communication.</li>
          <li>Real-time task synchronization across desktop and mobile views.</li>
          <li>Customizable notification filters to prevent focus disruption.</li>
          <li>Integrated canvas tools for fast peer feedback and submission tracking.</li>
        </ul>
      </section>

      <!-- My Role -->
      <section class="section">
        <h2 class="section-heading">My Role</h2>
        <div class="role-grid">
          <div>
            <h4>Discovery</h4>
            <ul>
              <li>User Interviews</li>
              <li>User Research</li>
              <li>Competitor Analysis</li>
            </ul>
          </div>
          <div>
            <h4>Strategy</h4>
            <ul>
              <li>Affinity Mapping</li>
              <li>Personas</li>
              <li>Empathy Mapping</li>
            </ul>
          </div>
          <div>
            <h4>Structure</h4>
            <ul>
              <li>Card Sorting</li>
              <li>User Flows</li>
              <li>Information Architecture</li>
            </ul>
          </div>
          <div>
            <h4>Design</h4>
            <ul>
              <li>Low-Fidelity Sketches</li>
              <li>High-Fidelity UI</li>
              <li>Usability Testing</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Duration & Tools Stats -->
      <section class="section two-col-stats">
        <div>
          <h2 class="section-heading">Project Duration</h2>
          <div class="stat-group">
            <div class="stat-item">
              <span class="stat-number">14</span>
              <span class="stat-label">Weeks</span>
            </div>
            <div class="stat-item">
              <span class="stat-number">35+</span>
              <span class="stat-label">Screens</span>
            </div>
          </div>
        </div>

        <div>
          <h2 class="section-heading">Tools Used</h2>
          <div class="tools-list">
            <span class="tool-tag">Figma</span>
            <span class="tool-tag">Photoshop</span>
            <span class="tool-tag">Miro</span>
            <span class="tool-tag">Google Forms</span>
          </div>
        </div>
      </section>

      <!-- Design Process Flow -->
      <section class="section">
        <h2 class="section-heading">Design Process</h2>
        <div class="process-grid">
          <div class="process-card">
            <div class="process-icon">🔍</div>
            <h3>Empathize</h3>
            <p>User Interview, Research, Competitor Analysis</p>
          </div>
          <div class="process-card">
            <div class="process-icon">👤</div>
            <h3>Define</h3>
            <p>Affinity Map, Personas, Empathy Map</p>
          </div>
          <div class="process-card">
            <div class="process-icon">💡</div>
            <h3>Ideate</h3>
            <p>User Flow, Card Sorting, IA</p>
          </div>
          <div class="process-card">
            <div class="process-icon">🎨</div>
            <h3>Design</h3>
            <p>Low Fidelity, High Fidelity</p>
          </div>
          <div class="process-card">
            <div class="process-icon">📱</div>
            <h3>Test</h3>
            <p>Usability Testing, Iterations</p>
          </div>
        </div>
      </section>

    </div>
  </main>
</Layout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

  /* Core Font and Global Setup */
  .case-study,
  .case-study p,
  .case-study span,
  .case-study button,
  .case-study a,
  .case-study li {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  .case-study h1,
  .case-study h2,
  .case-study h3 {
    font-family: 'Bodoni Moda', 'Playfair Display', serif;
  }

  .case-study {
    color: #1a1a1a;
    background-color: #f8f7f4;
    min-height: 100vh;
  }

  /* --- Agency Editorial Header --- */
  .agency-hero {
    background: #ffffff;
    border-bottom: 1px solid #e5e3dc;
    padding: 36px 24px 56px;
  }

  .hero-inner {
    max-width: 1000px;
    margin: 0 auto;
  }

  /* Top Navigation Bar */
  .top-nav-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 40px;
    padding-bottom: 20px;
    border-bottom: 1px solid #f0eee6;
  }

  .back-link {
    font-size: 13px;
    font-weight: 600;
    color: #71717a;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: #7500f3;
  }

  .project-tabs {
    display: flex;
    gap: 8px;
  }

  .tab-link {
    font-size: 12px;
    font-weight: 600;
    color: #1a1a1a;
    text-decoration: none;
    padding: 6px 14px;
    border-radius: 100px;
    background: #f8f7f4;
    border: 1px solid #e5e3dc;
    transition: all 0.2s ease;
  }

  .tab-link:hover {
    border-color: #7500f3;
    color: #7500f3;
    transform: translateY(-1px);
  }

  /* Hero Content Grid */
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 56px;
    align-items: start;
  }

  .project-category {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #7500f3;
    display: block;
    margin-bottom: 12px;
  }

  .project-title {
    font-size: clamp(2rem, 3.8vw, 3.2rem);
    font-weight: 400;
    line-height: 1.15;
    color: #1a1a1a;
    margin: 0 0 16px 0;
    letter-spacing: -0.02em;
  }

  .project-lead {
    font-size: 15px;
    line-height: 1.6;
    color: #555555;
    margin-bottom: 24px;
    max-width: 580px;
  }

  .cta-primary {
    display: inline-block;
    padding: 10px 24px;
    background-color: #7500f3;
    color: #ffffff;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    border-radius: 100px;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .cta-primary:hover {
    background-color: #5a00b8;
    transform: translateY(-1px);
  }

  /* Metadata Sidebar */
  .hero-meta-sidebar {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-left: 28px;
    border-left: 1px solid #e5e3dc;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .meta-label {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #8e8e93;
  }

  .meta-value {
    font-size: 13px;
    font-weight: 600;
    color: #1a1a1a;
  }

  /* --- Main Body Wrapper --- */
  .content-wrapper {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 24px 100px;
  }

  .section {
    margin-top: 56px;
  }

  .section-heading {
    font-size: 22px;
    font-weight: 400;
    color: #1a1a1a;
    margin-bottom: 20px;
    position: relative;
  }

  .section-heading::after {
    content: '';
    display: block;
    width: 32px;
    height: 4px;
    background-color: #ff7e36;
    border-radius: 2px;
    margin-top: 8px;
  }

  .body-text {
    font-size: 15px;
    line-height: 1.7;
    color: #4a4a4a;
  }

  /* --- Overview Cards (Problem & Vision Grid) --- */
  .overview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
  }

  .overview-card {
    background: #ffffff;
    border: 1px solid #e5e3dc;
    border-radius: 20px;
    padding: 28px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.02);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .card-badge {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #7500f3;
  }

  .overview-card h3 {
    font-size: 18px;
    font-weight: 400;
    margin: 0;
    color: #1a1a1a;
  }

  .overview-card p {
    font-size: 14px;
    line-height: 1.6;
    color: #555;
    margin: 0;
  }

  .vision-card {
    border-left: 4px solid #7500f3;
  }

  /* --- Lists --- */
  .bullet-list {
    list-style: none;
    padding: 0;
  }

  .bullet-list li {
    font-size: 15px;
    line-height: 1.6;
    color: #4a4a4a;
    position: relative;
    padding-left: 20px;
    margin-bottom: 12px;
  }

  .bullet-list li::before {
    content: '•';
    color: #ff7e36;
    font-weight: bold;
    position: absolute;
    left: 0;
  }

  /* --- Role Grid --- */
  .role-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    background: #ffffff;
    padding: 28px;
    border-radius: 20px;
    border: 1px solid #e5e3dc;
  }

  .role-grid h4 {
    font-size: 12px;
    font-weight: 700;
    margin-bottom: 12px;
    color: #1a1a1a;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .role-grid ul {
    list-style: none;
    padding: 0;
  }

  .role-grid li {
    font-size: 13px;
    color: #555;
    margin-bottom: 6px;
  }

  /* --- Stats and Tools --- */
  .two-col-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }

  .stat-group {
    display: flex;
    gap: 32px;
  }

  .stat-number {
    font-size: 40px;
    font-weight: 700;
    color: #7500f3;
    display: block;
    letter-spacing: -0.02em;
  }

  .stat-label {
    font-size: 13px;
    color: #555;
  }

  .tools-list {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .tool-tag {
    background: #ffffff;
    border: 1px solid #e5e3dc;
    padding: 8px 16px;
    border-radius: 100px;
    font-size: 13px;
    font-weight: 500;
    color: #1a1a1a;
  }

  /* --- Process Cards Grid --- */
  .process-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
    text-align: center;
  }

  .process-card {
    background: #ffffff;
    border: 1px solid #e5e3dc;
    padding: 20px 12px;
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.02);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), 
                box-shadow 0.3s ease, 
                border-color 0.3s ease;
  }

  .process-card:hover {
    transform: translateY(-6px);
    border-color: #ff7e36;
    box-shadow: 0 12px 24px rgba(0,0,0,0.06);
  }

  .process-icon {
    font-size: 24px;
    margin-bottom: 12px;
    transition: transform 0.3s ease;
  }

  .process-card:hover .process-icon {
    transform: scale(1.2) rotate(5deg);
  }

  .process-card h3 {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 6px;
    color: #1a1a1a;
  }

  .process-card p {
    font-size: 11px;
    color: #666;
    line-height: 1.4;
    margin: 0;
  }

  /* Custom Agency Slide Transition Speeds */
  ::view-transition-old(root) {
    animation: 300ms cubic-bezier(0.4, 0, 0.2, 1) both slide-out-left;
  }

  ::view-transition-new(root) {
    animation: 300ms cubic-bezier(0.4, 0, 0.2, 1) both slide-in-right;
  }

  @keyframes slide-out-left {
    to { transform: translateX(-20px); opacity: 0; }
  }

  @keyframes slide-in-right {
    from { transform: translateX(20px); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
  }

  /* Mobile Responsive Tweaks */
  @media (max-width: 820px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .hero-meta-sidebar {
      padding-left: 0;
      border-left: none;
      border-top: 1px solid #e5e3dc;
      padding-top: 24px;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .role-grid, .two-col-stats {
      grid-template-columns: 1fr 1fr;
    }

    .process-grid {
      grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    }

    .top-nav-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }

  @media (max-width: 480px) {
    .role-grid, .two-col-stats {
      grid-template-columns: 1fr;
    }
  }
</style>