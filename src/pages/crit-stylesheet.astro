---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import bog from '../../public/bog.png';
import bogCard from '../../public/bog.card.png';
import forest from '../../public/forest.png';


// !! PLACEHOLDER VALUES !! Replace every colour, font and size below with the real tokens from the game's CSS.
// Contrast ratios are calculated from these values, so they will only be true once the values are real.
const colours = [
  { name: "Leaf green", hex: "#2f6b3c", text: "#ffffff", textName: "white", use: "Primary buttons and progress" },
  { name: "Sunny yellow", hex: "#ffd84d", text: "#1f2430", textName: "ink", use: "Highlights and rewards" },
  { name: "Berry", hex: "#b23a5a", text: "#ffffff", textName: "white", use: "Gentle errors and alerts" },
  { name: "Sky", hex: "#cfe8f7", text: "#1f2430", textName: "ink", use: "Backgrounds and panels" },
  { name: "Ink", hex: "#1f2430", text: "#ffffff", textName: "white", use: "Text and outlines" }
];
const lum = (hex: string) => {
  const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255)
    .map((c) => (c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4));
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};
const ratio = (a: string, b: string) => {
  const [hi, lo] = [lum(a), lum(b)].sort((x, y) => y - x);
  return (hi + 0.05) / (lo + 0.05);
};
const swatches = colours.map((c) => {
  const r = ratio(c.hex, c.text);
  return { ...c, ratio: r.toFixed(1), pass: r >= 4.5 };
});
const lowest = Math.min(...colours.map((c) => ratio(c.hex, c.text))).toFixed(1);
const primary = colours[0];

// TODO: use the game's real fonts, and load them in the <link> below.
const fonts = { head: "'Fraunces', Georgia, serif", body: "'Atkinson Hyperlegible', system-ui, sans-serif" };
const scale = [
  { label: "Display", meta: "Headings, 44px", face: "head", size: "2.75rem", weight: 600, sample: "Hello, Critter!" },
  { label: "Heading", meta: "Headings, 28px", face: "head", size: "1.75rem", weight: 600, sample: "Drag the apple to the basket" },
  { label: "Instruction", meta: "Body, 20px", face: "body", size: "1.25rem", weight: 400, sample: "Press the big green button to start." },
  { label: "Label", meta: "Body bold, 16px", face: "body", size: "1rem", weight: 700, sample: "Try again" }
];

const states = [
  { cls: "", label: "Default" }, { cls: "is-hover", label: "Hover" }, { cls: "is-focus", label: "Keyboard focus" },
  { cls: "is-active", label: "Pressed" }, { cls: "is-disabled", label: "Disabled" }
];

const assets = [
  { img: bog, tag: "Characters", title: "Character expressions and states", desc: "Hand-drawn avatars whose reactions confirm a correct or incorrect action.", alt: "Character expressions and states" },
  { img: bogCard, tag: "Colour", title: "Child-friendly colour palette", desc: "Saturated hues paired for strong contrast.", alt: "Child-friendly colour palette" },
  { img: forest, tag: "Components", title: "Tactile buttons and inputs", desc: "Oversized targets with clear state changes.", alt: "Micro-interaction button components" },

];

const nav = [["overview", "Overview"], ["colour", "Colour"], ["typography", "Typography"], ["components", "Components"], ["assets", "Assets"], ["principles", "Principles"]];
---

<Layout title="Critter & Friends: Design System">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,500;0,700;1,500&family=JetBrains+Mono:wght@500;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <!-- TODO: add the game's own fonts here (the placeholders are Fraunces and Atkinson Hyperlegible) -->
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@600&family=Atkinson+Hyperlegible:wght@400;700&display=swap" rel="stylesheet" />

  <div class="progress" aria-hidden="true"><div id="bar"></div></div>
  <a class="skip" href="#content">Skip to design system</a>

  <main class="cs" id="cs">
    <header class="hero">
      <div class="inner">
        <div class="topbar">
          <a href="/work" class="back">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 12L4 8l6-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Back to portfolio
          </a>
          <nav class="tabs-top" aria-label="Project pages">
            <a href="/critterandfriends">Overview</a>
            <a href="/research">UX research</a>
            <a href="/crit-stylesheet" aria-current="page">Design system</a>
          </nav>
        </div>

        <div class="hero-grid">
          <div>
            <p class="chips">
              <span class="chip" style="--c: var(--yellow)">Design system</span>
              <span class="chip" style="--c: var(--mint)" id="readTime">2 min read</span>
            </p>
            <h1>Critter &amp; Friends design system</h1>
            <p class="lead">The colour, type, components and hand-drawn characters behind the game, built for children aged 5 to 8.</p>
            <a class="cta" target="_blank" rel="noopener noreferrer" href="https://critterandfriends.netlify.app/">
              See it in the live game
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3.5 10.5l7-7m0 0H4.67m5.83 0v5.83" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span class="sr">(opens in a new tab)</span>
            </a>
          </div>
          <dl class="specs" aria-label="System overview">
            <div><dt>Typography</dt><dd>High-legibility sans and a rounded serif</dd></div>
            <div><dt>Colour</dt><dd>High-contrast palette checked against WCAG AA</dd></div>
            <div><dt>Assets</dt><dd>Vector SVG and sprite sheet animations</dd></div>
            <div><dt>Tools</dt><dd>Next.js, HTML/CSS, JavaScript, Three.js, Illustrator</dd></div>
          </dl>
        </div>

        <div class="kpis">
          <div class="kpi" style="--c: var(--mint)"><p class="kpi-value">{colours.length}</p><p class="kpi-label">Colour tokens</p><p class="kpi-detail">Each checked against its text colour.</p></div>
          <div class="kpi" style="--c: var(--coral)"><p class="kpi-value">{lowest}:1</p><p class="kpi-label">Lowest text contrast</p><p class="kpi-detail">AA needs 4.5:1 for body text.</p></div>
          <div class="kpi" style="--c: var(--sage)"><p class="kpi-value">48px</p><p class="kpi-label">Minimum target</p><p class="kpi-detail">Large and forgiving for young hands.</p></div>
        </div>
      </div>
    </header>

    <div class="layout">
      <aside class="toc-wrap">
        <nav class="toc" aria-label="On this page">
          <p class="toc-title">On this page</p>
          {nav.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
        </nav>
      </aside>

      <div class="content" id="content">
        <section id="overview" class="reveal">
          <span class="chip" style="--c: var(--sage)">Overview</span>
          <div class="cols">
            <h2>A playful visual language that keeps the interface out of the child's way.</h2>
            <div class="prose">
              <p>The system pairs child-friendly looks with WCAG AA accessibility. High-contrast colour pairs, tactile components and hand-drawn character states give every micro-game the same toolkit.</p>
              <p>Every token, from the 48px touch-target minimum to the feedback loops, is tuned for developing motor skills and early reading.</p>
            </div>
          </div>
        </section>

        <section id="colour" class="reveal">
          <span class="chip" style="--c: var(--coral)">Colour</span>
          <div class="cols">
            <h2>Every colour is paired with a text colour and tested.</h2>
            <div class="prose"><p>Ratios are calculated from the hex values. Body text needs at least 4.5:1 to meet WCAG 2.1 AA.</p></div>
          </div>
          <ul class="swatches">
            {swatches.map((c) => (
              <li class="swatch">
                <div class="sw-color" style={`background:${c.hex};color:${c.text}`} aria-hidden="true">Aa</div>
                <div class="sw-meta">
                  <h3>{c.name}</h3>
                  <p class="hex">{c.hex}</p>
                  <p>{c.use}</p>
                  <p>{c.ratio}:1 with {c.textName} text</p>
                  <p class={`badge ${c.pass ? '' : 'fail'}`}>{c.pass ? '✓ Passes AA' : '✕ Fails AA'}</p>
                </div>
              </li>
            ))}
          </ul>
        </section>

        <section id="typography" class="reveal">
          <span class="chip" style="--c: var(--yellow)">Typography</span>
          <div class="cols">
            <h2>A clear sans for instructions and a friendly serif for headings.</h2>
            <div class="prose"><p>A high x-height keeps instructions readable for early readers. The rounded serif gives headings warmth without slowing reading down.</p></div>
          </div>
          <div class="specimen" style={`--head:${fonts.head};--body:${fonts.body}`}>
            {scale.map((t) => (
              <div class="spec-row">
                <p class="spec-meta">{t.label}<br />{t.meta}</p>
                <p class="spec-sample" style={`font-family:var(--${t.face});font-size:${t.size};font-weight:${t.weight}`}>{t.sample}</p>
              </div>
            ))}
          </div>
        </section>

        <section id="components" class="reveal" style={`--btn:${primary.hex};--btn-ink:${primary.text};--body:${fonts.body}`}>
          <span class="chip" style="--c: var(--lavender)">Components</span>
          <div class="cols">
            <h2>Buttons that are big, clear and respond at once.</h2>
            <div class="prose"><p>Every state is visible without relying on colour alone. These are static specimens of the game's primary button.</p></div>
          </div>
          <div class="states" aria-label="Button states">
            {states.map((s) => (
              <div class="state"><span class={`btn ${s.cls}`} aria-hidden="true">Play</span><p>{s.label}</p></div>
            ))}
          </div>
          <div class="target-demo">
            <span class="target-box" aria-hidden="true"></span>
            <p>Minimum target: 48 × 48px, with space around it so a missed tap still lands.</p>
          </div>
        </section>

        <section id="assets" class="reveal">
          <span class="chip" style="--c: var(--sage)">Assets</span>
          <div class="cols">
            <h2>Hand-drawn characters and world elements.</h2>
            <div class="prose"><p>Illustrations are optimised vectors, so the game stays light while keeping its illustrated character.</p></div>
          </div>
          <div class="gallery">
            {assets.map((a, i) => (
              <figure class="shot asset">
                <div class="shot-bar" style="--c: var(--mint)"><span>{a.tag}</span><span class="hint">Click to enlarge</span></div>
                <button class="zoom" type="button" aria-label={`Enlarge ${a.title.toLowerCase()}`}><Image class="shot-img" src={a.img} alt={a.alt} loading="lazy" /></button>
                <figcaption><h3>{a.title}</h3><p>{a.desc}</p></figcaption>
              </figure>
            ))}
          </div>
        </section>

        <section id="principles" class="reveal">
          <span class="chip" style="--c: var(--amber)">Principles</span>
          <div class="cards">
            <article style="--c: var(--yellow)"><h3>Legible first</h3><p>Clear sans-serif instructions with friendly serif headings, sized for early readers.</p></article>
            <article style="--c: var(--mint)"><h3>Contrast everywhere</h3><p>A 4.5:1 minimum for text on every background and control, for bright classroom light.</p></article>
            <article style="--c: var(--lavender)"><h3>Light vectors</h3><p>Optimised SVGs stay crisp on high-resolution screens and keep pages light for classroom devices.</p></article>
          </div>
        </section>
      </div>
    </div>

    <button id="top" class="top" type="button" aria-label="Back to top">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 15l-6-6-6 6"/></svg>
    </button>

    <dialog id="lightbox" aria-label="Enlarged figure">
      <button type="button" id="closeLb" class="close">Close</button>
      <img id="lbImg" alt="" />
    </dialog>
  </main>
</Layout>

<script>
  function init() {
    const root = document.getElementById('cs');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    root.classList.add('js');
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Reading time
    const rt = document.getElementById('readTime');
    const words = (document.getElementById('content')?.textContent || '').trim().split(/\s+/).length;
    if (rt) rt.textContent = `${Math.max(1, Math.ceil(words / 200))} min read`;

    // Progress bar, back-to-top
    const bar = document.getElementById('bar');
    const top = document.getElementById('top');
    const onScroll = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      if (bar) bar.style.width = `${max > 0 ? (scrollY / max) * 100 : 0}%`;
      top?.classList.toggle('show', scrollY > 500);
    };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    top?.addEventListener('click', () => scrollTo({ top: 0, behavior: still ? 'auto' : 'smooth' }));

    // Active section in the index
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
    const spy = new IntersectionObserver((es) => es.forEach((e) => {
      if (e.isIntersecting) links.forEach((a) => a.toggleAttribute('aria-current', a.hash === `#${e.target.id}`));
    }), { rootMargin: '-20% 0px -70% 0px' });
    document.querySelectorAll('.content section').forEach((s) => spy.observe(s));

    // Reveal on scroll
    const reveal = new IntersectionObserver((es) => es.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add('visible'); reveal.unobserve(e.target); }
    }), { threshold: 0.1 });
    document.querySelectorAll('.reveal').forEach((el) => reveal.observe(el));

    // KPI count-up
    const count = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      count.unobserve(e.target);
      const el = e.target as HTMLElement;
      const to = Number(el.dataset.to);
      if (!to || still) return;
      const t0 = performance.now();
      const step = (t: number) => {
        const p = Math.min(1, (t - t0) / 1100);
        el.textContent = `${el.dataset.prefix}${Math.round(to * (1 - Math.pow(1 - p, 3)))}${el.dataset.suffix}`;
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }), { threshold: 0.6 });
    document.querySelectorAll('.kpi-value').forEach((el) => count.observe(el));

    // Before/after tabs
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
      });
      tab.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') select(tabs[(i + 1) % tabs.length]);
      });
    });

    // Lightbox for figures
    const lb = document.getElementById('lightbox') as HTMLDialogElement | null;
    const lbImg = document.getElementById('lbImg') as HTMLImageElement | null;
    document.querySelectorAll<HTMLButtonElement>('.zoom').forEach((b) => b.addEventListener('click', () => {
      const img = b.querySelector('img');
      if (!lb || !lbImg || !img) return;
      lbImg.src = img.src; lbImg.alt = img.alt; lb.showModal();
    }));
    document.getElementById('closeLb')?.addEventListener('click', () => lb?.close());
    lb?.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
  }
  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .cs {
    --bg: #fbfaf4; --card: #fff; --ink: #1f2430; --muted: #5a6070; --border: #d3d6df;
    --deep: #3f6b52; --shadow: 0 8px 28px rgba(31, 36, 48, .08);
    --yellow: #f6e7b0; --sage: #b5d0bf; --mint: #d0e1d4; --coral: #f0b7ab; --amber: #efd3ac; --lavender: #d3c6ea;
    --serif: 'Bodoni Moda', 'Playfair Display', Georgia, serif;
    --mono: 'JetBrains Mono', ui-monospace, monospace;
    --sans: 'Inter', system-ui, -apple-system, sans-serif;
    background: var(--bg); color: var(--ink); font: 16px/1.65 var(--sans); -webkit-font-smoothing: antialiased; min-height: 100vh;
  }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .cs a { color: inherit; }
  .cs :focus-visible, .top:focus-visible { outline: 3px solid var(--deep); outline-offset: 3px; border-radius: 6px; }
  .progress { position: fixed; inset: 0 0 auto 0; height: 4px; z-index: 50; pointer-events: none; }
  #bar { height: 100%; width: 0; background: var(--deep); }
  h1, h2, h3 { font-family: var(--serif); font-weight: 500; margin: 0; text-wrap: balance; }
  ul { list-style: none; margin: 0; padding: 0; }

  .chip { display: inline-block; font: 500 12px/1 var(--mono); background: var(--c); color: var(--ink); padding: 7px 12px; border-radius: 999px; margin-bottom: 16px; }
  .chips { display: flex; gap: 8px; flex-wrap: wrap; margin: 0 0 16px; }
  .chips .chip { margin: 0; }

  /* Hero */
  .hero { border-bottom: 1px solid var(--border); padding: 24px 0 72px; }
  .inner { max-width: 1100px; margin: 0 auto; padding: 0 24px; }
  .topbar { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; padding-bottom: 20px; margin-bottom: 48px; border-bottom: 1px solid var(--border); }
  .back, .tabs-top a { font: 500 13px var(--mono); text-decoration: none; padding: 8px 12px; border-radius: 999px; transition: background .2s; }
  .back { display: inline-flex; gap: 6px; align-items: center; padding-left: 0; }
  .back:hover, .tabs-top a:hover { background: var(--mint); }
  .tabs-top { display: flex; gap: 6px; flex-wrap: wrap; }
  .tabs-top a { border: 1px solid var(--border); }
  .hero-grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: 64px; align-items: start; }
  h1 { font-size: clamp(2.5rem, 4.6vw, 4rem); line-height: 1.08; margin-bottom: 20px; }
  .lead { font-size: 18px; line-height: 1.6; color: #2d3340; max-width: 56ch; margin: 0 0 32px; }
  .cta { display: inline-flex; align-items: center; gap: 10px; background: var(--ink); color: #fff !important; font-weight: 600; text-decoration: none; padding: 14px 26px; border-radius: 999px; transition: transform .2s, background .2s; }
  .cta:hover { background: var(--deep); transform: translateY(-2px); }
  .specs { margin: 0; background: var(--card); border: 1px solid var(--border); border-radius: 16px; box-shadow: var(--shadow); padding: 24px; display: grid; gap: 16px; }
  .specs dt { font: 500 12px var(--mono); color: var(--muted); }
  .specs dd { margin: 2px 0 0; font-weight: 600; }

  .kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 56px; }
  .kpi { background: var(--card); border: 1px solid var(--border); border-top: 6px solid var(--c); border-radius: 16px; padding: 24px; box-shadow: var(--shadow); }
  .kpi-value { font: 500 3rem/1 var(--serif); margin: 0 0 10px; }
  .kpi-label { font: 600 14px var(--mono); margin: 0 0 4px; }
  .kpi-detail { font-size: 14px; color: var(--muted); margin: 0; }

  /* Layout and nav */
  .layout { max-width: 1100px; margin: 0 auto; padding: 80px 24px 120px; display: grid; grid-template-columns: 200px 1fr; gap: 64px; align-items: start; }
  .toc-wrap { position: sticky; top: 32px; }
  .toc { display: flex; flex-direction: column; }
  .toc-title { font: 500 12px var(--mono); color: var(--muted); margin: 0 0 8px; }
  .toc a { font-size: 14px; text-decoration: none; color: var(--muted); padding: 7px 0 7px 14px; border-left: 2px solid var(--border); transition: color .2s, border-color .2s; }
  .toc a:hover { color: var(--ink); }
  .toc a[aria-current] { color: var(--ink); font-weight: 600; border-left-color: var(--deep); background: linear-gradient(90deg, var(--mint), transparent); }

  section { margin-bottom: 96px; scroll-margin-top: 32px; }
  .cols { display: grid; grid-template-columns: 42% 58%; gap: 40px; align-items: start; }
  h2 { font-size: clamp(1.6rem, 2.4vw, 2.2rem); line-height: 1.25; }
  .prose { line-height: 1.7; color: #333a48; max-width: 62ch; }
  .prose p { margin: 0 0 14px; }
  .bullets { margin-top: 14px; }
  .bullets li { position: relative; padding-left: 22px; margin-bottom: 10px; }
  .bullets li::before { content: ""; position: absolute; left: 0; top: .7em; width: 8px; height: 8px; border-radius: 2px; background: var(--deep); }
  blockquote { margin: 24px 0 0; padding: 18px 20px; background: var(--card); border: 1px solid var(--border); border-left: 6px solid var(--amber); border-radius: 12px; }
  blockquote p { font-style: italic; margin: 0 0 8px; color: var(--ink); }
  cite { font: 500 12px var(--mono); color: var(--muted); font-style: normal; }

  /* Figures and lightbox */
  .shot { margin: 0 0 96px; background: var(--card); border: 1px solid var(--border); border-radius: 16px; box-shadow: var(--shadow); padding: 14px; }
  .shot-bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; background: var(--c); border-radius: 10px; padding: 8px 14px; margin-bottom: 14px; font: 500 12px var(--mono); }
  .hint { color: #3a4050; }
  .zoom { display: block; width: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; border-radius: 10px; overflow: hidden; }
  .shot img, .shot-img { width: 100%; height: auto; display: block; background: var(--mint); min-height: 180px; transition: transform .4s; }
  .zoom:hover img { transform: scale(1.015); }
  figcaption { margin-top: 12px; font-size: 13px; color: var(--muted); }
  dialog { border: 0; border-radius: 16px; padding: 12px; max-width: min(1200px, 94vw); max-height: 94vh; background: var(--card); }
  dialog::backdrop { background: rgba(31, 36, 48, .7); }
  dialog img { max-width: 100%; max-height: 82vh; display: block; margin: 12px auto 0; }
  .close { font: 600 13px var(--mono); padding: 10px 16px; border-radius: 999px; border: 1px solid var(--border); background: var(--bg); cursor: pointer; }

  /* Compare */
  .compare { background: var(--card); border: 1px solid var(--border); border-radius: 16px; box-shadow: var(--shadow); padding: 24px; }
  .tabs { display: flex; gap: 8px; margin-bottom: 20px; flex-wrap: wrap; }
  .tabs button { font: 600 13px var(--mono); min-height: 44px; padding: 10px 18px; border-radius: 999px; border: 1px solid var(--border); background: var(--bg); color: var(--ink); cursor: pointer; transition: background .2s; }
  .tabs button:hover { background: var(--mint); }
  .tabs button[aria-selected="true"].t-before { background: var(--coral); border-color: var(--coral); }
