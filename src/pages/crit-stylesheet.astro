---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import CritterTabs from '../components/CritterTabs.astro';
import bog from '../../public/bog.png';
import bogCard from '../../public/critter/bog.card.png';
import forest from '../../public/forest.png';
import critUi from '../../public/critter/crit-ui.png';
import critType from '../../public/critter/crit-type.png';

// Colours are sampled from the game's palette. Check the names and "use" notes match how the game uses them.
// Each colour is paired with whichever of Bark or Paper gives it the stronger contrast.
const colours = [
  { name: "Bark", hex: "#3b3029", text: "#f8efd4", textName: "paper", use: "Text and hand-drawn outlines" },
  { name: "Paper", hex: "#f8efd4", text: "#3b3029", textName: "bark", use: "Button fills and backgrounds" },
  { name: "Blush", hex: "#e4bfc0", text: "#3b3029", textName: "bark", use: "Soft panels" },
  { name: "Terracotta", hex: "#d28161", text: "#3b3029", textName: "bark", use: "Ticks and 'something new' dots" },
  { name: "Marmalade", hex: "#db9c57", text: "#3b3029", textName: "bark", use: "Warm highlights" },
  { name: "Sunshine", hex: "#f7db5a", text: "#3b3029", textName: "bark", use: "Rewards and celebration" },
  { name: "Plum", hex: "#875c95", text: "#f8efd4", textName: "paper", use: "Accents" },
  { name: "Duck egg", hex: "#a1c8cc", text: "#3b3029", textName: "bark", use: "Sky and calm panels" },
  { name: "Forest", hex: "#405a35", text: "#f8efd4", textName: "paper", use: "Primary actions" },
  { name: "Fern", hex: "#607a41", text: "#f8efd4", textName: "paper", use: "Foliage" },
  { name: "Moss", hex: "#556943", text: "#f8efd4", textName: "paper", use: "Foliage shadows" },
  { name: "Sage", hex: "#97a963", text: "#3b3029", textName: "bark", use: "Grass and ground" },
  { name: "Lime", hex: "#9fbb56", text: "#3b3029", textName: "bark", use: "Success states" },
  { name: "Charcoal", hex: "#4d4a45", text: "#f8efd4", textName: "paper", use: "Secondary text" },
  { name: "Conker", hex: "#9e6c45", text: "#f8efd4", textName: "paper", use: "Wood and props" },
  { name: "Biscuit", hex: "#a78263", text: "#3b3029", textName: "bark", use: "Paths and props" }
];
const lum = (hex: string) => {
  const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255)
    .map((c) => (c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4));
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};
const ratio = (a: string, b: string) => {
  const [hi, lo] = [lum(a), lum(b)].sort((x, y) => y - x);
  return (hi + 0.05) / (lo + 0.05);
};
// 4.5:1 passes AA for body text, 3:1 passes AA for large text (24px, or 19px bold) only
const swatches = colours.map((c) => {
  const r = ratio(c.hex, c.text);
  const level = r >= 4.5 ? 'pass' : r >= 3 ? 'large' : 'fail';
  return { ...c, ratio: r.toFixed(1), level };
});
const passing = swatches.filter((s) => s.level === 'pass').length;
const badge = { pass: '✓ Passes AA', large: '◐ AA large text only', fail: '✕ Fails AA' };
const button = { fill: "#f8efd4", ink: "#3b3029", line: "#3b3029" };

// The button specimen uses Euclid Circular B if it's installed, then falls back to Lucida Sans.
const fonts = { body: "'Euclid Circular B', 'Lucida Sans', 'Lucida Grande', system-ui, sans-serif" };

const states = [
  { cls: "", label: "Default" }, { cls: "is-hover", label: "Hover" }, { cls: "is-focus", label: "Keyboard focus" },
  { cls: "is-active", label: "Pressed" }, { cls: "is-disabled", label: "Disabled" }
];

// Check each of these is true of the live game (for example, that the icon buttons really have aria-labels).
const uiNotes = [
  { title: "Pictures before words", text: "Most players are still learning to read, so every control is an icon they can recognise: information, a worksheet, print and back. Each icon button carries a spoken label for screen readers." },
  { title: "Drawn like the characters", text: "Thea hand-drew the controls with wobbly bark-brown outlines on paper-cream fills, matching the critters, so they feel like part of the storybook rather than a layer on top." },
  { title: "One colour means new", text: "A single terracotta dot marks something waiting to be opened. Keeping that accent for one job means children learn what it means quickly." },
  { title: "Progress you can count", text: "A row of boxes fills with ticks as activities are finished. Children see how far they've come without reading numbers, and the tick shape carries the meaning, not the colour alone." }
];

// Check these titles and descriptions match what each image actually shows.
const assets = [
  { img: bog, tag: "Scenes", title: "The bog scene", desc: "A hand-drawn habitat in the single-brush style used across the game.", alt: "The hand-drawn bog scene from the game" },
  { img: bogCard, tag: "Cards", title: "A trading card", desc: "Real facts paired with a character, kept in the collapsible card drawer.", alt: "A bog insect trading card showing the character and facts about the species" },
  { img: forest, tag: "Scenes", title: "The woodland scene", desc: "Full-screen scene with edge-anchored controls and a progress counter.", alt: "The hand-drawn woodland scene from the game" }
];

const nav = [["overview", "Overview"], ["colour", "Colour"], ["typography", "Typography"], ["components", "Components"], ["assets", "Assets"], ["principles", "Principles"]];
---

<Layout title="Critter & Friends: Design System" bg="#fbfaf4">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,500;0,700;1,500&family=JetBrains+Mono:wght@500;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <div class="progress" aria-hidden="true"><div id="bar"></div></div>
  <a class="skip" href="#content">Skip to design system</a>

  <main class="cs" id="cs">
    <header class="hero">
      <div class="inner">
        <CritterTabs current="system" />

        <div class="hero-grid">
          <div>
            <p class="chips">
              <span class="chip" style="--c: var(--yellow)">Design system</span>
              <span class="chip" style="--c: var(--mint)" id="readTime">2 min read</span>
            </p>
            <h1>Critter &amp; Friends design system</h1>
            <p class="lead">The colour, type, components and hand-drawn characters behind the game, built for children aged 5 to 8.</p>
            <a class="cta" target="_blank" rel="noopener noreferrer" href="https://critterandfriends.netlify.app/">
              See it in the live game
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3.5 10.5l7-7m0 0H4.67m5.83 0v5.83" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span class="sr">(opens in a new tab)</span>
            </a>
          </div>
          <dl class="specs" aria-label="System overview">
            <div><dt>Credits</dt><dd>Illustration and hand-drawn UI by Thea Rummel; interface planning and build together</dd></div>
            <div><dt>Typography</dt><dd>Euclid Circular B, Lucida Sans and a handwritten accent</dd></div>
            <div><dt>Colour</dt><dd>Earthy storybook palette, with the WCAG AA result for each pair</dd></div>
            <div><dt>Assets</dt><dd>Vector SVG and sprite sheet animations</dd></div>
            <div><dt>Tools</dt><dd>Next.js, HTML/CSS, JavaScript, Three.js, Illustrator (Thea)</dd></div>
          </dl>
        </div>

        <div class="kpis">
          <div class="kpi" style="--c: var(--mint)"><p class="kpi-value">{colours.length}</p><p class="kpi-label">Colour tokens</p><p class="kpi-detail">Each checked against its text colour.</p></div>
          <div class="kpi" style="--c: var(--coral)"><p class="kpi-value">{passing}/{colours.length}</p><p class="kpi-label">Pass AA for body text</p><p class="kpi-detail">The rest are kept to large text and illustration.</p></div>
          <!-- Check 48px in dev tools before keeping this. If it's real, add it to the interface rules on the research page too. -->
          <div class="kpi" style="--c: var(--sage)"><p class="kpi-value">48px</p><p class="kpi-label">Minimum target</p><p class="kpi-detail">Large and forgiving for young hands.</p></div>
        </div>
      </div>
    </header>

    <div class="layout">
      <aside class="toc-wrap">
        <nav class="toc" aria-label="On this page">
          <p class="toc-title">On this page</p>
          {nav.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
        </nav>
      </aside>

      <div class="content" id="content">
        <section id="overview" class="reveal">
          <span class="chip" style="--c: var(--sage)">Overview</span>
          <div class="cols">
            <h2>A playful visual language that keeps the interface out of the child's way.</h2>
            <div class="prose">
              <p>The system pairs a child-friendly look with accessibility goals. The colour table shows which pairs pass WCAG 2.1 AA and which are limited to large text and illustration. Known gaps, such as keyboard navigation and focus indicators, are listed on the <a href="/crit-research">research page</a>.</p>
              <p>Every choice is tuned for developing motor skills and early reading: large targets, few controls, and feedback children can see.</p>
            </div>
          </div>
        </section>

        <section id="colour" class="reveal">
          <span class="chip" style="--c: var(--coral)">Colour</span>
          <div class="cols">
            <h2>An earthy storybook palette, with every colour paired and tested.</h2>
            <div class="prose">
              <p>Bark brown and paper cream do most of the work, as the outline and fill of nearly everything on screen. Greens and soft blues build the critters' world, and warm accents are saved for rewards and anything new.</p>
              <p>Ratios are calculated from the hex values. Body text needs 4.5:1 to meet WCAG 2.1 AA; colours that only reach 3:1 are used for large text and illustration, never for instructions.</p>
            </div>
          </div>

          <ul class="swatches">
            {swatches.map((c) => (
              <li class="swatch">
                <div class="sw-color" style={`background:${c.hex};color:${c.text}`} aria-hidden="true">Aa</div>
                <div class="sw-meta">
                  <h3>{c.name}</h3>
                  <p class="hex">{c.hex}</p>
                  <p>{c.use}</p>
                  <p>{c.ratio}:1 with {c.textName} text</p>
                  <p class={`badge ${c.level}`}>{badge[c.level]}</p>
                </div>
              </li>
            ))}
          </ul>
        </section>

        <section id="typography" class="reveal">
          <span class="chip" style="--c: var(--yellow)">Typography</span>
          <div class="cols">
            <h2>A round, friendly sans for reading and a handwritten touch for character.</h2>
            <div class="prose">
              <p>Euclid Circular B carries headings in Bold and buttons and labels in Medium. Its round, open letters are friendly and clear for early readers.</p>
              <p>Lucida Sans sets longer instructions, where its wide letter spacing keeps words easy to tell apart. Adobe Handwriting Ernie adds a storybook feel, but joined-up script is hard for young readers, so it's kept to decoration and never used for instructions.</p>
            </div>
          </div>

          <figure class="shot wide-shot">
            <div class="shot-bar" style="--c: var(--yellow)"><span>Typefaces</span><span class="hint">Click to enlarge</span></div>
            <button class="zoom" type="button" aria-label="Enlarge the typefaces"><Image class="shot-img type-img" src={critType} alt="The game's typefaces: Euclid Circular B Bold, Euclid Circular B Medium, Adobe Handwriting Ernie and Lucida Sans Regular" loading="lazy" /></button>
            <figcaption>The four typefaces used across the game.</figcaption>
          </figure>
        </section>

        <section id="components" class="reveal" style={`--btn:${button.fill};--btn-ink:${button.ink};--btn-line:${button.line};--body:${fonts.body}`}>
          <span class="chip" style="--c: var(--lavender)">Components</span>
          <div class="cols">
            <h2>Controls a five-year-old can use without reading a word.</h2>
            <div class="prose">
              <p>We kept the interface minimal on purpose, because this is a children's game. Thea hand-drew every control in a children's book style, and we decided together where each one sits, how it looks and how many buttons a child has to press.</p>
              <p>The result is a small set of icon buttons and one progress tracker. Each one had to make sense to a child who can't yet read the label, be easy to hit with a small finger, and look like it belongs in the same world as the characters.</p>
            </div>
          </div>

          <figure class="shot wide-shot">
            <div class="shot-bar" style="--c: var(--lavender)"><span>UI elements</span><span class="hint">Click to enlarge</span></div>
            <button class="zoom" type="button" aria-label="Enlarge the UI elements"><Image class="shot-img ui-img" src={critUi} alt="Hand-drawn cream buttons with brown outlines: an information button, a worksheet icon with a terracotta dot, a print button, a back arrow, and a row of boxes each marked with a terracotta tick" loading="lazy" /></button>
            <figcaption>Icon buttons and the progress tracker, hand-drawn by Thea in the same style as the characters.</figcaption>
          </figure>

          <ul class="ui-notes">
            {uiNotes.map((n) => (
              <li><h3>{n.title}</h3><p>{n.text}</p></li>
            ))}
          </ul>

          <div class="cols sub">
            <h3>Button states, designed for the next build.</h3>
            <div class="prose"><p>These specimens show the states a button in the game's style should have, using Euclid Circular B where it is installed. Visible keyboard focus isn't in the live game yet. It is the first accessibility fix on the <a href="/crit-research">research page</a>.</p></div>
          </div>
          <div class="states" aria-label="Button states">
            {states.map((s) => (
              <div class="state"><span class={`btn ${s.cls}`} aria-hidden="true">Play</span><p>{s.label}</p></div>
            ))}
          </div>
          <div class="target-demo">
            <span class="target-box" aria-hidden="true"></span>
            <p>Minimum target: 48 × 48px, with space around it so a missed tap still lands.</p>
          </div>
        </section>

        <section id="assets" class="reveal">
          <span class="chip" style="--c: var(--sage)">Assets</span>
          <div class="cols">
            <h2>Hand-drawn characters and world elements.</h2>
            <div class="prose"><p>Thea drew every scene, character and card by hand in one consistent line, so the game reads as a children's book rather than an interface.</p></div>
          </div>
          <div class="gallery">
            {assets.map((a) => (
              <figure class="shot asset">
                <div class="shot-bar" style="--c: var(--mint)"><span>{a.tag}</span><span class="hint">Click to enlarge</span></div>
                <button class="zoom" type="button" aria-label={`Enlarge ${a.title.toLowerCase()}`}><Image class="shot-img" src={a.img} alt={a.alt} loading="lazy" /></button>
                <figcaption><h3>{a.title}</h3><p>{a.desc}</p></figcaption>
              </figure>
            ))}
          </div>
        </section>

        <section id="principles" class="reveal">
          <span class="chip" style="--c: var(--amber)">Principles</span>
          <div class="cards">
            <article style="--c: var(--yellow)"><h3>Legible first</h3><p>Icons that work before reading does, and round sans-serif type sized for early readers. Handwriting is for decoration only.</p></article>
            <article style="--c: var(--mint)"><h3>Contrast where it counts</h3><p>Instruction text uses colour pairs that reach 4.5:1. Softer pairs are kept to large text and illustration.</p></article>
            <article style="--c: var(--lavender)"><h3>Minimal on purpose</h3><p>Few controls, each one an icon, so a child is never choosing between many things. The hand-drawn style gives it the look of a children's book.</p></article>
          </div>
        </section>
      </div>
    </div>

    <button id="top" class="top" type="button" aria-label="Back to top">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 15l-6-6-6 6"/></svg>
    </button>

    <dialog id="lightbox" aria-label="Enlarged figure">
      <button type="button" id="closeLb" class="close">Close</button>
      <img id="lbImg" alt="" />
    </dialog>
  </main>
</Layout>

<script>
  function init() {
    const root = document.getElementById('cs');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    root.classList.add('js');
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Reading time
    const rt = document.getElementById('readTime');
    const words = (document.getElementById('content')?.textContent || '').trim().split(/\s+/).length;
    if (rt) rt.textContent = `${Math.max(1, Math.ceil(words / 200))} min read`;

    // Progress bar, back-to-top
    const bar = document.getElementById('bar');
    const top = document.getElementById('top');
    const onScroll = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      if (bar) bar.style.width = `${max > 0 ? (scrollY / max) * 100 : 0}%`;
      top?.classList.toggle('show', scrollY > 500);
    };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    top?.addEventListener('click', () => scrollTo({ top: 0, behavior: still ? 'auto' : 'smooth' }));

    // Active section in the index
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
    const spy = new IntersectionObserver((es) => es.forEach((e) => {
      if (e.isIntersecting) links.forEach((a) => a.toggleAttribute('aria-current', a.hash === `#${e.target.id}`));
    }), { rootMargin: '-20% 0px -70% 0px' });
    document.querySelectorAll('.content section').forEach((s) => spy.observe(s));

    // Reveal on scroll
    const reveal = new IntersectionObserver((es) => es.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add('visible'); reveal.unobserve(e.target); }
    }), { threshold: 0.1 });
    document.querySelectorAll('.reveal').forEach((el) => reveal.observe(el));

    // Lightbox for figures
    const lb = document.getElementById('lightbox') as HTMLDialogElement | null;
    const lbImg = document.getElementById('lbImg') as HTMLImageElement | null;
    document.querySelectorAll<HTMLButtonElement>('.zoom').forEach((b) => b.addEventListener('click', () => {
      const img = b.querySelector('img');
      if (!lb || !lbImg || !img) return;
      lbImg.src = img.currentSrc || img.src; lbImg.alt = img.alt; lb.showModal();
    }));
    document.getElementById('closeLb')?.addEventListener('click', () => lb?.close());
    lb?.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
  }
  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .cs {
    --bg: #fbfaf4; --card: #fff; --ink: #1f2430; --muted: #5a6070; --border: #d3d6df;
    --deep: #3f6b52; --shadow: 0 8px 28px rgba(31, 36, 48, .08);
    --yellow: #f6e7b0; --sage: #b5d0bf; --mint: #d0e1d4; --coral: #f0b7ab; --amber: #efd3ac; --lavender: #d3c6ea;
    --serif: 'Bodoni Moda', 'Playfair Display', Georgia, serif;
    --mono: 'JetBrains Mono', ui-monospace, monospace;
    --sans: 'Inter', system-ui, -apple-system, sans-serif;
    background: var(--bg); color: var(--ink); font: 16px/1.65 var(--sans); -webkit-font-smoothing: antialiased; min-height: 100vh;
  }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .cs a { color: inherit; }
  .cs :focus-visible, .top:focus-visible { outline: 3px solid var(--deep); outline-offset: 3px; border-radius: 6px; }
  .progress { position: fixed; inset: 0 0 auto 0; height: 4px; z-index: 50; pointer-events: none; }
  #bar { height: 100%; width: 0; background: var(--deep); }
  h1, h2, h3 { font-family: var(--serif); font-weight: 500; margin: 0; text-wrap: balance; }
  ul { list-style: none; margin: 0; padding: 0; }

  .chip { display: inline-block; font: 500 12px/1 var(--mono); background: var(--c); color: var(--ink); padding: 7px 12px; border-radius: 999px; margin-bottom: 16px; }
  .chips { display: flex; gap: 8px; flex-wrap: wrap; margin: 0 0 16px; }
  .chips .chip { margin: 0; }

  /* Hero */
  .hero { border-bottom: 1px solid var(--border); padding: 24px 0 72px; }
  .inner { max-width: 1100px; margin: 0 auto; padding: 0 24px; }
  .hero-grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: 64px; align-items: start; }
  h1 { font-size: clamp(2.5rem, 4.6vw, 4rem); line-height: 1.08; margin-bottom: 20px; }
  .lead { font-size: 18px; line-height: 1.6; color: #2d3340; max-width: 56ch; margin: 0 0 32px; }
  .cta { display: inline-flex; align-items: center; gap: 10px; background: var(--ink); color: #fff !important; font-weight: 600; text-decoration: none; padding: 14px 26px; border-radius: 999px; transition: transform .2s, background .2s; }
  .cta:hover { background: var(--deep); transform: translateY(-2px); }
  .specs { margin: 0; background: var(--card); border: 1px solid var(--border); border-radius: 16px; box-shadow: var(--shadow); padding: 24px; display: grid; gap: 16px; }
  .specs dt { font: 500 12px var(--mono); color: var(--muted); }
  .specs dd { margin: 2px 0 0; font-weight: 600; }

  .kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 56px; }
  .kpi { background: var(--card); border: 1px solid var(--border); border-top: 6px solid var(--c); border-radius: 16px; padding: 24px; box-shadow: var(--shadow); }
  .kpi-value { font: 500 3rem/1 var(--serif); margin: 0 0 10px; }
  .kpi-label { font: 600 14px var(--mono); margin: 0 0 4px; }
  .kpi-detail { font-size: 14px; color: var(--muted); margin: 0; }

  /* Layout and nav */
  .layout { max-width: 1100px; margin: 0 auto; padding: 80px 24px 120px; display: grid; grid-template-columns: 200px 1fr; gap: 64px; align-items: start; }
  .toc-wrap { position: sticky; top: 32px; }
  .toc { display: flex; flex-direction: column; }
  .toc-title { font: 500 12px var(--mono); color: var(--muted); margin: 0 0 8px; }
  .toc a { font-size: 14px; text-decoration: none; color: var(--muted); padding: 7px 0 7px 14px; border-left: 2px solid var(--border); transition: color .2s, border-color .2s; }
  .toc a:hover { color: var(--ink); }
  .toc a[aria-current] { color: var(--ink); font-weight: 600; border-left-color: var(--deep); background: linear-gradient(90deg, var(--mint), transparent); }

  section { margin-bottom: 96px; scroll-margin-top: 32px; }
  .cols { display: grid; grid-template-columns: 42% 58%; gap: 40px; align-items: start; }
  h2 { font-size: clamp(1.6rem, 2.4vw, 2.2rem); line-height: 1.25; }
  .prose { line-height: 1.7; color: #333a48; max-width: 62ch; }
  .prose p { margin: 0 0 14px; }

  /* Figures and lightbox */
  .shot { margin: 0 0 96px; background: var(--card); border: 1px solid var(--border); border-radius: 16px; box-shadow: var(--shadow); padding: 14px; }
  .shot-bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; background: var(--c); border-radius: 10px; padding: 8px 14px; margin-bottom: 14px; font: 500 12px var(--mono); }
  .hint { color: #3a4050; }
  .zoom { display: block; width: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; border-radius: 10px; overflow: hidden; }
  .shot img, .shot-img { width: 100%; height: auto; display: block; background: var(--mint); min-height: 180px; transition: transform .4s; }
  .zoom:hover img { transform: scale(1.015); }
  figcaption { margin-top: 12px; font-size: 13px; color: var(--muted); }
