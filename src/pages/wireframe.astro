    screens: [
      { img: "/hr1.png", caption: "Login View" },
      { img: "/h2.png", caption: "Signup View" },
      { img: "/h3.png", caption: "Homescreen showing courses" },
      { img: "/h4.png", caption: "Assignment page" },
      { img: "/h5.png", caption: "Material Page" },
      { img: "/h6.png", caption: "Grades page" },
    ]
  },
  {
    title: "Personal Workspace",
    screens: [
      { img: "/h7.png", caption: "Explore Map" },
      { img: "/h8.png", caption: "Calendar Detail" },
      { img: "/h9.png", caption: "One choice" },
      { img: "/h10.png", caption: "5 choices" },
