---
import Layout from '../layouts/Layout.astro';

const wireframeFlows = [
  {
    category: "Academic & Coursework",
    lowRes: [
      { img: "/w1.png", title: "Login Entry", caption: "Standardized SSO login flow" },
      { img: "/w3.png", title: "Dashboard", caption: "At-a-glance active modules & alerts" },
      { img: "/w4.png", title: "Assignment View", caption: "Priority deadlines and submission status" },
      { img: "/w6.png", title: "Grades Overview", caption: "Filterable module grade break-down" }
    ],
    highRes: [
      { img: "/hr1.png", title: "Login Entry", caption: "Brand-aligned authentication state" },
      { img: "/h3.png", title: "Dashboard", caption: "High-contrast priority module cards" },
      { img: "/h4.png", title: "Assignment View", caption: "Interactive submission drawer & brief" },
      { img: "/h6.png", title: "Grades Overview", caption: "Visual progress tracking indicators" }
    ]
  },
  {
    category: "Personal Workspace",
    lowRes: [
      { img: "/w7.png", title: "Campus Map", caption: "Interactive spatial selection" },
      { img: "/w9.png", title: "Schedule View", caption: "Daily time-block mapping" },
      { img: "/w12.png", title: "Location Detail", caption: "Building utilities & room status" }
    ],
    highRes: [
      { img: "/h7.png", title: "Campus Map", caption: "Vector map integration with live occupancy" },
      { img: "/h8.png", title: "Schedule View", caption: "Calendar sync & conflict detection" },
      { img: "/h12.png", title: "Location Detail", caption: "Equipment booking integrations" }
    ]
  }
];
---

<Layout title="STU Platform — Wireframes & UX Flow">
  <main class="wireframe-page">
    
    <!-- Header & Sub Navigation -->
    <header class="wf-header reveal-on-scroll">
      <div class="header-top">
        <a href="/work" class="back-link" aria-label="Back to Work">← Back to Work</a>
        
        <nav class="project-nav" aria-label="Project Sections">
          <a href="/stylesheet" class="nav-tab">Style Guide</a>
          <a href="/wireframe" class="nav-tab active">Wireframes & Site Map</a>
          <a href="/research" class="nav-tab">Research</a>
        </nav>
      </div>

      <h1 class="page-title">Information Architecture & Wireframes</h1>
      <p class="page-subtitle">
        Bridging academic tools and campus infrastructure through structured mobile-first wireframing.
      </p>
    </header>

    <!-- Key UX Highlights -->
    <section class="ux-summary-card reveal-on-scroll">
      <h2 class="summary-title">Core UX Principles</h2>
      <div class="highlights-grid">
        <div class="highlight-item">
          <h3>Visual Hierarchy</h3>
          <p>Critical deadlines, course announcements, and campus updates placed above the fold to minimize cognitive load.</p>
        </div>
        <div class="highlight-item">
          <h3>Frictionless Navigation</h3>
          <p>Persistent global tab bars paired with contextual back buttons ensure users never lose their spatial orientation.</p>
        </div>
        <div class="highlight-item">
          <h3>Component Consistency</h3>
          <p>Standardized form inputs, accordion filters, and utility cards maintain strict design system alignment.</p>
        </div>
      </div>
    </section>

    <!-- Site Map Section -->
    <section class="sitemap-section reveal-on-scroll">
      <div class="section-heading">
        <span class="section-tag">Information Architecture</span>
        <h2>System Site Map</h2>
        <p>A unified hub mapping direct paths from high-priority academic tasks to student services.</p>
      </div>

      <div class="sitemap-card">
        <img src="/sitemap.png" alt="STU Platform Sitemap Architecture" class="sitemap-img" />
      </div>
    </section>

    <!-- Wireframe Flow Section with Low-Fi / Hi-Fi Toggle -->
    <section class="wireframes-section reveal-on-scroll">
      <div class="section-heading-row">
        <div>
          <span class="section-tag">Interaction Design</span>
          <h2>Screen Flows & Key States</h2>
        </div>

        <!-- Mode Toggle Switch -->
        <div class="view-toggle" role="tablist">
          <button class="toggle-btn active" id="btn-hifi" onclick="switchView('hifi')">High-Fidelity</button>
          <button class="toggle-btn" id="btn-lofi" onclick="switchView('lofi')">Low-Fidelity Wireframes</button>
        </div>
      </div>

      <!-- Flows Container -->
      <div class="flows-list">
        {wireframeFlows.map((flow) => (
          <div class="flow-group">
            <h3 class="flow-category-title">{flow.category}</h3>

            <!-- High-Res View (Default Active) -->
            <div class="screens-grid view-hifi">
              {flow.highRes.map((screen) => (
                <div class="screen-card">
                  <div class="phone-frame">
                    <img src={screen.img} alt={screen.title} class="screen-img" loading="lazy" />
                  </div>
                  <div class="screen-meta">
                    <span class="screen-title">{screen.title}</span>
                    <p class="screen-caption">{screen.caption}</p>
                  </div>
                </div>
              ))}
            </div>

            <!-- Low-Res View (Hidden by Default) -->
            <div class="screens-grid view-lofi" style="display: none;">
              {flow.lowRes.map((screen) => (
                <div class="screen-card">
                  <div class="phone-frame lofi-frame">
                    <img src={screen.img} alt={screen.title} class="screen-img" loading="lazy" />
                  </div>
                  <div class="screen-meta">
                    <span class="screen-title">{screen.title}</span>
                    <p class="screen-caption">{screen.caption}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

  </main>
</Layout>

<script>
  // Toggle between Hi-Fi and Low-Fi Wireframe views
  function switchView(mode: 'hifi' | 'lofi') {
    const hifiGrids = document.querySelectorAll('.view-hifi');
    const lofiGrids = document.querySelectorAll('.view-lofi');
    const btnHifi = document.getElementById('btn-hifi');
    const btnLofi = document.getElementById('btn-lofi');

    if (mode === 'lofi') {
      hifiGrids.forEach(el => (el as HTMLElement).style.display = 'none');
      lofiGrids.forEach(el => (el as HTMLElement).style.display = 'grid');
      btnHifi?.classList.remove('active');
      btnLofi?.classList.add('active');
    } else {
      lofiGrids.forEach(el => (el as HTMLElement).style.display = 'none');
      hifiGrids.forEach(el => (el as HTMLElement).style.display = 'grid');
      btnLofi?.classList.remove('active');
      btnHifi?.classList.add('active');
    }
  }

  // Scroll Reveal Observer
  function initScrollReveal() {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });

    document.querySelectorAll('.reveal-on-scroll').forEach(el => observer.observe(el));
  }

  document.addEventListener('DOMContentLoaded', initScrollReveal);
  document.addEventListener('astro:page-load', initScrollReveal);
  
  // Expose function globally for inline click handlers
  (window as any).switchView = switchView;
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

  html {
    scroll-behavior: smooth;
  }

  /* Base Typography reset */
  .wireframe-page,
  .wireframe-page p,
  .wireframe-page span,
  .wireframe-page button,
  .wireframe-page a {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  .wireframe-page h1,
  .wireframe-page h2 {
    font-family: 'Bodoni Moda', 'Playfair Display', serif;
  }

  .wireframe-page {
    background-color: #f8f7f4;
    color: #1a1a1a;
    min-height: 100vh;
    padding: 40px 5% 120px;
    max-width: 1280px;
    margin: 0 auto;
  }

  /* --- Scroll Reveal --- */
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), 
                transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .reveal-on-scroll.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* --- Header --- */
  .wf-header {
    margin-bottom: 60px;
  }

  .header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 32px;
    flex-wrap: wrap;
    gap: 16px;
  }

  .back-link {
    font-size: 14px;
    font-weight: 500;
    color: #666;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: #000;
  }

  .project-nav {
    display: flex;
    background: #eae8e1;
    padding: 4px;
    border-radius: 100px;
    gap: 4px;
  }

  .nav-tab {
    padding: 6px 16px;
    font-size: 13px;
    font-weight: 500;
    color: #555;
    text-decoration: none;
    border-radius: 100px;
    transition: all 0.2s ease;
  }

  .nav-tab.active,
  .nav-tab:hover {
    background: #ffffff;
    color: #0c0c0c;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  }

  .page-title {
    font-size: clamp(2.2rem, 4.5vw, 3.6rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }

  .page-subtitle {
    font-size: 17px;
    line-height: 1.5;
    color: #555;
    max-width: 680px;
  }

  /* --- UX Summary Card --- */
  .ux-summary-card {
    background: #ffffff;
    border: 1px solid #e5e3dc;
    border-radius: 20px;
    padding: 36px;
    margin-bottom: 80px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.02);
  }

  .summary-title {
    font-size: 1.8rem;
    margin-bottom: 24px;
  }

  .highlights-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 28px;
  }

  .highlight-item h3 {
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 8px;
    color: #7500f3;
  }

  .highlight-item p {
    font-size: 14px;
    line-height: 1.6;
    color: #4a4a4a;
  }

  /* --- Sitemap Section --- */
  .sitemap-section {
    margin-bottom: 90px;
  }

  .section-heading {
    margin-bottom: 28px;
  }

  .section-tag {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #7500f3;
    display: block;
    margin-bottom: 6px;
  }

  .section-heading h2 {
    font-size: 2.2rem;
    margin-bottom: 8px;
  }

  .section-heading p {
    font-size: 15px;
    color: #555;
    max-width: 600px;
  }

  .sitemap-card {
    background: #ffffff;
    border: 1px solid #e5e3dc;
    border-radius: 20px;
    padding: 24px;
    text-align: center;
  }

  .sitemap-img {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
  }

  /* --- Wireframe Toggle & Grid --- */
  .section-heading-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
    flex-wrap: wrap;
    gap: 20px;
  }

  .view-toggle {
    display: flex;
    background: #eae8e1;
    padding: 4px;
    border-radius: 100px;
    gap: 4px;
  }

  .toggle-btn {
    padding: 8px 20px;
    font-size: 13px;
    font-weight: 600;
    color: #666;
    background: transparent;
    border: none;
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .toggle-btn.active {
    background: #0c0c0c;
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(0,0,0,0.12);
  }

  .flow-group {
    margin-bottom: 60px;
  }

  .flow-category-title {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 24px;
    padding-bottom: 8px;
    border-bottom: 1px solid #e2ded4;
  }

  .screens-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 32px;
  }

  .screen-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .phone-frame {
    background: #ffffff;
    border: 1px solid #222;
    border-radius: 28px;
    padding: 8px;
    box-shadow: 0 6px 18px rgba(0,0,0,0.04);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .lofi-frame {
    border-style: dashed;
    border-color: #888;
    background: #fcfbf8;
  }

  .phone-frame:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(0,0,0,0.08);
  }

  .screen-img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 20px;
  }

  .screen-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .screen-title {
    font-size: 14px;
    font-weight: 600;
    color: #111;
  }

  .screen-caption {
    font-size: 12px;
    line-height: 1.4;
    color: #666;
  }

  @media (max-width: 768px) {
    .wireframe-page {
      padding: 24px 16px 80px;
    }

    .screens-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .header-top {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>