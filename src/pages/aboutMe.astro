---
import Layout from '../layouts/Layout.astro';

const education = [
  {
    dates: "SEPT 2024 - JULY 2026",
    degree: "M.A. Digital Design",
    focus: "User Experience & User Interface",
    institution: "Stuttgart Media University"
  },
  {
    dates: "MAR 2024 - AUG 2024",
    degree: "B.Sc. Industrial Media Engineering",
    focus: "Media Design & Management",
    institution: "Stuttgart Media University"
  }
];

const experience = [
  {
    dates: "JULY 2026 - TODAY",
    role: "Art Direction",
    company: "VON HELDEN UND GESTALTEN GmbH",
    subtext: "Junior Designer"
  },
  {
    dates: "FEB 2026 - AUG 2026",
    role: "Social Media & Content Creation",
    company: "RECARO Gaming GmbH & Co. KG",
    subtext: "Working Student"
  },
  {
    dates: "AUG 2025 - JAN 2026",
    role: "Brand Marketing",
    company: "E. Breuninger GmbH & Co.",
    subtext: "Working Student"
  },
  {
    dates: "FEB 2025 - JUL 2025",
    role: "Employer Branding & Marketing",
    company: "Mercedes-Benz Management Consulting",
    subtext: "Working Student"
  },
  {
    dates: "MAY 2022 - JAN 2025",
    role: "Digital Design",
    company: "WongDoody GmbH (oddity GmbH)",
    subtext: "Working Student"
  }
];
---

<Layout title="About — Lydia Stewart">
  <main class="about-container">
    
    <!-- Left Main Column -->
    <div class="left-col">
      <!-- High-impact intro statement -->
      <h1 class="hero-statement">
        I build identities that move, <br />
        sometimes polished, sometimes <br />
        raw, always intentional.
      </h1>

      <!-- Bio block with profile photo -->
      <div class="bio-grid">
        <div class="photo-wrapper">
          <img src="/profile.jpg" alt="Lydia Stewart" class="profile-photo" />
        </div>

        <div class="bio-text">
          <p>
            <strong>I'm Lydia Stewart</strong>, a multidisciplinary designer exploring the intersection of culture, emotion, and aesthetics.
          </p>
          <p>
            Born in Ireland and working across digital mediums, my work is shaped by contrast and connection. Moving between disciplines taught me to see design as a way to navigate identity, tell stories, and balance tradition with change.
          </p>
          <p>
            I work across graphic design, branding, art direction, and UX/UI, creating visual identities that are both strategic and emotionally resonant. My approach is thoughtful, intentional, and human.
          </p>
        </div>
      </div>

      <!-- Contact email row -->
      <div class="contact-block">
        <span class="block-label">contact</span>
        <a href="mailto:lydia@example.com" class="email-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="16" x="2" y="4" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
          lydia.stewart@example.com
        </a>
      </div>

      <!-- Closing Manifesto Heading -->
      <h2 class="manifesto-statement">
        I love bold type, soft details, layered textures, and stories that don't fit neatly in boxes.
      </h2>
    </div>

    <!-- Right Column (Resume Details) -->
    <div class="right-col">
      
      <!-- Education Section -->
      <section class="resume-section">
        <h3 class="section-heading">education</h3>
        <div class="timeline-list">
          {education.map((item) => (
            <div class="timeline-item">
              <span class="timeline-date">{item.dates}</span>
              <div class="timeline-details">
                <h4 class="item-title">{item.degree}</h4>
                <p class="item-subtitle">{item.focus}</p>
                <p class="item-meta">{item.institution}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Experience Section -->
      <section class="resume-section">
        <h3 class="section-heading">experience</h3>
        <div class="timeline-list">
          {experience.map((item) => (
            <div class="timeline-item">
              <span class="timeline-date">{item.dates}</span>
              <div class="timeline-details">
                <h4 class="item-title">{item.role}</h4>
                <p class="item-subtitle">{item.company}</p>
                {item.subtext && <p class="item-meta">{item.subtext}</p>}
              </div>
            </div>
          ))}
        </div>
      </section>

    </div>

  </main>
</Layout>

<style>
  /* Base Layout Container */
  .about-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 60px 0 120px;
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 80px;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    color: #0d0d0d;
  }

  /* --- LEFT COLUMN --- */
  .left-col {
    display: flex;
    flex-direction: column;
  }

  .hero-statement {
    font-family: 'Bodoni Moda', 'Playfair Display', serif;
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: #0d0d0d;
    margin-bottom: 70px;
  }

  /* Bio & Photo Row */
  .bio-grid {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 32px;
    align-items: start;
    margin-bottom: 60px;
  }

  .photo-wrapper {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background-color: #f0f0f0;
  }

  .profile-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
  }

  .bio-text {
    font-size: 12.5px;
    line-height: 1.55;
    color: #555555;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .bio-text strong {
    color: #0d0d0d;
    font-weight: 700;
  }

  /* Contact Link */
  .contact-block {
    margin-bottom: 80px;
  }

  .block-label {
    display: block;
    font-size: 13px;
    font-weight: 800;
    text-transform: lowercase;
    margin-bottom: 12px;
    color: #0d0d0d;
  }

  .email-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    color: #666666;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .email-link:hover {
    color: #0d0d0d;
  }

  /* Manifesto Heading */
  .manifesto-statement {
    font-size: clamp(1.8rem, 2.8vw, 2.4rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: #0d0d0d;
    max-width: 540px;
    margin-left: auto; /* Aligns with the bio text on the right */
    display:flex;
    justify-content: center;
  }

  /* --- RIGHT COLUMN (RESUME) --- */
  .right-col {
    display: flex;
    flex-direction: column;
    gap: 60px;
    padding-top: 8px;
  }

  .resume-section {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .section-heading {
    font-size: 13px;
    font-weight: 800;
    text-transform: lowercase;
    color: #0d0d0d;
    margin-bottom: 8px;
  }

  .timeline-list {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 20px;
    align-items: start;
  }

  .timeline-date {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #999999;
    text-transform: uppercase;
    line-height: 1.4;
    padding-top: 2px;
  }

  .timeline-details {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .item-title {
    font-size: 13px;
    font-weight: 700;
    color: #0d0d0d;
    line-height: 1.25;
  }

  .item-subtitle {
    font-size: 12px;
    color: #666666;
    line-height: 1.3;
  }

  .item-meta {
    font-size: 11.5px;
    color: #999999;
    line-height: 1.3;
  }

  /* Responsive Adjustments */
  @media (max-width: 992px) {
    .about-container {
      grid-template-columns: 1fr;
      gap: 60px;
      padding: 40px 20px;
    }

    .manifesto-statement {
      margin-left: 0;
    }
  }

  @media (max-width: 600px) {
    .bio-grid {
      grid-template-columns: 1fr;
    }

    .photo-wrapper {
      max-width: 280px;
    }

    .timeline-item {
      grid-template-columns: 1fr;
      gap: 4px;
    }

    .timeline-date {
      margin-bottom: 2px;
    }
  }
</style>