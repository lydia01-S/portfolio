---
import Layout from '../layouts/Layout.astro';
import BackToTop from '../components/BackToTop.astro';

const email = "lydiastew01@gmail.com";
const cvHref = "/lydia_stewart_cv.pdf"; 

// Where I'm heading: the growth story. Keep it in your own words.
const growth = [
  "I've finished my studies, and now I want to learn from people who do this every day. I'm looking for a team where I can work on real client projects, get honest critique and see how experienced designers make decisions.",
  "I like feedback, because it's the fastest way I improve. On Critter & Friends, educators testing the live game showed us that our back-button idea caused accidental exits. We replaced it with a standard button in the top corner, and that taught me more than any brief."
];

// How I work: each point is backed by a project in the portfolio.
const principles = [
  { title: "Accessible from the start", text: "I check contrast and target sizes while I design, not at the end. Critter & Friends uses 48px targets and a palette checked against WCAG AA.", color: "mint" },
  { title: "Designed with the build in mind", text: "I build what I design, including this site in Astro, so I think about how a layout will work in code and what a developer needs from a handoff.", color: "yellow" },
  { title: "Details that make it usable", text: "From right-aligned numbers in a dashboard to a tick that fills in when a child finishes a task, the small decisions are where an interface feels right.", color: "lavender" }
];

// What I'm working on now. Keep only what's true, and update it as you learn.
const learning = [
  { title: "Responsive layouts", text: "Designing every screen at mobile, tablet and desktop sizes, not just the one I'll present." },
  { title: "Design systems in Figma", text: "Building components with variants and shared styles, so a whole product stays consistent." },
  { title: "Accessibility standards", text: "Going deeper into WCAG, from contrast to keyboard use and screen readers." },

  // { title: "AI in the design process", text: "Using AI to explore early ideas and check my writing, while keeping the design decisions my own." },
];

const tools = ["Figma", "Adobe Photoshop", "Adobe Illustrator",  "HTML", "CSS", "JavaScript", "Astro", "Next.js"];

const education = [
  { dates: "Sep 2025 to Aug 2026", title: "MSc in Interactive Digital Media, First Class Honours", place: "Griffith College, Dublin", note: "Final project: Critter & Friends, a game that helps children aged 5 to 8 learn about native Irish insects, co-created with Thea Rummel." }
];

// Optional: a line about life outside design. Leave empty to hide it.
const outside = ""; // e.g. "Outside of design, I [hobby], which [how it feeds into your work]."
---

<Layout title="About: Lydia Stewart" bg="#fbfaf4">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,500;0,700;1,500&family=JetBrains+Mono:wght@500;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <a class="skip" href="#main">Skip to content</a>

  <main class="about" id="main">
    <header class="hero">
      <div class="inner hero-grid">
        <div>
          <p class="chips">
            <span class="chip" style="--c: var(--yellow)">About</span>
          </p>
          <h1>I design in Figma, build in code and learn from every round of feedback.</h1>
          <p class="lead">I'm Lydia, an Interactive Digital Media graduate who loves colour, typography and building what I design. I'm ready to start my career in UI design and I want to grow quickly by working alongside people who are better than me.</p>
          <p class="actions">
            <a class="cta" href="/work">See my work</a>
            <a class="cta ghost" href={`mailto:${email}`}>Email me</a>
            <a class="cta ghost" href={cvHref} download>Download my CV <span class="sr">(PDF)</span></a>
          </p>
        </div>
        <figure class="portrait">
          <img src="/profile.jpg" alt="Portrait of Lydia Stewart" width="480" height="600" />
        </figure>
      </div>
    </header>

    <div class="inner body">
      <section class="block">
        <div class="cols">
          <h2>Where I'm heading.</h2>
          <div class="prose">{growth.map((p) => <p>{p}</p>)}</div>
        </div>
      </section>

      <section class="block">
        <div class="cols">
          <h2>How I work.</h2>
          <p class="prose">Three things I bring to every project, and where you can see them in my work.</p>
        </div>
        <div class="cards">
          {principles.map((b) => (
            <article style={`--c: var(--${b.color})`}><h3>{b.title}</h3><p>{b.text}</p></article>
          ))}
        </div>
      </section>

      <section class="block">
        <div class="cols">
          <h2>What my projects show.</h2>
          <div class="prose">
            <p>Each project in my portfolio shows a different side of how I work. <a href="/stu">STU</a> is research-led: I surveyed students about Moodle and traced every design decision back to what they told me. <a href="/pip">Pip</a> is my own idea from the character up, with a documented design system and a live app I built in code. <a href="/critterandfriends">Critter &amp; Friends</a>, my MSc final project, was designed for children aged 5 to 8 and tested with educators, which showed me how much accessibility depends on small details. <a href="/garagego">GarageGo</a> goes the other way: an admin dashboard where the challenge was making dense data quick to scan.</p>
            <p>Together they cover very different people, from young children to busy admins, and show how I shape an interface around whoever is using it.</p>
          </div>
        </div>
      </section>

      <section class="block">
        <div class="cols">
          <h2>What I'm learning now.</h2>
          <div>
            <p class="prose">I don't see graduating as the end of learning. These are the skills I'm actively building.</p>
            <ul class="learning">
              {learning.map((l) => <li><h3>{l.title}</h3><p>{l.text}</p></li>)}
            </ul>
          </div>
        </div>
      </section>

      <section class="block">
        <div class="cols">
          <h2>What I work with.</h2>
          <div>
            <p class="prose">I design in Figma and build in code, so I'm comfortable moving between the two.</p>
            <ul class="tools" aria-label="Tools and technologies">
              {tools.map((t) => <li>{t}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <section class="block">
        <div class="cols">
          <h2>Education.</h2>
          <ol class="timeline">
            {education.map((e) => (
              <li><p class="when">{e.dates}</p><div><p class="role">{e.title}</p> <p class="place">{e.place}</p><p class="note">{e.note}</p></div></li>
            ))}
          </ol>
        </div>
      </section>

      {outside && (
        <section class="block">
          <div class="cols">
            <h2>Outside of design.</h2>
            <p class="prose">{outside}</p>
          </div>
        </section>
      )}
    <{outside && (
        <section class="block">
          <div class="cols">
            <h2>Outside of design.</h2>
            <p class="prose">{outside}</p>
          </div>
        </section>
      )}
    </div>

    <BackToTop />
  </main>
</Layout>

<style>
  .about {
    --bg: #fbfaf4; --card: #fff; --ink: #1f2430; --muted: #5a6070; --border: #d3d6df;
    --deep: #3f6b52; --shadow: 0 8px 28px rgba(31, 36, 48, .08);
    --yellow: #f6e7b0; --sage: #b5d0bf; --mint: #d0e1d4; --lavender: #d3c6ea;
    --serif: 'Bodoni Moda', Georgia, serif; --mono: 'JetBrains Mono', ui-monospace, monospace;
    background: transparent; color: var(--ink); font: 16px/1.65 'Inter', system-ui, sans-serif; -webkit-font-smoothing: antialiased;
  }
  .about :focus-visible { outline: 3px solid var(--deep); outline-offset: 3px; border-radius: 6px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .skip { position: absolute; left: -999px; top: 8px; z-index: 100; background: #fff; color: var(--ink); padding: 10px 18px; border-radius: 999px; font: 600 14px 'Inter', sans-serif; }
  .skip:focus { left: 16px; }
  h1, h2, h3 { font-family: var(--serif); font-weight: 500; margin: 0; text-wrap: balance; }
  .inner { max-width: 1100px; margin: 0 auto; padding: 0 24px; }

  .chips { display: flex; gap: 8px; flex-wrap: wrap; margin: 0 0 20px; }
  .chip { font: 500 12px/1 var(--mono); background: var(--c); padding: 7px 12px; border-radius: 999px; }

  .hero { border-bottom: 1px solid var(--border); padding: 72px 0; }
  .hero-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 64px; align-items: center; }
  h1 { font-size: clamp(2.4rem, 4.8vw, 4rem); line-height: 1.1; margin-bottom: 20px; }
  .lead { font-size: 18px; color: #2d3340; max-width: 56ch; margin: 0 0 28px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin: 0; }
  .cta { display: inline-flex; align-items: center; min-height: 48px; padding: 0 26px; background: var(--ink); color: #fff; font-weight: 600; text-decoration: none; border-radius: 999px; border: 1px solid var(--ink); transition: background .2s, transform .2s; }
  .cta:hover { background: var(--deep); border-color: var(--deep); transform: translateY(-2px); }
  .cta.ghost { background: var(--card); color: var(--ink); border-color: var(--border); }
  .cta.ghost:hover { background: var(--mint); border-color: var(--ink); }

  .portrait { margin: 0; padding: 14px; background: linear-gradient(var(--mint), var(--sage)); border-radius: 24px; box-shadow: var(--shadow); }
  .portrait img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 14px; background: var(--card); }

  .body { padding-top: 80px; padding-bottom: 48px; }
  .block { margin-bottom: 96px; }
  .block:last-child { margin-bottom: 0; }
  .cols { display: grid; grid-template-columns: 42% 58%; gap: 40px; align-items: start; }
  h2 { font-size: clamp(1.6rem, 2.4vw, 2.2rem); line-height: 1.25; }
  .prose { color: #333a48; max-width: 62ch; margin: 0; }
  .prose p { margin: 0 0 14px; }
  .prose p:last-child { margin-bottom: 0; }
  .prose a { color: var(--ink); font-weight: 600; text-underline-offset: 3px; }
  .prose a:hover { color: var(--deep); }

  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 40px; }
  .cards article { background: var(--card); border: 1px solid var(--border); border-top: 6px solid var(--c); border-radius: 16px; padding: 22px; box-shadow: var(--shadow); }
  .cards h3 { font-size: 1.2rem; margin-bottom: 8px; }
  .cards p { margin: 0; font-size: 15px; color: #333a48; }

  .learning { list-style: none; margin: 24px 0 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0 32px; }
  .learning li { padding: 16px 0; border-top: 1px solid var(--border); }
  .learning h3 { font-size: 1.1rem; margin-bottom: 4px; }
  .learning p { margin: 0; font-size: 15px; color: #333a48; }

  .tools { display: flex; flex-wrap: wrap; gap: 10px; list-style: none; margin: 20px 0 0; padding: 0; }
  .tools li { font: 500 13px var(--mono); background: var(--card); border: 1px solid var(--border); border-radius: 999px; padding: 8px 14px; }

  .timeline { list-style: none; margin: 0; padding: 0; }
  .timeline li { display: grid; grid-template-columns: 150px 1fr; gap: 20px; padding: 18px 0; border-top: 1px solid var(--border); }
  .timeline p { margin: 0; }
  .when { font: 500 12px/1.5 var(--mono); color: var(--muted); }
  .role { font-weight: 600; }
  .place { color: #333a48; }
  .note { font-size: 14px; color: var(--muted); margin-top: 4px !important; }

  @media (max-width: 960px) {
    .hero-grid, .cols, .cards { grid-template-columns: 1fr; gap: 24px; }
    .hero { padding: 48px 0; }
    .portrait { max-width: 360px; }
    .body { padding-top: 56px; }
    .block { margin-bottom: 64px; }
  }
  @media (max-width: 600px) {
    .learning { grid-template-columns: 1fr; }
    .timeline li { grid-template-columns: 1fr; gap: 4px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cta { transition: none; }
    .cta:hover { transform: none; }
  }
</style>