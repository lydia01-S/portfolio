---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/hero.astro';
import ProjectCard from '../components/projectcard.astro';

const projects = [
  {
    slug: "/stu",               // Leads to src/pages/stu.astro
    title: "STU: An online student platform",
    category: "UX/UI prototype",
    year: "2025",
    imageSrc: "/3.png"
  },
  {
    slug: "/critterandfriends", // Leads to src/pages/critterandfriends.astro
    title: "Critter & Friends': An interactive game",
    category: "Web Design, UX/UI",
    year: "2026",
    imageSrc: "/critterandfriends.png"
  }
];
---

<Layout title="Lydia Stewart — Portfolio">
  <!-- Full Screen Hero Fold -->
  <section class="hero-wrapper">
    <Hero year="2026" />
    
    <!-- Scroll Down Indicator -->
    <a href="#intro" class="scroll-indicator">
      <span>SCROLL TO EXPLORE</span>
      <div class="line"></div>
    </a>
  </section>

  <!-- Short Introduction Section -->
  <section id="intro" class="intro-section reveal-on-scroll">
    <div class="intro-content">
  
      <h2 class="intro-heading">
        Hi, I'm Lydia — an Interactive Digital Media graduate passionate about web development and UI/UX design. 
      </h2>
    </div>
  </section>

  <!-- Selected Work Section -->
  <section id="work" class="work-section reveal-on-scroll">
    <div class="section-header">
      <h2 class="section-title">Selected Work</h2>
      <span class="project-count">( 02 )</span>
    </div>

    <p class="section-description">
      A curated collection of branding, digital art direction and designs.
    </p>
    
    <!-- Staggered 2-Column Projects Grid -->
    <div class="projects-grid">
  {projects.map((project, index) => (
    <div class={`grid-col ${index % 2 === 1 ? 'right-col' : 'left-col'}`}>
      <a href={project.slug} class="card-link">
        <ProjectCard 
          slug={project.slug}
          title={project.title}
          category={project.category}
          year={project.year}
          imageSrc={project.imageSrc}
        />
      </a>
    </div>
  ))}
</div>
  </section>
</Layout>

<script>
  // Scroll reveal trigger using IntersectionObserver
  const observerCallback: IntersectionObserverCallback = (entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  };

  const observer = new IntersectionObserver(observerCallback, {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  });

  document.querySelectorAll('.reveal-on-scroll').forEach((el) => observer.observe(el));
</script>

<style>
  html {
    scroll-behavior: smooth;
  }

  .hero-wrapper {
    min-height: 85vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
  }

  .scroll-indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    font-size: 10px;
    letter-spacing: 0.12em;
    color: #888;
    padding-bottom: 20px;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .scroll-indicator:hover {
    color: #0c0c0c;
  }

  .scroll-indicator .line {
    width: 1px;
    height: 24px;
    background-color: currentColor;
    animation: pulse 2s infinite ease-in-out;
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.3; transform: scaleY(0.8); }
    50% { opacity: 1; transform: scaleY(1.2); }
  }

  /* --- Scroll Reveal Base Animations --- */
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1), 
                transform 1s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  .reveal-on-scroll.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* --- Introduction Section Styles --- */
  .intro-section {
    padding: 120px 0 60px;
    max-width: 1100px;
    margin: 0 auto;
    width: 100%;
  }

  .intro-content {
    max-width: 800px;
  }

  .section-label {
    display: block;
    font-size: 11px;
    letter-spacing: 0.15em;
    color: #888;
    margin-bottom: 24px;
  }

  .intro-heading {
    font-family: 'Bodoni Moda', 'Playfair Display', serif;
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    font-weight: 400;
    line-height: 1.3;
    color: #111;
    margin-bottom: 24px;
  }

  .intro-text {
    font-size: 16px;
    line-height: 1.7;
    color: #555;
    max-width: 600px;
  }

  /* --- Work Section Styles --- */
  .work-section {
    padding: 60px 0 80px;
    max-width: 1100px;
    margin: 0 auto;
    width: 100%;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px solid #e5e5e5;
    padding-bottom: 16px;
    margin-bottom: 20px;
  }

  .section-title {
    font-family: 'Bodoni Moda', 'Playfair Display', serif;
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 400;
  }

  .project-count {
    font-size: 12px;
    letter-spacing: 0.1em;
    color: #666;
  }

  .section-description {
    font-size: 15px;
    line-height: 1.6;
    color: #555;
    max-width: 540px;
    margin-bottom: 60px;
  }

  /* 2-Column Staggered Grid Layout */
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
  }

  .right-col {
    margin-top: 90px;
  }

  @media (max-width: 768px) {
    .intro-section {
      padding: 80px 0 40px;
    }

    .projects-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .right-col {
      margin-top: 0;
    }
  }
</style>