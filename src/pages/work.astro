---
import Layout from '../layouts/Layout.astro';

// Array of portfolio project cards
const projects = [
  {
    title: "STU: Online Student Platform",
    category: "UX/UI Case Study",
    year: "2025",
    description: "An integrated platform helping students organize coursework, manage schedules, and track deadlines seamlessly.",
    imageSrc: "/3.png",
    slug: "/stu",
    tags: ["Research", "Figma", "Usability Testing"]
  },
  {
    title: "Critter & Friends",
    category: "Web Design & Game Design",
    year: "2026",
    description: "An interactive, browser-based web application with playful micro-interactions and custom illustrations.",
    imageSrc: "/critterandfriends.png",
    slug: "/critterandfriends",
    tags: ["Web Dev", "UI/UX", "Illustration"]
  },
  {
    title: "UX Research & Strategy",
    category: "Design System & Strategy",
    year: "2026",
    description: "A comprehensive exploration of user personas, affinity mapping, wireframes, and design components.",
    imageSrc: "",
    slug: "",
    tags: ["User Flow", "Personas", "IA"]
  }
];
---

<Layout title="Selected Work — Lydia Stewart">
  <main class="work-page">
    
    <!-- Page Title & Header -->
    <header class="work-header reveal-on-scroll">
      <h1 class="page-title">SELECTED<br />WORK</h1>
    </header>

    <!-- Editorial Horizontal List Layout -->
    <section class="work-list-container reveal-on-scroll">
      <div class="projects-list">
        {projects.map((project) => (
          <a href={project.slug} class="project-row-link">
            <article class="project-row">
              
              <!-- Left Column: Title & Subtitle -->
              <div class="project-info">
                <h2 class="project-title">
                  {project.title}
                  <span class="arrow-icon">↗</span>
                </h2>
                <span class="project-category">{project.category}</span>
              </div>

              <!-- Right Column: Thumbnail & Metadata -->
              <div class="project-media">
                {project.imageSrc && (
                  <div class="thumbnail-wrapper">
                    <img src={project.imageSrc} alt={project.title} class="thumbnail-img" />
                  </div>
                )}
                <span class="project-date">{project.year}</span>
              </div>

            </article>
          </a>
        ))}
      </div>
    </section>

  </main>
</Layout>

<script>
  // Scroll reveal animation observer
  function initScrollReveal() {
    const observerCallback: IntersectionObserverCallback = (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    };

    const observer = new IntersectionObserver(observerCallback, {
      threshold: 0.05,
      rootMargin: '0px 0px -20px 0px'
    });

    document.querySelectorAll('.reveal-on-scroll').forEach((el) => observer.observe(el));
  }

  document.addEventListener('DOMContentLoaded', initScrollReveal);
  document.addEventListener('astro:page-load', initScrollReveal);
</script>

<style>
  html {
    scroll-behavior: smooth;
  }

  /* --- Scroll Reveal Base Animations --- */
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), 
                transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  .reveal-on-scroll.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* --- Page Layout Background --- */
  .work-page {
    background-color: #f6f5f1;
    min-height: 100vh;
    padding: 80px 40px 120px;
   font-family: 'Bodoni Moda', 'Playfair Display', serif;
    color: #0c0c0c;
  }

  /* --- Header Styles --- */
  .work-header {
    max-width: 1000px;
    margin: 0 auto 40px auto;
  }

  .page-title {
    font-family: 'Bodoni Moda', 'Playfair Display', serif;
    font-size: clamp(3.5rem, 8.5vw, 6.5rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: #0d0d0d;
    text-transform: uppercase;
    margin: 0;
  }

  /* --- Editorial List Layout --- */
  .work-list-container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .projects-list {
    border-top: 1.5px solid #0d0d0d;
    display: flex;
    flex-direction: column;
  }

  .project-row-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .project-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 36px 0;
    border-bottom: 1px solid #dcdad4;
    transition: border-color 0.2s ease;
  }

  .project-row-link:hover .project-row {
    border-bottom-color: #0d0d0d;
  }

  /* Left Column Info */
  .project-info {
    max-width: 480px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .project-title {
   font-family: 'Bodoni Moda', 'Playfair Display', serif;
    font-size: clamp(1.4rem, 2.5vw, 2.1rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: #0d0d0d;
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .arrow-icon {
    font-size: 0.85em;
    font-weight: 400;
    display: inline-block;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-row-link:hover .arrow-icon {
    transform: translate(4px, -4px);
  }

  .project-category {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: #777777;
    text-transform: uppercase;
  }

  /* Right Column Media */
  .project-media {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  /* Scaled up thumbnail container */
  .thumbnail-wrapper {
    width: 300px;  /* Increased from 110px */
    height:235px; /* Increased from 80px */
    background-color: #e5e3db;
    overflow: hidden;
    border-radius: 4px;
  }

  /* Kept full original color by default */
  .thumbnail-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .project-row-link:hover .thumbnail-img {
    transform: scale(1.05);
  }

  .project-date {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #888888;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .work-page {
      padding: 60px 20px 80px;
    }

    .project-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      padding: 28px 0;
    }

    .project-media {
      width: 100%;
      justify-content: space-between;
    }

    .thumbnail-wrapper {
      width: 140px;
      height: 95px;
    }
  }
</style>