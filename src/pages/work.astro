---
import Layout from '../layouts/Layout.astro';
import BackToTop from '../components/BackToTop.astro';

interface Project {
  title: string;
  category: string;
  year: string;
  description: string;
  imageSrc: string;
  slug: string;
  tags: string[];
  fit?: 'cover' | 'contain';   // cover fills the box and crops; contain shows the whole image
  position?: string;           // which part of the image stays in view, e.g. 'left top'
  bg?: string;                 // background colour behind a contained image
}

const projects: Project[] = [
  {
    title: "STU: Online Student Platform",
    category: "UX/UI Case Study",
    year: "2025",
    description: "A research-led student app that puts deadlines, the timetable and coursework in one place.",
    imageSrc: "/3.png",
    slug: "/stu",
    tags: ["Research", "Survey", "Figma"]
  },
  {
    title: "Pip: A Wellbeing Companion",
    category: "UX/UI Case Study",
    year: "2026",
    description: "A character-led wellbeing app, with its own design system and a live build in code.",
    imageSrc: "/pip_drag_animation_storyboard.png",
    slug: "/pip",
    tags: ["UX/UI", "Design System", "Figma", "Code"],
    fit: "contain",
    bg: "#d6e7e1"
  },
  {
    title: "GarageGo: Admin Portal",
    category: "UI Design",
    year: "2026",
    description: "An admin dashboard designed so that dense data is quick to scan and hard to misread.",
    imageSrc: "/garagego/dashboard.png",
    slug: "/garagego",
    tags: ["UI Design", "Data Display", "Figma"],
    position: "left top"
  },
  {
    title: "Critter & Friends",
    category: "Web Design, UX/UI",
    year: "2026",
    description: "A web game about native Irish insects for children aged 5 to 8, tested with educators.",
    imageSrc: "/critterandfriends.png",
    slug: "/critterandfriends",
    tags: ["UX/UI", "Illustration", "Usability Testing", "Code"]
  }
];
---

<Layout title="Selected Work — Lydia Stewart">
  <main class="work-page">
    
    <!-- Page Title & Header -->
    <header class="work-header reveal-on-scroll">
      <p class="header-label">Portfolio & Case Studies</p>
      <h1 class="page-title">SELECTED<br />WORK</h1>
    </header>

    <!-- Editorial Horizontal List Layout -->
    <section class="work-list-container reveal-on-scroll">
      <div class="projects-list">
        {projects.map((project) => {
          const isInteractive = Boolean(project.slug);
          const Element = isInteractive ? 'a' : 'div';
          
          return (
            <Element 
              href={isInteractive ? project.slug : undefined} 
              class={`project-row-link ${!isInteractive ? 'is-disabled' : ''}`}
            >
              <article class="project-row">
                
                <!-- Left Column: Title, Description, Tags -->
                <div class="project-info">
                  <div class="meta-header">
                    <span class="project-category">{project.category}</span>
                    <span class="project-date">{project.year}</span>
                  </div>

                  <h2 class="project-title">
                    {project.title}
                    {isInteractive ? (
                      <span class="arrow-icon" aria-hidden="true">↗</span>
                    ) : (
                      <span class="badge-draft">In Progress</span>
                    )}
                  </h2>

                  <p class="project-description">{project.description}</p>

                  <ul class="project-tags" aria-label="Project Tags">
                    {project.tags.map((tag) => (
                      <li class="tag-item">{tag}</li>
                    ))}
                  </ul>
                </div>

                <!-- Right Column: Thumbnail -->
                <div class="project-media">
                  {project.imageSrc ? (
                    <div class="thumbnail-wrapper" style={project.bg ? `background:${project.bg}` : undefined}>
                      <img
                        src={project.imageSrc}
                        alt={`Preview of ${project.title}`}
                        class={`thumbnail-img ${project.fit === 'contain' ? 'is-contain' : ''}`}
                        style={`object-fit:${project.fit ?? 'cover'};object-position:${project.position ?? 'center'}`}
                      />
                    </div>
                  ) : (
                    <div class="thumbnail-wrapper thumbnail-placeholder">
                      <span>Case Study Coming Soon</span>
                    </div>
                  )}
                </div>

              </article>
            </Element>
          );
        })}
      </div>
    </section>

       

    <BackToTop />
  </main>
</Layout>

<script>
  function initScrollReveal() {
    const observerCallback: IntersectionObserverCallback = (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    };

    const observer = new IntersectionObserver(observerCallback, {
      threshold: 0.05,
      rootMargin: '0px 0px -20px 0px'
    });

    document.querySelectorAll('.reveal-on-scroll').forEach((el) => observer.observe(el));
  }

  document.addEventListener('DOMContentLoaded', initScrollReveal);
  document.addEventListener('astro:page-load', initScrollReveal);

  
</script>



<style>
  @import url('https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,700;0,900;1,400&family=Inter:wght@400;500;600;700&display=swap');

  html {
    scroll-behavior: smooth;
  }

  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), 
                transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  .reveal-on-scroll.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .work-page {
    background-color: #fcfcee;
    min-height: 100vh;
    padding: 80px 40px 120px;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    color: #0c0c0c;
  }

  .work-header {
    max-width: 1000px;
    margin: 0 auto 48px auto;
  }

  .header-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #555555;
    margin-bottom: 12px;
  }

  .page-title {
    font-family: 'Bodoni Moda', 'Playfair Display', serif;
    font-size: clamp(3.5rem, 8.5vw, 6.5rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: #0d0d0d;
    text-transform: uppercase;
    margin: 0;
  }

  .work-list-container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .projects-list {
    border-top: 1.5px solid #0d0d0d;
    display: flex;
    flex-direction: column;
  }

  .project-row-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .project-row-link.is-disabled {
    cursor: default;
    opacity: 0.75;
  }

  .project-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 40px 0;
    border-bottom: 1px solid #dcdad4;
    transition: border-color 0.2s ease;
    gap: 32px;
  }

  .project-row-link:not(.is-disabled):hover .project-row {
    border-bottom-color: #0d0d0d;
  }

  .project-info {
    max-width: 520px;
    display: flex;
    flex-direction: column;
  }

  .meta-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
  }

  .project-category {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #444444; /* Improved AA contrast */
    text-transform: uppercase;
  }

  .project-date {
    font-size: 11px;
    font-weight: 600;
    color: #666666;
  }

  .project-title {
    font-family: 'Bodoni Moda', 'Playfair Display', serif;
    font-size: clamp(1.5rem, 2.8vw, 2.2rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: #0d0d0d;
    margin: 0 0 12px 0;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .arrow-icon {
    font-size: 0.8em;
    font-weight: 400;
    display: inline-block;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-row-link:hover .arrow-icon {
    transform: translate(4px, -4px);
  }

  .badge-draft {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    padding: 3px 8px;
    background-color: #fcfcee;
    color: #555555;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .project-description {
    font-size: 14px;
    line-height: 1.55;
    color: #333333;
    margin: 0 0 16px 0;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .tag-item {
    font-size: 11px;
    font-weight: 500;
    color: #444444;
    background: rgba(0, 0, 0, 0.04);
    padding: 4px 10px;
    border-radius: 100px;
  }

  .project-media {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .thumbnail-wrapper {
    width: 280px;
    height: 180px;
    background-color: #fcfcee;
    overflow: hidden;
    border-radius: 4px;
    position: relative;
  }

  .thumbnail-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    text-align: center;
    font-size: 12px;
    font-weight: 500;
    color: #666666;
    border: 1px dashed #c2c0b6;
  }

  .thumbnail-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  /* A contained image gets breathing room so it doesn't touch the edges */
  .thumbnail-img.is-contain {
    padding: 14px;
    box-sizing: border-box;
  }

  .project-row-link:not(.is-disabled):hover .thumbnail-img {
    transform: scale(1.05);
  }

  @media (max-width: 768px) {
    .work-page {
      padding: 60px 20px 80px;
    }

    .project-row {
      flex-direction: column-reverse;
      align-items: stretch;
      gap: 20px;
      padding: 32px 0;
    }

    .thumbnail-wrapper {
      width: 100%;
      height: 200px;
    }
  }

   @media (max-width: 768px) {
    .work-page { padding: 32px 0 64px; }
    .page-title { font-size: clamp(2.6rem, 14vw, 3.5rem); }
    .project-title { display: block; }
    .arrow-icon { margin-left: 6px; }
  }
</style>