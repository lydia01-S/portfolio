---
import Layout from '../layouts/Layout.astro';
import BackToTop from '/src/components/BackToTop.astro';
import CritterTabs from '../components/CritterTabs.astro';

// Built from the Critter & Friends project documentation. Sections with an empty array are hidden.
// Keep page.role consistent with the Role on the overview page.
const page = {
  title: "Critter & Friends: UX research",
  lead: "We wanted to know how to make native Irish insects feel like friends to primary school children, without turning learning into homework. We researched the science and the children, then tested the live site with educators.",
  role: "Co-created with Thea Rummel for an MSc in Interactive Digital Media at Griffith College. Thea hand-drew the illustrations and UI elements. I worked on the research, and we co-coded the site. We planned the interface together: where each element sits, how it looks and how many buttons a child has to press."
};

const summary = {
  question: "How can a web experience make native Irish insects feel like friends to primary school children, and keep learning playful?",
  did: "A literature review, a competitor audit, a museum visit to photograph specimens with the curator of entomology, two personas, and usability feedback from primary school educators.",
  findings: [
    "Children are motivated by curiosity and choice, so the site has a calm collection loop with no timers or leaderboards.",
    "Catching threatened insects sent the wrong message, so the story changed to delivering birthday party invitations to them.",
    "Educator testing found real problems: the tutorial froze if you clicked Continue early, buzzing insects looked like glitches, and saved progress didn't match the screen after a restart."
  ],
  changed: "The story became hospitality instead of capture, back navigation moved to a standard top corner button, the Pokédex became a collapsible drawer, and testing produced a fix list for the tutorial, saved state and mobile."
};

const goals = [
  { question: "How do people see insects, and how could a website change that?", informs: "The tone: friends, not specimens, with personified characters." },
  { question: "Which native species and habitats should the site show, and why?", informs: "The species roster and the habitats they live in." },
  { question: "What motivates children in digital learning, and what do different ages need?", informs: "The mechanics, and the interface rules: large targets, short text, no nested menus." },
  { question: "What do existing tools get wrong?", informs: "The position: accurate local science, with play." },
  { question: "Does the live site work for real users?", informs: "Fixes to the tutorial, navigation, saved state and mobile." }
];

// To add informal family and friends testing back, add a row here with the real number of people and what they found,
// and mention it in summary.did, methodNote and limits.
const methods = [
  { method: "Literature review", who: "National Biodiversity Data Centre, NPWS Red Lists, the All-Ireland Pollinator Plan, and research on children, gamification and play", n: "Published sources", when: "During the project", why: "To ground the species, habitats and mechanics in evidence." },
  { method: "Competitor audit and similar work", who: "Scientific databases, educational games, field-guide apps and WebGL nature experiences", n: "4 types of tool", when: "During the project", why: "To find the gap Critter & Friends could fill." },
  { method: "Museum consultation", who: "Dr Aidan O'Hanlon, Curator of Entomology, National Museum of Ireland (Natural History)", n: "1 curator, 1 visit", when: "2026", why: "To photograph real specimens and check which species matter." },
  { method: "Educator testing", who: "Primary school educators at the International School Westpfalz, Germany", n: "Educators at one school", when: "2026", why: "To see how the live site works for people who know how children use screens." }
];
const methodNote = "Limits: we haven't tested with children yet. Educator feedback came as written messages from a small group.";

const personas = [
  { name: "Ciara, 8", role: "Primary learner", bg: "Enjoys tablet games, visual storytelling and collecting digital rewards.", pain: "Gets bored by text-heavy educational sites and frustrated by multi-level menus or slow feedback.", need: "Big targets, hand-drawn visuals, narration and an encouraging collection loop." },
  { name: "Liam, 27", role: "Design enthusiast and educator", bg: "A primary school teacher and creative front-end developer interested in environmental education.", pain: "Tired of outdated e-learning sites with stock photos and flat layouts.", need: "Polished 3D interaction, bespoke illustration and scientifically accurate content." }
];
const personaNote = "The personas are working models drawn from the research above.";

const competitors = [
  { name: "Scientific databases", how: "Accurate records of species, such as the National Biodiversity Data Centre portal.", gap: "The text-heavy layout and formal tone are too dry to keep children engaged.", differs: "Real Irish data, turned into character profiles and trading cards.", refs: [{ label: "Biodiversity Ireland", href: "https://biodiversityireland.ie/" }] },
  { name: "Educational games", how: "Cartoon animals from around the world, with timers and high-score leaderboards.", gap: "They reward quick points over understanding local nature.", differs: "A calm collection loop with no timers or scores, using local species.", refs: [] },
  { name: "Field-guide apps", how: "Species lists with photographs and dense text, such as the Natural History Museum's identification tools.", gap: "Static photos and long text feel dry to younger audiences.", differs: "Each species is an illustrated character in a scene you explore.", refs: [{ label: "Natural History Museum", href: "https://www.nhm.ac.uk/discover.html" }] },
  { name: "Gamified and 3D nature experiences", how: "Playful apps like Toca Life, and WebGL nature experiences with beautiful 3D.", gap: "Often generic or imaginary bugs with no ecological context, and rarely local or child-friendly.", differs: "Accurate Irish ecology in custom 3D habitats, with personality-driven characters.", refs: [] }
];
const competitorNote = "Drawn from the literature review and similar-work research in the project documentation.";

const findings = [
  { evidence: "Our early plan was about collecting threatened species. Research on children and nature suggested that hunting or capturing endangered insects can teach ownership instead of respect.", insight: "The mechanic contradicted the message.", implication: "We rebuilt the story: the player delivers birthday party invitations to insect neighbours. Conservation actions became rewards inside the card bios and the finale." },
  { evidence: "Self-determination theory says motivation grows with autonomy, competence and relatedness. Points and leaderboards tend to produce short-term compliance.", insight: "Exploring, collecting and caring about characters suits children better than scores.", implication: "A self-guided exploration loop, trading cards and a progress counter, with no timers or leaderboards." },
  { evidence: "Guidance on children aged 3 to 12 says younger children rely on simple touch gestures and spatial metaphors, and that nested menus disorient them.", insight: "Different ages need different levels of interaction.", implication: "Full-screen spatial scenes, large targets, a 14pt minimum text size, scannable chunks, no scrolling or multi-level menus, and optional narration." },
  { evidence: "Talking to the curator and photographing specimens pushed us towards ecologically important natives. The Hairy Wood Ant was added because of its vulnerable status in declining woodland.", insight: "Primary research changed the species list, not just the look.", implication: "The plan shrank from ten generic bugs to nine native Irish species, drawn with recognisable anatomy and softened features." }
];
const artefacts = [
  { src: "/critter/critter-specimens.jpg", alt: "The authors photographing preserved insect specimens at the museum, with two specimen photographs: a grasshopper and a diving beetle", caption: "Photographing specimens at the National Museum of Ireland." },
  { src: "/critter/critter-concept-beetle.png", alt: "A line drawing of a diving beetle, an early character concept", caption: "An early concept sketch of the Great Diving Beetle." }
];

// wide: true gives a decision the full width, with the image above the text. Use it for long, thin images.
const decisions = [
  { finding: "Hunting threatened insects risked teaching ownership, not respect.", decision: "A birthday party story. You deliver invitations to insect neighbours, and the party scene is the finale.", img: "/critter/critter-party.jpg", alt: "The birthday party finale: the entomologist and insect guests around a table with a Happy Birthday banner" },
  { finding: "Children need calm, immediate feedback, and no competitive pressure.", decision: "A trading card collection in a collapsible Pokédex drawer, and a progress counter in the corner.", img: "/critter/critter-cards-menu.png", alt: "The trading card drawer showing three unlocked insect cards" },
  { finding: "Nested menus disorient young users, and targets must be large.", decision: "Full-screen scenes with edge-anchored controls: back at top left, information and audio at top right, the counter at bottom right.", img: "/critter/critter-woodland.jpg", alt: "The hand-drawn woodland scene with the back button, information button and a progress counter" },
  { finding: "Real specimens showed what makes each insect recognisable.", decision: "Insects keep realistic anatomy, and every card pairs real facts with a character.", img: "/critter/critter-cards.png", alt: "All nine insect trading cards in a row", wide: true }
];

const flowTitle = "From sitemap, to first concept, to finished scene.";
// fit: "contain" shows the whole image on white instead of cropping it. Use it for diagrams.
const flow = [
  { stage: "Sitemap", fit: "contain", note: "A linear main route (Home, Marsh, Garden, House, Finale) with smaller scenes inside each, and a shared Information hub.", img: "/critter/critter-sitemap.png", alt: "Sitemap: Home, Marsh, Garden, House and Finale in a column, with Pond, Anthill, River, Bush, Sink and Fruitbowl branching off and an Information hub leading to About and Scientific Background" },
  { stage: "First colour concept", note: "An early draft of the colours and style, before the palette was simplified.", img: "/critter/critter-concept-colour.jpg", alt: "An early colour concept of a cottage garden with a pond" },
  { stage: "Finished scene", note: "The woodland scene as it ships, with hand-drawn shapes and a consistent line.", img: "/critter/critter-woodland.jpg", alt: "The finished woodland scene" }
];

// "Next fix" means the fix is still to do. Change it to what you changed once you've done it.
const testing = [
  { tested: "The tutorial, with educators.", problem: "Clicking Continue before clicking the ladybug froze the tutorial: “If I clicked ‘continue’ before clicking on the ladybug, it’s frozen and I had to restart.”", change: "Make the tutorial work in any click order, and add a back button to dialogue boxes." },
  { tested: "The micro-animations on clickable insects.", problem: "“Not sure if the lady bug is supposed to be ‘buzzing’ on this screen or it’s a glitch.” Motion meant to feel lively read as an error.", change: "Tune the animation so it signals clickable without looking broken." },
  { tested: "Saved progress after a restart.", problem: "The ladybug no longer appeared because the page relied on the cache, and the progress boxes didn't show checkmarks for insects already collected.", change: "Add a reset, and draw the counter from the saved state." },
  { tested: "Mobile and next-step guidance.", problem: "“I can’t click on anything else, so I wasn’t sure if I’m supposed to do next.” Clicks didn't respond on mobile viewports.", change: "Tighten click targets on mobile and add clearer next-step prompts after the tutorial." },
  { tested: "An early back-button idea: dragging the cursor to the bottom of the screen.", problem: "It caused accidental exits, especially when younger users clicked low targets.", change: "Done: a standard back button in the top corner, with custom vector styling." },
  { tested: "The hand-drawn style, with educators.", problem: "No problem. “The illustrations are super cute though. I love it.”", change: "Keep the single-brush illustration style across new scenes." }
];

// Save your phone screenshot as public/critter/critter-mobile.png (or change src), then describe what it shows in alt.
const mobileShot = {
  src: "/critter/critter-mobile.jpg",
  alt: "Critter & Friends on a phone: [describe the scene and controls visible]",
  caption: "The game on a phone, with the same edge-anchored controls as on desktop."
};

const a11y = [
  { check: "Narration", method: "Design review", result: "A text-to-speech toggle and paragraph-by-paragraph text reveals are built in." },
  { check: "Text size and layout", method: "Design rules", result: "A 14pt minimum, short chunks of text, large targets, and no scrolling or nested menus." },
  { check: "Keyboard navigation", method: "Reflection after testing", result: "Not in the first build. It is the first accessibility fix." },
  { check: "Visible focus indicators", method: "Reflection after testing", result: "Missing on buttons and controls, so they need adding." },
  { check: "Support for visually impaired users", method: "Reflection after testing", result: "Not fully accessible yet. Audio cues on hover, using real insect sounds, are planned." }
];

const limits = [
  "We haven't tested with children. Educators are a stand-in, and they gave feedback by message.",
  "The testing sample was small and came from one school.",
  "We didn't run a structured interview with the entomologist about how to talk to children about conservation.",
  "Keyboard control and focus indicators weren't in the first build, so it isn't fully accessible."
];
const next = [
  "Run structured usability testing with primary school children in a classroom.",
  "Fix the tutorial freeze, add a back button in dialogue, and add a reset for saved progress.",
  "Add keyboard controls, focus indicators and audio cues on hover.",
  "Add a short quiz after each biome, and real insect sounds when you click a creature."
];

const sections = [
  { id: "summary", label: "Summary", show: true },
  { id: "goals", label: "Goals", show: goals.length > 0 },
  { id: "methods", label: "Methods", show: methods.length > 0 },
  { id: "personas", label: "Personas", show: personas.length > 0 },
  { id: "competitors", label: "Competitor audit", show: competitors.length > 0 },
  { id: "findings", label: "Findings", show: findings.length > 0 },
  { id: "decisions", label: "Decisions", show: decisions.length > 0 },
  { id: "flow", label: "Structure to interface", show: flow.length > 0 },
  { id: "testing", label: "Testing", show: testing.length > 0 },
  { id: "accessibility", label: "Accessibility", show: a11y.length > 0 },
  { id: "next", label: "Limits and next steps", show: limits.length + next.length > 0 }
].filter((s) => s.show);

// Reading time, counted from all the text on the page at about 200 words a minute.
const allText = [
  page.lead, page.role, summary.question, summary.did, ...summary.findings, summary.changed,
  ...goals.flatMap((g) => [g.question, g.informs]),
  ...methods.flatMap((m) => [m.method, m.who, m.why]), methodNote,
  ...personas.flatMap((p) => [p.bg, p.pain, p.need]), personaNote,
  ...competitors.flatMap((c) => [c.how, c.gap, c.differs]), competitorNote,
  ...findings.flatMap((f) => [f.evidence, f.insight, f.implication]),
  ...decisions.flatMap((d) => [d.finding, d.decision]),
  ...flow.map((f) => f.note),
  ...testing.flatMap((t) => [t.tested, t.problem, t.change]),
  ...a11y.map((a) => a.result),
  ...limits, ...next
].join(' ');
const readTime = Math.max(1, Math.ceil(allText.split(/\s+/).length / 200));
---

<Layout title={page.title} bg="#fbfaf4">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,500;0,700;1,500&family=JetBrains+Mono:wght@500;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <a class="skip" href="#content">Skip to research</a>

  <main class="rs">
    <header class="hero">
      <div class="inner">
        <CritterTabs current="research" />
        <p class="chips">
          <span class="chip" style="--c: var(--yellow)">UX research</span>
          <span class="chip" style="--c: var(--mint)">{readTime} min read</span>
        </p>
        <h1>{page.title}</h1>
        <p class="lead">{page.lead}</p>
        <p class="role"><span>My role</span> {page.role}</p>
      </div>
    </header>

    <div class="layout">
      <aside class="toc-wrap">
        <nav class="toc" aria-label="On this page">
          <p class="toc-title">On this page</p>
          {sections.map((s) => <a href={`#${s.id}`}>{s.label}</a>)}
        </nav>
      </aside>

      <div class="content" id="content">
        <section id="summary">
          <span class="chip" style="--c: var(--sage)">Summary</span>
          <dl class="summary">
            <div><dt>The question</dt><dd>{summary.question}</dd></div>
            <div><dt>What we did</dt><dd>{summary.did}</dd></div>
            <div><dt>What we found</dt><dd><ul class="bullets">{summary.findings.map((f) => <li>{f}</li>)}</ul></dd></div>
            <div><dt>What changed</dt><dd>{summary.changed}</dd></div>
          </dl>
        </section>

        {goals.length > 0 && (
          <section id="goals">
            <span class="chip" style="--c: var(--mint)">Goals</span>
            <h2>What we needed to find out, and what each answer would decide.</h2>
            <ul class="rows">
              {goals.map((g) => <li><p class="q">{g.question}</p><p class="informs"><strong>Informs:</strong> {g.informs}</p></li>)}
            </ul>
          </section>
        )}

        {methods.length > 0 && (
          <section id="methods">
            <span class="chip" style="--c: var(--lavender)">Methods</span>
            <h2>How we gathered evidence, and from whom.</h2>
            <div class="scroll" role="region" aria-label="Research methods table" tabindex="0">
              <table>
                <caption class="sr">Research methods</caption>
                <thead><tr><th scope="col">Method</th><th scope="col">Who</th><th scope="col">How many</th><th scope="col">When</th><th scope="col">Why</th></tr></thead>
                <tbody>{methods.map((m) => <tr><th scope="row">{m.method}</th><td>{m.who}</td><td>{m.n}</td><td>{m.when}</td><td>{m.why}</td></tr>)}</tbody>
              </table>
            </div>
            {methodNote && <p class="note">{methodNote}</p>}
          </section>
        )}

        {personas.length > 0 && (
          <section id="personas">
            <span class="chip" style="--c: var(--amber)">Personas</span>
            <h2>Two people we designed for.</h2>
            <div class="cards">
              {personas.map((p) => (
                <article>
                  <h3>{p.name}</h3><p class="role2">{p.role}</p>
                  <p class="label">Background</p><p>{p.bg}</p>
                  <p class="label">Pain points</p><p>{p.pain}</p>
                  <p class="label">Needs</p><p>{p.need}</p>
                </article>
              ))}
            </div>
            {personaNote && <p class="note">{personaNote}</p>}
          </section>
        )}

        {competitors.length > 0 && (
          <section id="competitors">
            <span class="chip" style="--c: var(--lavender)">Competitor audit</span>
            <h2>Four kinds of tool, and the gap between them.</h2>
            <div class="cards comp">
              {competitors.map((c) => (
                <article>
                  <h3>{c.name}</h3>
                  <p class="label">How it works</p><p>{c.how}</p>
                  <p class="label">Where it falls short</p><p>{c.gap}</p>
                  <p class="label">How Critter &amp; Friends differs</p><p>{c.differs}</p>
                  {c.refs.length > 0 && <p class="refs">{c.refs.map((r) => <a href={r.href} target="_blank" rel="noopener noreferrer">{r.label}<span class="sr"> (opens in a new tab)</span></a>)}</p>}
                </article>
              ))}
            </div>
            {competitorNote && <p class="note">{competitorNote}</p>}
          </section>
        )}

        {findings.length > 0 && (
          <section id="findings">
            <span class="chip" style="--c: var(--coral)">Findings</span>
            <h2>What the research showed.</h2>
            <div class="cards">
              {findings.map((f) => (
                <article>
                  <p class="label">Evidence</p><p>{f.evidence}</p>
                  <p class="label">Insight</p><p>{f.insight}</p>
                  <p class="label">Implication</p><p>{f.implication}</p>
                </article>
              ))}
            </div>
            {artefacts.length > 0 && (
              <div class="artefacts">
                {artefacts.map((a) => (
                  <figure>
                    {a.src ? <button type="button" class="zoom" aria-label={`Enlarge: ${a.caption}`}><img src={a.src} alt={a.alt} loading="lazy" /></button> : <div class="ph">Add image</div>}
                    <figcaption>{a.caption}</figcaption>
                  </figure>
                ))}
              </div>
            )}
          </section>
        )}

        {decisions.length > 0 && (
          <section id="decisions">
            <span class="chip" style="--c: var(--amber)">Decisions</span>
            <h2>Every key design choice traced back to a finding.</h2>
            <ul class="decisions">
              {decisions.map((d) => (
                <li class={d.wide ? 'wide' : undefined}>
                  {d.img ? <button type="button" class="zoom" aria-label={`Enlarge: ${d.alt}`}><img src={d.img} alt={d.alt} loading="lazy" /></button> : <div class="ph">Add screen</div>}
                  <div><p class="label">Finding</p><p>{d.finding}</p><p class="label">Decision</p><p>{d.decision}</p></div>
                </li>
              ))}
            </ul>
          </section>
        )}

        {flow.length > 0 && (
          <section id="flow">
            <span class="chip" style="--c: var(--sage)">Structure to interface</span>
            <h2>{flowTitle}</h2>
            <p class="note top">Select any image to see it full size.</p>
            <ol class="flow">
              {flow.map((f, i) => (
                <li>
                  {f.img ? <button type="button" class="zoom" aria-label={`Enlarge: ${f.stage}`}><img src={f.img} alt={f.alt} loading="lazy" class={f.fit === 'contain' ? 'contain' : undefined} /></button> : <div class="ph">Add image</div>}
                  <p class="step">Step {i + 1}</p>
                  <h3>{f.stage}</h3><p>{f.note}</p>
                </li>
              ))}
            </ol>
          </section>
        )}

        {testing.length > 0 && (
          <section id="testing">
            <span class="chip" style="--c: var(--mint)">Testing</span>
            <h2>What testing showed, and what to fix.</h2>
            <div class="cards">
              {testing.map((t) => (
                <article>
                  <p class="label">Tested</p><p>{t.tested}</p>
                  <p class="label">What happened</p><p>{t.problem}</p>
                  <p class="label">Fix</p><p>{t.change}</p>
                </article>
              ))}
            </div>
            <figure class="mobile-shot">
              <button type="button" class="zoom" aria-label={`Enlarge: ${mobileShot.caption}`}><img src={mobileShot.src} alt={mobileShot.alt} loading="lazy" /></button>
              <figcaption>{mobileShot.caption}</figcaption>
            </figure>
          </section>
        )}

        {a11y.length > 0 && (
          <section id="accessibility">
            <span class="chip" style="--c: var(--lavender)">Accessibility</span>
            <h2>What is in place, and what is missing.</h2>
            <div class="scroll" role="region" aria-label="Accessibility checks table" tabindex="0">
              <table>
                <caption class="sr">Accessibility checks</caption>
                <thead><tr><th scope="col">Check</th><th scope="col">Method</th><th scope="col">Result</th></tr></thead>
                <tbody>{a11y.map((a) => <tr><th scope="row">{a.check}</th><td>{a.method}</td><td>{a.result}</td></tr>)}</tbody>
              </table>
            </div>
          </section>
        )}

        {limits.length + next.length > 0 && (
          <section id="next">
            <span class="chip" style="--c: var(--yellow)">Limits and next steps</span>
            <div class="two">
              {limits.length > 0 && <div><h2>Limits</h2><ul class="bullets">{limits.map((l) => <li>{l}</li>)}</ul></div>}
              {next.length > 0 && <div><h2>Next steps</h2><ul class="bullets">{next.map((n) => <li>{n}</li>)}</ul></div>}
            </div>
          </section>
        )}
      </div>
    </div>

    <BackToTop />

    <dialog id="lightbox" aria-label="Enlarged image">
      <button type="button" id="closeLb" class="close">Close</button>
      <img id="lbImg" alt="" />
    </dialog>
  </main>
</Layout>

<script>
  function initResearch() {
    const root = document.querySelector<HTMLElement>('.rs');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';

    // Highlight the section you're reading in "On this page"
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
    const spy = new IntersectionObserver((entries) => entries.forEach((e) => {
      if (e.isIntersecting) links.forEach((a) => a.toggleAttribute('aria-current', a.hash === `#${e.target.id}`));
    }), { rootMargin: '-20% 0px -70% 0px' });
    document.querySelectorAll('.content section').forEach((s) => spy.observe(s));

    // Click any image to see it full size
    const lb = document.getElementById('lightbox') as HTMLDialogElement | null;
    const lbImg = document.getElementById('lbImg') as HTMLImageElement | null;
    document.querySelectorAll<HTMLButtonElement>('.rs .zoom').forEach((b) => b.addEventListener('click', () => {
      const img = b.querySelector('img');
      if (!lb || !lbImg || !img) return;
      lbImg.src = img.currentSrc || img.src; lbImg.alt = img.alt; lb.showModal();
    }));
    document.getElementById('closeLb')?.addEventListener('click', () => lb?.close());
    lb?.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
  }
  initResearch();
  document.addEventListener('astro:page-load', initResearch);
</script>

<style>
  .rs {
    --bg: #fbfaf4; --card: #fff; --ink: #1f2430; --muted: #5a6070; --border: #d3d6df;
    --deep: #3f6b52; --shadow: 0 8px 28px rgba(31, 36, 48, .08);
    --yellow: #f6e7b0; --sage: #b5d0bf; --mint: #d0e1d4; --coral: #f0b7ab; --amber: #efd3ac; --lavender: #d3c6ea;
    --serif: 'Bodoni Moda', Georgia, serif; --mono: 'JetBrains Mono', ui-monospace, monospace;
    background: transparent; color: var(--ink); font: 16px/1.65 'Inter', system-ui, sans-serif; -webkit-font-smoothing: antialiased; min-height: 100vh;
  }
  .rs :focus-visible { outline: 3px solid var(--deep); outline-offset: 3px; border-radius: 6px; }
  .rs a { color: inherit; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
