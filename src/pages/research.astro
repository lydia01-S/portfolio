---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import img1 from '../../public/img1.png';
import img2 from '../../public/img2.png';
import h3 from '../../public/h3.png';
import h4 from '../../public/h4.png';
import h7 from '../../public/h7.png';
import h8 from '../../public/h8.png';
 
// TODO: state how each figure was measured (pilot, usability test, or projected target).
const metrics = [
  { value: 75, prefix: "-", suffix: "%", label: "Task completion time", detail: "Average timetable lookup fell from 48s to 12s.", color: "coral" },
  { value: 38, prefix: "+", suffix: "%", label: "Daily active engagement", detail: "Measured across the 1,200-student pilot.", color: "mint" },
  { value: 0, text: "AA", label: "WCAG 2.1 compliant", detail: "Screen-reader and keyboard audit passed.", color: "sage" }
];
// TODO: say what you personally did and who you worked with.
const metadata = [
  { label: "Role", value: "Lead UX/UI designer" },
  { label: "Timeline", value: "5-week design sprint" },
  { label: "Scope", value: "iOS, Android and web app" },
  { label: "Tools", value: "Figma, Miro, Photoshop" }
];
// TODO: say how the figures above were measured, e.g. "Measured in a usability test with 12 students, March 2026." Shown only when filled in.
const metricsNote = "";
 
// Each screen is tied to a problem the research surfaced, then to the decision it led to.
const screens = [
  { img: h3, title: "Deadlines first", insight: "Deadline alerts were buried under admin announcements.", decision: "The dashboard opens on priority module cards, ranked by urgency.", alt: "STU dashboard with high-contrast priority module cards" },
  { img: h8, title: "Timetable in one tap", insight: "Finding a daily schedule took seven steps.", decision: "The schedule view shows today as time blocks, with calendar sync and conflict detection.", alt: "STU schedule view with today's lectures as time blocks" },
  { img: h4, title: "Submit without hunting", insight: "Separate logins slowed down submissions and group work.", decision: "Each assignment opens a submission drawer with the brief alongside.", alt: "STU assignment view with a submission drawer and the brief" },
  { img: h7, title: "Find the room", insight: "Students checked three websites just to find their classroom.", decision: "A campus map with live occupancy links each lecture to its room.", alt: "STU campus map with live room occupancy" }
];
const heroShots = [screens[1], screens[0], screens[2]];
 
const nav = [
  ["context", "Context"], ["problem", "Problem"], ["comparison", "Before and after"],
  ["goals", "Goals"], ["solution", "Solution"], ["interface", "Interface"], ["methodology", "Methodology"], ["reflections", "Reflections"]
];
---
 
<Layout title="STU: Next-Gen Student Platform — Case Study">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,500;0,700;1,500&family=JetBrains+Mono:wght@500;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
 
  <div class="progress" aria-hidden="true"><div id="bar"></div></div>
  <a class="skip" href="#content">Skip to case study</a>
 
  <main class="cs" id="cs">
    <header class="hero">
      <div class="inner">
        <div class="topbar">
          <a href="/" class="back">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 12L4 8l6-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Back to portfolio
          </a>
          <nav class="tabs-top" aria-label="Project pages">
            <a href="/stu" aria-current="page">Overview</a>
            <a href="/stylesheet">Design system</a>
            <a href="/wireframe">IA and wireframes</a>
            <a href="/research">UX research</a>
          </nav>
        </div>
 
        <div class="hero-grid">
          <div>
            <p class="chips">
              <span class="chip" style="--c: var(--yellow)">Case study</span>
              <span class="chip" style="--c: var(--mint)" id="readTime">3 min read</span>
            </p>
            <h1>STU: a next-gen student platform</h1>
            <p class="lead">Turning fragmented university portals into one mobile-first hub, built to cut cognitive load, speed up daily schedule checks and keep students engaged on web and mobile.</p>
            <a class="cta" target="_blank" rel="noopener noreferrer"
              href="https://www.figma.com/proto/p9CXzhnuRkpQyuiRsOBexZ/Untitled?node-id=6-49197&p=f&t=0HX25CITAiz2uw3P-0&scaling=scale-down&content-scaling=fixed&page-id=0%3A1&starting-point-node-id=6%3A49197&show-proto-sidebar=1">
              Launch interactive prototype
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3.5 10.5l7-7m0 0H4.67m5.83 0v5.83" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span class="sr">(opens in a new tab)</span>
            </a>
          </div>
          <dl class="specs" aria-label="Project overview">
            {metadata.map((m) => (<div><dt>{m.label}</dt><dd>{m.value}</dd></div>))}
          </dl>
        </div>
 
        <div class="devices" role="group" aria-label="Key STU screens">
          {heroShots.map((s) => (
            <figure class="device"><Image class="device-img" src={s.img} alt={s.alt} loading="eager" /></figure>
          ))}
        </div>
 
        <div class="kpis">
          {metrics.map((m) => (
            <div class="kpi" style={`--c: var(--${m.color})`}>
              <p class="kpi-value" data-to={m.value} data-prefix={m.prefix} data-suffix={m.suffix}>{m.text ?? `${m.prefix}${m.value}${m.suffix}`}</p>
              <p class="kpi-label">{m.label}</p>
              <p class="kpi-detail">{m.detail}</p>
            </div>
          ))}
        </div>
        {metricsNote && <p class="note">{metricsNote}</p>}
      </div>
    </header>
 
    <div class="layout">
      <aside class="toc-wrap">
        <nav class="toc" aria-label="On this page">
          <p class="toc-title">On this page</p>
          {nav.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
        </nav>
      </aside>
 
      <div class="content" id="content">
        <section id="context" class="reveal">
          <span class="chip" style="--c: var(--sage)">01 Context</span>
          <div class="cols">
            <h2>STU is a mobile-first portal for modernising campus life.</h2>
            <div class="prose">
              <p>STU brings fragmented academic workflows into one mobile and web platform. By syncing coursework, schedules and peer communication, it gives students one daily hub.</p>
              <p>Working with engineers, I restructured the architecture around real-time updates and cleaner user flows, so the app stays fast and consistent.</p>
            </div>
          </div>
        </section>
 
        <section id="problem" class="reveal">
          <span class="chip" style="--c: var(--coral)">02 Problem</span>
          <div class="cols">
            <h2>Disjointed legacy tools were hurting students’ productivity.</h2>
            <div class="prose">
              <p>Students juggled several disconnected admin tools, which delayed submissions and group work:</p>
              <ul class="bullets">
                <li>Slow pages and complex navigation on legacy portals</li>
                <li>Constant context-switching across 5+ platforms</li>
                <li>Deadline alerts buried under admin announcements</li>
              </ul>
              <blockquote>
                <p>“I have to check three different websites every morning just to find out which classroom my lecture is in.”</p>
                <cite>2nd-year Computer Science student, discovery sprint</cite>
              </blockquote>
            </div>
          </div>
        </section>
 
        <figure class="shot reveal">
          <div class="shot-bar" style="--c: var(--yellow)"><span>Figure 1: Heuristic analysis</span><span class="hint">Click to enlarge</span></div>
          <button class="zoom" type="button" aria-label="Enlarge figure 1"><Image class="shot-img" src={img1} alt="Heuristic analysis of legacy university portals, with issues marked on screenshots" loading="lazy" /></button>
          <figcaption>Initial heuristic analysis of legacy university portals and campus workflows.</figcaption>
        </figure>
 
        <section id="comparison" class="reveal">
          <span class="chip" style="--c: var(--yellow)">03 Before and after</span>
          <div class="compare">
            <div class="tabs" role="tablist" aria-label="Compare versions">
              <button role="tab" id="tab-before" aria-selected="true" aria-controls="panel-before" class="t-before">Legacy portal</button>
              <button role="tab" id="tab-after" aria-selected="false" aria-controls="panel-after" class="t-after" tabindex="-1">STU redesign</button>
            </div>
            <div role="tabpanel" id="panel-before" aria-labelledby="tab-before" class="panel bad">
              <h3>Legacy university portal</h3>
              <ul>
                <li>Seven-step drill-down to find a daily schedule</li>
                <li>Unresponsive layouts that don’t work on mobile</li>
                <li>Separate logins for materials, grades and notices</li>
              </ul>
              <Image class="panel-img" src={img1} alt="Heuristic analysis of the legacy portals with usability issues marked" loading="lazy" />
            </div>
            <div role="tabpanel" id="panel-after" aria-labelledby="tab-after" class="panel good" hidden>
              <h3>STU redesign</h3>
              <ul>
                <li>Timetable and deadlines visible in one tap</li>
                <li>Mobile-first design system built to WCAG AA</li>
                <li>One activity feed with real-time push updates</li>
              </ul>
              <Image class="panel-img" src={h3} alt="STU dashboard showing today's priorities in one feed" loading="lazy" />
            </div>
          </div>
        </section>
 
        <section id="goals" class="reveal">
          <span class="chip" style="--c: var(--mint)">04 Goals</span>
          <div class="cols">
            <h2>A friction-free portal that balances student engagement with institutional efficiency.</h2>
            <div class="prose">
              <p>Objectives for the five-week sprint:</p>
              <ul class="bullets">
                <li><strong>Simplify daily navigation:</strong> cut time-to-task for timetables and submissions.</li>
                <li><strong>Lower cognitive fatigue:</strong> merge alerts into one priority-ranked feed.</li>
                <li><strong>Ensure accessibility:</strong> a WCAG 2.1 AA design system across mobile and web.</li>
              </ul>
            </div>
          </div>
        </section>
 
        <section id="solution" class="reveal">
          <span class="chip" style="--c: var(--lavender)">05 Solution</span>
          <div class="cols">
            <h2>A streamlined hub built around the action a student needs next.</h2>
            <div class="prose">
              <p>I replaced bloated admin menus with direct task paths that put urgent actions first.</p>
              <ul class="bullets">
                <li>Assignments, schedule and peer channels in one view</li>
                <li>AA colour contrast and touch-friendly target sizes</li>
                <li>Urgency filters that reduce helpdesk enquiries</li>
              </ul>
            </div>
          </div>
        </section>
 
        <section id="interface" class="reveal">
          <span class="chip" style="--c: var(--sage)">06 Interface</span>
          <h2>Every screen answers one student question.</h2>
          <div class="rows">
            {screens.map((s, i) => (
              <article class={`row ${i % 2 ? 'flip' : ''}`}>
                <button type="button" class="zoom phone" aria-label={`Enlarge ${s.title.toLowerCase()}`}>
                  <Image class="phone-img" src={s.img} alt={s.alt} loading="lazy" />
                </button>
                <div>
                  <h3>{s.title}</h3>
                  <p><strong>Insight:</strong> {s.insight}</p>
                  <p><strong>Decision:</strong> {s.decision}</p>
                </div>
              </article>
            ))}
          </div>
          <p class="more"><a href="/wireframe">See every screen and wireframe</a><a href="/stylesheet">Explore the design system</a></p>
        </section>
 
        <figure class="shot reveal">
          <div class="shot-bar" style="--c: var(--mint)"><span>Figure 2: Information architecture</span><span class="hint">Click to enlarge</span></div>
          <button class="zoom" type="button" aria-label="Enlarge figure 2"><Image class="shot-img" src={img2} alt="Information architecture map beside mobile schedule feed prototypes" loading="lazy" /></button>
          <figcaption>Information architecture map and mobile schedule feed prototypes.</figcaption>
        </figure>
 
        <section id="methodology" class="reveal">
          <span class="chip" style="--c: var(--sage)">07 Methodology</span>
          <div class="cols">
            <h2>Five weeks across research, wireframing and a scalable UI system.</h2>
            <div class="prose">
              <ul class="bullets">
                <li><strong>Discovery:</strong> heuristic audits and user interviews (n=24). <a href="/research">See the research</a></li>
                <li><strong>Strategy:</strong> affinity maps, empathy maps and core pathways</li>
                <li><strong>Architecture:</strong> card sorting, user flows and wireframes</li>
                <li><strong>System:</strong> an 80-component Figma library and interactive prototype</li>
              </ul>
            </div>
          </div>
        </section>
 
        <section id="reflections" class="reveal">
          <span class="chip" style="--c: var(--amber)">08 Reflections</span>
          <div class="cards">
            <article style="--c: var(--mint)"><h3>Domain understanding</h3><p>Designing for students means fitting campus rhythms. Immersing myself in their workflows moved me from translating requirements to designing a daily hub.</p></article>
            <article style="--c: var(--yellow)"><h3>System prioritisation</h3><p>A focused 80-component library kept development fast and design tokens consistent, rather than a bloated kit.</p></article>
            <article style="--c: var(--lavender)"><h3>Reducing cognitive strain</h3><p>Consolidating tools is cognitive psychology at work. Fewer entry points let students spend less time in software and more on coursework.</p></article>
          </div>
        </section>
      </div>
    </div>
 
    <button id="top" class="top" type="button" aria-label="Back to top">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 15l-6-6-6 6"/></svg>
    </button>
 
    <dialog id="lightbox" aria-label="Enlarged figure">
      <button type="button" id="closeLb" class="close">Close</button>
      <img id="lbImg" alt="" />
    </dialog>
  </main>
</Layout>
 
<script>
  function init() {
    const root = document.getElementById('cs');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    root.classList.add('js');
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
 
    // Reading time
    const rt = document.getElementById('readTime');
    const words = (document.getElementById('content')?.textContent || '').trim().split(/\s+/).length;
    if (rt) rt.textContent = `${Math.max(1, Math.ceil(words / 200))} min read`;
 
    // Progress bar, back-to-top
    const bar = document.getElementById('bar');
    const top = document.getElementById('top');
    const onScroll = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      if (bar) bar.style.width = `${max > 0 ? (scrollY / max) * 100 : 0}%`;
      top?.classList.toggle('show', scrollY > 500);
    };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    top?.addEventListener('click', () => scrollTo({ top: 0, behavior: still ? 'auto' : 'smooth' }));
 
    // Active section in the index
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
    const spy = new IntersectionObserver((es) => es.forEach((e) => {
      if (e.isIntersecting) links.forEach((a) => a.toggleAttribute('aria-current', a.hash === `#${e.target.id}`));
    }), { rootMargin: '-20% 0px -70% 0px' });
    document.querySelectorAll('.content section').forEach((s) => spy.observe(s));
 
    // Reveal on scroll
    const reveal = new IntersectionObserver((es) => es.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add('visible'); reveal.unobserve(e.target); }
    }), { threshold: 0.1 });
    document.querySelectorAll('.reveal').forEach((el) => reveal.observe(el));
 
    // KPI count-up
    const count = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      count.unobserve(e.target);
      const el = e.target as HTMLElement;
      const to = Number(el.dataset.to);
      if (!to || still) return;
      const t0 = performance.now();
      const step = (t: number) => {
        const p = Math.min(1, (t - t0) / 1100);
        el.textContent = `${el.dataset.prefix}${Math.round(to * (1 - Math.pow(1 - p, 3)))}${el.dataset.suffix}`;
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }), { threshold: 0.6 });
    document.querySelectorAll('.kpi-value').forEach((el) => count.observe(el));
 
    // Before/after tabs
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
      });
      tab.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') select(tabs[(i + 1) % tabs.length]);
      });
    });
 
    // Lightbox for figures
    const lb = document.getElementById('lightbox') as HTMLDialogElement | null;
    const lbImg = document.getElementById('lbImg') as HTMLImageElement | null;
    document.querySelectorAll<HTMLButtonElement>('.zoom').forEach((b) => b.addEventListener('click', () => {
      const img = b.querySelector('img');
      if (!lb || !lbImg || !img) return;
      lbImg.src = img.src; lbImg.alt = img.alt; lb.showModal();
    }));
    document.getElementById('closeLb')?.addEventListener('click', () => lb?.close());
    lb?.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
  }
  init();
  document.addEventListener('astro:page-load', init);
</script>
 
<style>
  .cs {
    --bg: #fbfaf4; --card: #fff; --ink: #1f2430; --muted: #5a6070; --border: #d3d6df;
    --deep: #3f6b52; --shadow: 0 8px 28px rgba(31, 36, 48, .08);
    --yellow: #f6e7b0; --sage: #b5d0bf; --mint: #d0e1d4; --coral: #f0b7ab; --amber: #efd3ac; --lavender: #d3c6ea;
    --serif: 'Bodoni Moda', 'Playfair Display', Georgia, serif;
    --mono: 'JetBrains Mono', ui-monospace, monospace;
    --sans: 'Inter', system-ui, -apple-system, sans-serif;
    background: var(--bg); color: var(--ink); font: 16px/1.65 var(--sans); -webkit-font-smoothing: antialiased; min-height: 100vh;
  }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .cs a { color: inherit; }
  .cs :focus-visible, .top:focus-visible { outline: 3px solid var(--deep); outline-offset: 3px; border-radius: 6px; }
  .progress { position: fixed; inset: 0 0 auto 0; height: 4px; z-index: 50; pointer-events: none; }
  #bar { height: 100%; width: 0; background: var(--deep); }
  h1, h2, h3 { font-family: var(--serif); font-weight: 500; margin: 0; text-wrap: balance; }
  ul { list-style: none; margin: 0; padding: 0; }
 
  .chip { display: inline-block; font: 500 12px/1 var(--mono); background: var(--c); color: var(--ink); padding: 7px 12px; border-radius: 999px; margin-bottom: 16px; }
  .chips { display: flex; gap: 8px; flex-wrap: wrap; margin: 0 0 16px; }
  .chips .chip { margin: 0; }
 
  /* Hero */
  .hero { border-bottom: 1px solid var(--border); padding: 24px 0 72px; }
  .inner { max-width: 1100px; margin: 0 auto; padding: 0 24px; }
  .topbar { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; padding-bottom: 20px; margin-bottom: 48px; border-bottom: 1px solid var(--border); }
  .back, .tabs-top a { font: 500 13px var(--mono); text-decoration: none; padding: 8px 12px; border-radius: 999px; transition: background .2s; }
  .back { display: inline-flex; gap: 6px; align-items: center; padding-left: 0; }
  .back:hover, .tabs-top a:hover { background: var(--mint); }
  .tabs-top { display: flex; gap: 6px; flex-wrap: wrap; }
  .tabs-top a { border: 1px solid var(--border); }
  .tabs-top a[aria-current] { background: var(--ink); border-color: var(--ink); color: #fff; }
  .hero-grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: 64px; align-items: start; }
  h1 { font-size: clamp(2.5rem, 4.6vw, 4rem); line-height: 1.08; margin-bottom: 20px; }
  .lead { font-size: 18px; line-height: 1.6; color: #2d3340; max-width: 56ch; margin: 0 0 32px; }
  .cta { display: inline-flex; align-items: center; gap: 10px; background: var(--ink); color: #fff !important; font-weight: 600; text-decoration: none; padding: 14px 26px; border-radius: 999px; transition: transform .2s, background .2s; }
  .cta:hover { background: var(--deep); transform: translateY(-2px); }
  .specs { margin: 0; background: var(--card); border: 1px solid var(--border); border-radius: 16px; box-shadow: var(--shadow); padding: 24px; display: grid; gap: 16px; }
  .specs dt { font: 500 12px var(--mono); color: var(--muted); }
  .specs dd { margin: 2px 0 0; font-weight: 600; }
 
  .kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 56px; }
  .kpi { background: var(--card); border: 1px solid var(--border); border-top: 6px solid var(--c); border-radius: 16px; padding: 24px; box-shadow: var(--shadow); }
  .kpi-value { font: 500 3rem/1 var(--serif); margin: 0 0 10px; }
  .kpi-label { font: 600 14px var(--mono); margin: 0 0 4px; }
  .kpi-detail { font-size: 14px; color: var(--muted); margin: 0; }
 
  /* Layout and nav */
  .layout { max-width: 1100px; margin: 0 auto; padding: 80px 24px 120px; display: grid; grid-template-columns: 200px 1fr; gap: 64px; align-items: start; }
  .toc-wrap { position: sticky; top: 32px; }
  .toc { display: flex; flex-direction: column; }
  .toc-title { font: 500 12px var(--mono); color: var(--muted); margin: 0 0 8px; }
  .toc a { font-size: 14px; text-decoration: none; color: var(--muted); padding: 7px 0 7px 14px; border-left: 2px solid var(--border); transition: color .2s, border-color .2s; }
  .toc a:hover { color: var(--ink); }
  .toc a[aria-current] { color: var(--ink); font-weight: 600; border-left-color: var(--deep); background: linear-gradient(90deg, var(--mint), transparent); }
 
  section { margin-bottom: 96px; scroll-margin-top: 32px; }
  .cols { display: grid; grid-template-columns: 42% 58%; gap: 40px; align-items: start; }
  h2 { font-size: clamp(1.6rem, 2.4vw, 2.2rem); line-height: 1.25; }
  .prose { line-height: 1.7; color: #333a48; max-width: 62ch; }
  .prose p { margin: 0 0 14px; }
  .bullets { margin-top: 14px; }
  .bullets li { position: relative; padding-left: 22px; margin-bottom: 10px; }
  .bullets li::before { content: ""; position: absolute; left: 0; top: .7em; width: 8px; height: 8px; border-radius: 2px; background: var(--deep); }
  blockquote { margin: 24px 0 0; padding: 18px 20px; background: var(--card); border: 1px solid var(--border); border-left: 6px solid var(--amber); border-radius: 12px; }
  blockquote p { font-style: italic; margin: 0 0 8px; color: var(--ink); }
  cite { font: 500 12px var(--mono); color: var(--muted); font-style: normal; }
 
  /* Figures and lightbox */
  .shot { margin: 0 0 96px; background: var(--card); border: 1px solid var(--border); border-radius: 16px; box-shadow: var(--shadow); padding: 14px; }
  .shot-bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; background: var(--c); border-radius: 10px; padding: 8px 14px; margin-bottom: 14px; font: 500 12px var(--mono); }
  .hint { color: #3a4050; }
  .zoom { display: block; width: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; border-radius: 10px; overflow: hidden; }
