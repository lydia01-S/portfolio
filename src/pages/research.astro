---
import Layout from '../layouts/Layout.astro';
import BackToTop from '../components/BackToTop.astro';
import StuTabs from '../components/StuTabs.astro';

// Sections with an empty array (flow, testing, a11y) are hidden until you have real evidence for them.
const page = {
  title: "STU: UX research",
  lead: "I surveyed 12 college students about how they use Moodle, reviewed it against usability heuristics and compared it with Canvas and Notion. I wanted to find out why finding things is hard, and what a student app should do first.",

  role: "Solo college project: research, design and prototyping."
};

const summary = {
  question: "Why do students find Moodle hard to use, and what should a student app prioritise?",
  did: "A 12-question survey of 12 college students, a heuristic review of Moodle, and a comparison with Canvas and Notion drawn from published sources.",
  findings: [
    "Navigation is the main pain point. 9 of 12 chose it as the most frustrating part, and open answers describe too many steps to get anywhere.",
    "Deadlines live in several places. 5 students use Moodle, 5 a phone calendar and 2 a notes app or spreadsheet, and 10 of 12 would use a built-in planner.",
    "Students want simple and organised over flashy. 10 of 12 picked simplicity, 8 picked organisation, and 7 of 12 rated deadline reminders 5 out of 5."
  ],
  changed: "The app opens on deadlines and the timetable, keeps the structure shallow with the deadline at the top of each subject, and adds a built-in planner with reminders."
};

const goals = [
  { question: "How often, and for what, do students use Moodle?", informs: "Which tasks the home screen has to make fastest." },
  { question: "How easy is it to find things, and what is most frustrating?", informs: "How shallow the navigation needs to be." },
  { question: "How do students track deadlines today, and how much do reminders matter?", informs: "Whether to build a planner and reminders." },
  { question: "What do students value in a platform, and which features matter most?", informs: "What gets priority on the home screen." },
  { question: "Where would students use the app?", informs: "Whether to design for phone, desktop or both." }
];

const methods = [
  { method: "Student survey", who: "College students who use Moodle or similar platforms", n: "12 (11 answered the features question)", when: "During the project", why: "To hear how students use Moodle and what frustrates them, in numbers and in their own words." },
  { method: "Heuristic review", who: "Moodle, reviewed against common usability principles", n: "1 platform", when: "During the project", why: "To mark where the interface itself causes the problems students describe." },
  { method: "Competitive research", who: "Moodle, Canvas and Notion", n: "3 platforms", when: "During the project", why: "To see how established tools organise information and where each one falls short." }
];
const methodNote = "Limits: a small sample from one college, self-reported answers, and no usability testing of the prototype yet. Read the percentages as a direction, not a measurement.";

// Each bar is [label, count]. Percentages are worked out from the number of responses.
const pct = (c: number, n: number) => Math.round((c / n) * 100);
const results = [
  { q: "How easy is it to find what you need on Moodle?", n: 12, note: "1 is hardest, 5 is easiest.", bars: [["1", 2], ["2", 4], ["3", 5], ["4", 0], ["5", 1]] },
  { q: "Which parts feel most confusing or frustrating? (up to 3)", n: 12, note: "Top three answers.", bars: [["Navigation and menu structure", 9], ["Timetable access", 5], ["Grades and feedback", 3]] },
  { q: "What do you mainly use Moodle for? (all that apply)", n: 12, bars: [["Submitting work", 11], ["Accessing lecture materials", 10], ["Viewing assignments", 9], ["Checking grades", 4], ["Checking timetable", 3], ["Communication", 0]] },
  { q: "Which features matter most in a student app? (3 to 5)", n: 11, bars: [["Assignment deadlines overview", 8], ["Lecture materials access", 8], ["Clear timetable", 7], ["Easy assignment submission", 6], ["Grades tracking", 6], ["Group collaboration tools", 4], ["Notifications and reminders", 3], ["Messaging and chat", 2], ["Course overview", 1], ["Cafeteria and college services", 0]] },
  { q: "What matters most in the design of a platform like this? (2 to 3)", n: 12, bars: [["Simplicity", 10], ["Organisation", 8], ["Speed", 5], ["Visual design", 5]] },
  { q: "How do you currently track your deadlines?", n: 12, bars: [["Moodle", 5], ["Personal calendar (phone)", 5], ["Notes app", 1], ["Separate spreadsheet", 1]] },
  { q: "How important are reminders for deadlines?", n: 12, note: "1 is least important, 5 is most.", bars: [["1", 0], ["2", 1], ["3", 3], ["4", 1], ["5", 7]] },
  { q: "Would you use a built-in planner or calendar?", n: 12, bars: [["Yes, definitely", 10], ["Maybe", 1], ["No", 1]] },
  { q: "Where would you prefer to use this app?", n: 12, bars: [["Both equally", 9], ["Mobile app", 3], ["Desktop or web", 0]] }
];

const competitors = [
  {
    name: "Moodle",
    how: "A long list structure, with information nested deep inside each course.",
    gap: "Students have to remember where things are and move between courses to see their work, which takes a lot of mental effort.",
    differs: "One home screen shows the timetable, deadlines and coursework together.",
    refs: [{ label: "NN/g: flat vs deep hierarchy", href: "https://www.nngroup.com/articles/flat-vs-deep-hierarchy/" }]
  },
  {
    name: "Canvas",
    how: "Task-led: a to-do list in the sidebar brings deadlines to the surface.",
    gap: "The list sits apart from the course itself, so students leave it to find the brief or the submission page.",
    differs: "The deadline sits at the top of each subject, so going from a deadline to its brief takes no extra steps.",
    refs: [
      { label: "Canvas usability paper", href: "https://manuelgarcia.info/media/full_paper/usability-canvas-lms.pdf" },
      { label: "AASA: executive functioning", href: "https://www.aasa.org/resources/resource/the-breakthrough-years-for-executive-functioning" }
    ]
  },
  {
    name: "Notion",
    how: "A very flexible workspace that students shape themselves.",
    gap: "It starts from a blank page and has no college data, so students copy information over by hand.",
    differs: "A notepad and to-do list live in the same app as grades and the timetable, so there's less switching between tools.",
    refs: [
      { label: "Ness Labs", href: "https://nesslabs.com/qatalog-featured-tool" },
      { label: "APA: multitasking", href: "https://www.apa.org/topics/research/multitasking" }
    ]
  }
];
const competitorNote = "Based on the published sources linked on each card.";

// Evidence, then insight, then implication.
const findings = [
  { evidence: "9 of 12 (75%) picked navigation and menu structure as the most frustrating part. 6 of 12 rated how easy it is to find what they need as 1 or 2 out of 5.", insight: "Finding things, not missing features, is the core problem.", implication: "Keep the structure shallow and put the timetable, deadlines and materials at the top level." },
  { evidence: "“Frustrating in the sense that it takes too many steps to get where I need to be. And I cannot find what I am looking for.”", insight: "Students feel the problem as too many steps.", implication: "Cut the steps to the tasks students do most, and add a quick way to search or jump to a course." },
  { evidence: "Students mainly use Moodle to submit work (11 of 12), access lecture materials (10 of 12) and view assignments (9 of 12). Only 3 of 12 use it for the timetable.", insight: "Moodle is used for tasks, not for browsing.", implication: "Design around short task paths: deadline, brief, submission." },
  { evidence: "Deadlines are tracked in Moodle (5), a phone calendar (5), a notes app (1) and a spreadsheet (1). 10 of 12 would use a built-in planner, and 7 of 12 rated reminders 5 out of 5.", insight: "Students keep a second copy of their deadlines somewhere else.", implication: "Build a planner with reminders into the app, so there's one place to look." },
  { evidence: "Simplicity was picked by 10 of 12 (83%) and organisation by 8 of 12 (67%). Visual design and speed were each picked by 5 of 12.", insight: "Students value clarity over looks.", implication: "Keep the interface calm and well organised, with visual polish coming second to clear hierarchy." },
  { evidence: "9 of 12 would use the app on phone and web equally, 3 of 12 mainly on their phone, and none mainly on desktop.", insight: "Students expect both.", implication: "Design for phone first, and make sure it works well on the web too." }
];

const  artefacts: { dates: string; title: string; place: string; note: string }[] = [];


// The bridge from research to interface.
const decisions = [
  { finding: "8 of 11 ranked an assignment deadlines overview among the most important features, and 7 of 12 rated reminders 5 out of 5.", decision: "The home screen opens on module cards ranked by how soon work is due.", img: "/h3.png", alt: "STU dashboard with high-contrast priority module cards" },
  { finding: "5 of 12 found timetable access confusing, and 7 of 11 want a clear timetable.", decision: "The schedule view shows today as time blocks.", img: "/h8.png", alt: "STU schedule view with today's lectures as time blocks" },
  { finding: "Submitting work is the most common use of Moodle (11 of 12), and 6 of 11 want easy submission.", decision: "Each assignment opens a submission drawer with the brief beside it.", img: "/h4.png", alt: "STU assignment view with a submission drawer and the brief" },
  { finding: "9 of 12 found navigation the most frustrating part, and Canvas keeps its to-do list apart from the course.", decision: "A shallow structure, with the deadline at the top of each subject.", img: "/img2.png", alt: "Information architecture map beside mobile schedule screens" }
];

const flow = [];
const testing = [];
const a11y = [];

const limits = [
  "The sample is small (12 students), from one college, and self-reported.",
  "The 1 to 5 ratings come from a small group, so they show a direction, not a measurement.",
  "The competitor comparisons are based on published sources, not on my own testing of each product.",
  "The prototype hasn't been usability tested yet."
];
const next = [
  "Test the prototype with about five students, with tasks like finding today's deadlines and submitting an assignment.",
  "Follow up the survey with short interviews about how students track deadlines.",
  "Check the home screen against the survey: does it put the three most-used tasks first?"
];

const sections = [
  { id: "summary", label: "Summary", show: true },
  { id: "goals", label: "Goals", show: goals.length > 0 },
  { id: "methods", label: "Methods", show: methods.length > 0 },
  { id: "results", label: "Survey results", show: results.length > 0 },
  { id: "competitors", label: "Competitive research", show: competitors.length > 0 },
  { id: "findings", label: "Findings", show: findings.length > 0 },
  { id: "decisions", label: "Decisions", show: decisions.length > 0 },
  { id: "flow", label: "Structure to interface", show: flow.length > 0 },
  { id: "testing", label: "Testing", show: testing.length > 0 },
  { id: "accessibility", label: "Accessibility", show: a11y.length > 0 },
  { id: "next", label: "Limits and next steps", show: limits.length + next.length > 0 }
].filter((s) => s.show);


---

<Layout title={page.title} bg="#fbfaf4">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,500;0,700;1,500&family=JetBrains+Mono:wght@500;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <a class="skip" href="#content">Skip to research</a>

  <main class="rs">
    <header class="hero">
      <div class="inner">
        <StuTabs current="research" />
        <p class="chips">
  <span class="chip" style="--c: var(--yellow)">UX research</span>
  <span class="chip" style="--c: var(--mint)" id="readTime">3 min read</span>
</p>
        <h1>{page.title}</h1>
        <p class="lead">{page.lead}</p>
        <p class="role"><span>My role</span> {page.role}</p>
      </div>
    </header>

    <div class="layout">
      <aside class="toc-wrap">
        <nav class="toc" aria-label="On this page">
          <p class="toc-title">On this page</p>
          {sections.map((s) => <a href={`#${s.id}`}>{s.label}</a>)}
        </nav>
      </aside>

      <div class="content" id="content">
        <section id="summary">
          <span class="chip" style="--c: var(--sage)">Summary</span>
          <dl class="summary">
            <div><dt>The question</dt><dd>{summary.question}</dd></div>
            <div><dt>What I did</dt><dd>{summary.did}</dd></div>
            <div><dt>What I found</dt><dd><ul class="bullets">{summary.findings.map((f) => <li>{f}</li>)}</ul></dd></div>
            <div><dt>What changed</dt><dd>{summary.changed}</dd></div>
          </dl>
        </section>

        {goals.length > 0 && (
          <section id="goals">
            <span class="chip" style="--c: var(--mint)">Goals</span>
            <h2>What I needed to find out, and what each answer would decide.</h2>
            <ul class="rows">
              {goals.map((g) => <li><p class="q">{g.question}</p><p class="informs"><strong>Informs:</strong> {g.informs}</p></li>)}
            </ul>
          </section>
        )}

        {methods.length > 0 && (
          <section id="methods">
            <span class="chip" style="--c: var(--lavender)">Methods</span>
            <h2>How I gathered evidence, and from whom.</h2>
            <div class="scroll" role="region" aria-label="Research methods table" tabindex="0">
              <table>
                <caption class="sr">Research methods</caption>
                <thead><tr><th scope="col">Method</th><th scope="col">Who or what</th><th scope="col">How many</th><th scope="col">When</th><th scope="col">Why</th></tr></thead>
                <tbody>{methods.map((m) => <tr><th scope="row">{m.method}</th><td>{m.who}</td><td>{m.n}</td><td>{m.when}</td><td>{m.why}</td></tr>)}</tbody>
              </table>
            </div>
            {methodNote && <p class="note">{methodNote}</p>}
          </section>
        )}

        {results.length > 0 && (
          <section id="results">
            <span class="chip" style="--c: var(--sage)">Survey results</span>
            <h2>What 12 students told me about Moodle.</h2>
            <div class="charts">
              {results.map((r) => (
                <figure class="chart">
                  <h3>{r.q}</h3>
                  <p class="n">{r.n} responses{r.note ? `. ${r.note}` : ""}</p>
                  <ul class="bars">
                    {r.bars.map(([label, count]) => (
                      <li>
                        <span class="bl">{label}</span>
                        <span class="track" aria-hidden="true"><span class="fill" style={`width:${(Number(count) / r.n) * 100}%`}></span></span>
                        <span class="bv">{count} ({pct(Number(count), r.n)}%)</span>
                      </li>
                    ))}
                  </ul>
                </figure>
              ))}
            </div>
          </section>
        )}

        {competitors.length > 0 && (
          <section id="competitors">
            <span class="chip" style="--c: var(--lavender)">Competitive research</span>
            <h2>How Moodle, Canvas and Notion handle the same problem.</h2>
            <div class="cards comp">
              {competitors.map((c) => (
                <article>
                  <h3>{c.name}</h3>
                  <p class="label">How it works</p><p>{c.how}</p>
                  <p class="label">Where it falls short</p><p>{c.gap}</p>
                  <p class="label">How STU differs</p><p>{c.differs}</p>
                  <p class="refs">{c.refs.map((r) => <a href={r.href} target="_blank" rel="noopener noreferrer">{r.label}<span class="sr"> (opens in a new tab)</span></a>)}</p>
                </article>
              ))}
            </div>
            {competitorNote && <p class="note">{competitorNote}</p>}
          </section>
        )}

        {findings.length > 0 && (
          <section id="findings">
            <span class="chip" style="--c: var(--coral)">Findings</span>
            <h2>What the evidence showed.</h2>
            <div class="cards">
              {findings.map((f) => (
                <article>
                  <p class="label">Evidence</p><p>{f.evidence}</p>
                  <p class="label">Insight</p><p>{f.insight}</p>
                  <p class="label">Implication</p><p>{f.implication}</p>
                </article>
              ))}
            </div>
            {artefacts.length > 0 && (
              <div class="artefacts">
                {artefacts.map((a) => (
                  <figure>
                    {a.src ? <img src={a.src} alt={a.alt} loading="lazy" /> : <div class="ph">Add image</div>}
                    <figcaption>{a.caption}</figcaption>
                  </figure>
                ))}
              </div>
            )}
          </section>
        )}

        {decisions.length > 0 && (
          <section id="decisions">
            <span class="chip" style="--c: var(--amber)">Decisions</span>
            <h2>Every key design choice, traced back to a finding.</h2>
            <ul class="decisions">
              {decisions.map((d) => (
                <li>
                  {d.img ? <img src={d.img} alt={d.alt} loading="lazy" /> : <div class="ph">Add screen</div>}
                  <div><p class="label">Finding</p><p>{d.finding}</p><p class="label">Decision</p><p>{d.decision}</p></div>
                </li>
              ))}
            </ul>
          </section>
        )}

        {flow.length > 0 && (
          <section id="flow">
            <span class="chip" style="--c: var(--sage)">Structure to interface</span>
            <h2>From flow, to wireframe, to finished screen.</h2>
            <ol class="flow">
              {flow.map((f) => (
                <li>
                  {f.img ? <img src={f.img} alt={f.alt} loading="lazy" /> : <div class="ph">Add image</div>}
                  <h3>{f.stage}</h3><p>{f.note}</p>
                </li>
              ))}
            </ol>
          </section>
        )}

        {testing.length > 0 && (
          <section id="testing">
            <span class="chip" style="--c: var(--mint)">Testing</span>
            <h2>What went wrong, and what I changed.</h2>
            <div class="cards">
              {testing.map((t) => (
                <article>
                  <p class="label">Tested</p><p>{t.tested}</p>
                  <p class="label">Problem</p><p>{t.problem}</p>
                  <p class="label">Change</p><p>{t.change}</p>
                </article>
              ))}
            </div>
          </section>
        )}

        {a11y.length > 0 && (
          <section id="accessibility">
            <span class="chip" style="--c: var(--lavender)">Accessibility</span>
            <h2>What I checked, and how.</h2>
            <div class="scroll" role="region" aria-label="Accessibility checks table" tabindex="0">
              <table>
                <caption class="sr">Accessibility checks</caption>
                <thead><tr><th scope="col">Check</th><th scope="col">Method</th><th scope="col">Result</th></tr></thead>
                <tbody>{a11y.map((a) => <tr><th scope="row">{a.check}</th><td>{a.method}</td><td>{a.result}</td></tr>)}</tbody>
              </table>
            </div>
          </section>
        )}

        {limits.length + next.length > 0 && (
          <section id="next">
            <span class="chip" style="--c: var(--yellow)">Limits and next steps</span>
            <div class="two">
              {limits.length > 0 && <div><h2>Limits</h2><ul class="bullets">{limits.map((l) => <li>{l}</li>)}</ul></div>}
              {next.length > 0 && <div><h2>Next steps</h2><ul class="bullets">{next.map((n) => <li>{n}</li>)}</ul></div>}
            </div>
          </section>
        )}
      </div>
    </div>
    <BackToTop />
  </main>
</Layout>

<style>
  .rs {
    --bg: #fbfaf4; --card: #fff; --ink: #1f2430; --muted: #5a6070; --border: #d3d6df;
    --deep: #3f6b52; --shadow: 0 8px 28px rgba(31, 36, 48, .08);
    --yellow: #f6e7b0; --sage: #b5d0bf; --mint: #d0e1d4; --coral: #f0b7ab; --amber: #efd3ac; --lavender: #d3c6ea;
    --serif: 'Bodoni Moda', Georgia, serif; --mono: 'JetBrains Mono', ui-monospace, monospace;
    background: var(--bg); color: var(--ink); font: 16px/1.65 'Inter', system-ui, sans-serif; -webkit-font-smoothing: antialiased; min-height: 100vh;
  }
  .rs :focus-visible { outline: 3px solid var(--deep); outline-offset: 3px; border-radius: 6px; }
  .rs a { color: inherit; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .skip { position: absolute; left: -999px; top: 8px; z-index: 100; background: #fff; color: var(--ink); padding: 10px 18px; border-radius: 999px; font: 600 14px 'Inter', sans-serif; }
  .skip:focus { left: 16px; }
  h1, h2, h3 { font-family: var(--serif); font-weight: 500; margin: 0; text-wrap: balance; }
  ul, ol { list-style: none; margin: 0; padding: 0; }
  p { margin: 0 0 10px; }

  .chip { display: inline-block; font: 500 12px/1 var(--mono); background: var(--c); padding: 7px 12px; border-radius: 999px; margin-bottom: 16px; }
  .chips { margin: 0 0 16px; }
  .inner { max-width: 1100px; margin: 0 auto; padding: 0 24px; }

  .hero { border-bottom: 1px solid var(--border); padding: 24px 0 56px; }
  h1 { font-size: clamp(2.4rem, 4.6vw, 3.8rem); line-height: 1.1; margin-bottom: 20px; }
  .lead { font-size: 18px; color: #2d3340; max-width: 62ch; margin-bottom: 20px; }
  .role { font-size: 14px; color: var(--muted); }
  .role span { font: 500 12px var(--mono); margin-right: 8px; color: var(--ink); }

  .layout { max-width: 1100px; margin: 0 auto; padding: 72px 24px 120px; display: grid; grid-template-columns: 200px 1fr; gap: 64px; align-items: start; }
  .toc-wrap { position: sticky; top: 32px; }
  .toc { display: flex; flex-direction: column; }
  .toc-title { font: 500 12px var(--mono); color: var(--muted); margin: 0 0 8px; }
  .toc a { font-size: 14px; text-decoration: none; color: var(--muted); padding: 7px 0 7px 14px; border-left: 2px solid var(--border); }
  .toc a:hover { color: var(--ink); border-left-color: var(--deep); }

  section { margin-bottom: 88px; scroll-margin-top: 32px; }
  h2 { font-size: clamp(1.5rem, 2.2vw, 2rem); line-height: 1.25; margin-bottom: 24px; max-width: 28ch; }
  .label { font: 500 12px var(--mono); color: var(--muted); margin: 14px 0 2px; }
  .label:first-child { margin-top: 0; }
  .bullets li { position: relative; padding-left: 22px; margin-bottom: 8px; }
  .bullets li::before { content: ""; position: absolute; left: 0; top: .7em; width: 8px; height: 8px; border-radius: 2px; background: var(--deep); }

  .summary { margin: 0; display: grid; gap: 0; background: var(--card); border: 1px solid var(--border); border-radius: 16px; box-shadow: var(--shadow); }
  .summary > div { display: grid; grid-template-columns: 160px 1fr; gap: 24px; padding: 20px 26px; border-top: 1px solid var(--border); }
  .summary > div:first-child { border-top: 0; }
  .summary dt { font: 500 12px/1.8 var(--mono); color: var(--muted); }
  .summary dd { margin: 0; }

  .rows li { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; padding: 18px 0; border-top: 1px solid var(--border); }
  .q { font-weight: 600; }
  .informs { color: #333a48; }

  .scroll { overflow-x: auto; background: var(--card); border: 1px solid var(--border); border-radius: 16px; box-shadow: var(--shadow); }
  table { width: 100%; border-collapse: collapse; font-size: 14px; min-width: 620px; }
  th, td { text-align: left; padding: 14px 18px; border-bottom: 1px solid var(--border); vertical-align: top; }
  thead th { font: 500 12px var(--mono); color: var(--muted); background: var(--bg); }
  tbody th { font-weight: 600; }
  tr:last-child > * { border-bottom: 0; }
  .note { font-size: 14px; color: var(--muted); margin-top: 14px; max-width: 80ch; }

  .charts { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px; }
  .chart { margin: 0; background: var(--card); border: 1px solid var(--border); border-radius: 16px; padding: 22px; box-shadow: var(--shadow); }
  .chart h3 { font-size: 1.1rem; line-height: 1.3; margin-bottom: 4px; }
  .chart .n { font-size: 13px; color: var(--muted); margin: 0 0 16px; }
  .bars li { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) auto; gap: 10px; align-items: center; font-size: 13px; line-height: 1.35; margin-bottom: 9px; }
  .track { display: block; height: 10px; background: var(--mint); border-radius: 5px; overflow: hidden; }
  .fill { display: block; height: 100%; background: var(--deep); border-radius: 5px; }
  .bv { font: 500 12px var(--mono); color: var(--muted); white-space: nowrap; font-variant-numeric: tabular-nums; text-align: right; min-width: 7ch; }

  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }
