---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

// Persona Data
const personas = [
  {
    name: "Alex Rivera",
    role: "Product Manager",
    archetype: "The Power Planner",
    avatar: "/persona-1.png",
    quote: "I need a tool that seamlessly integrates into my daily routine without adding clutter.",
    demographics: { age: 32, location: "San Francisco, CA", experience: "5+ years" },
    goals: [
      "Streamline daily team updates",
      "Reduce time spent on manual tracking",
      "Export clean reports for stakeholders"
    ],
    frustrations: [
      "Overly complex navigation in current apps",
      "Lack of customizable dashboard views"
    ]
  },
  {
    name: "Maya Chen",
    role: "Freelance Designer",
    archetype: "The Visual Thinker",
    avatar: "/persona-2.png",
    quote: "Visual clarity is key for me. If I can't find what I need in two clicks, I lose momentum.",
    demographics: { age: 27, location: "Austin, TX", experience: "3 years" },
    goals: [
      "Quick access to design tokens and assets",
      "Clean, distraction-free interface",
      "Smooth mobile-to-desktop handoff"
    ],
    frustrations: [
      "Inconsistent typography and UI elements",
      "Slow load times on graphic-heavy pages"
    ]
  }
];

// Key Survey Metrics
const surveyMetrics = [
  { target: "78", suffix: "%", decimals: "0", initial: "0%", label: "Prefer minimal, low-clutter interfaces" },
  { target: "64", suffix: "%", decimals: "0", initial: "0%", label: "Access workflow tools primary via desktop" },
  { target: "3.2", suffix: " hrs", decimals: "1", initial: "0 hrs", label: "Average daily time spent in project tools" },
  { target: "120", suffix: "+", decimals: "0", initial: "0+", label: "Total active survey respondents" }
];

// Agency Research Synthesis (Insight to Action mapping)
const researchSynthesis = [
  {
    finding: "Navigation Overload & Cognitive Fatigue",
    insight: "68% of users expressed frustration when navigating nested university sub-menus.",
    impact: "Designed flat, persistent bottom tabs and unified search for immediate access to core tools."
  },
  {
    finding: "Context Switching between Mobile & Desktop",
    insight: "Students start tasks on desktop but check real-time updates (schedules, grades) on mobile.",
    impact: "Prioritized high-contrast status cards and swipeable deadline drawers for mobile states."
  },
  {
    finding: "Accessibility & Low-Light Usage",
    insight: "Late-night studying requires high-contrast UI components and clear typographic visual hierarchy.",
    impact: "Adopted strict AAA contrast guidelines and clean sans-serif typography for interactive components."
  }
];
---

<Layout title="STU: User Research & Insights">
  <main class="research-page">
    
    <!-- Header & Sub Navigation -->
    <header class="rs-header reveal-on-scroll">
      <div class="header-top">
        <a href="/work" class="back-link" aria-label="Back to Work">← Back to Work</a>
        
        <nav class="project-nav" aria-label="Project Sections">
          <a href="/stylesheet" class="nav-tab">Style Guide</a>
          <a href="/wireframe" class="nav-tab">Wireframes & Site Map</a>
          <a href="/research" class="nav-tab active">Research</a>
        </nav>
      </div>

      <div class="header-content">
        <span class="section-tag">UX Methodology</span>
        <h1 class="rs-title">User Research & Behavioral Insights</h1>
        <p class="rs-subtitle">
          Informing product architecture through quantitative user surveys, qualitative persona studies, and usability mapping.
        </p>
      </div>
    </header>

    <div class="rs-container">
      
      <!-- SECTION 1: Survey Insights -->
      <section class="research-section reveal-on-scroll">
        <div class="section-header-row">
          <div>
            <span class="section-tag">01 / Quantitative Data</span>
            <h2>Survey Metrics & Core Takeaways</h2>
          </div>
        </div>
        
        <!-- Metrics Bar with Animated Counters -->
        <div class="metrics-grid">
          {surveyMetrics.map((item) => (
            <div class="metric-card">
              <span 
                class="metric-stat count-up" 
                data-target={item.target} 
                data-suffix={item.suffix} 
                data-decimals={item.decimals}
              >
                {item.initial}
              </span>
              <p class="metric-label">{item.label}</p>
            </div>
          ))}
        </div>

        <!-- Key Survey Findings Box -->
        <div class="findings-card">
          <h3 class="card-subtitle">Key Quantitative Findings</h3>
          <ul class="findings-list">
            <li>
              <strong>Efficiency over novelty:</strong> 82% of users cited speed and clear visual hierarchy as their primary requirement.
            </li>
            <li>
              <strong>Mobile vs Desktop split:</strong> While primary work occurs on desktop, 45% perform quick status checks via mobile.
            </li>
            <li>
              <strong>Onboarding drop-off:</strong> Complex initial setups cause a 30% drop in user retention within the first week.
            </li>
          </ul>
        </div>
      </section>

      <!-- SECTION 2: Insight to Action Matrix (Agency Quality Addition) -->
      <section class="research-section reveal-on-scroll">
        <div class="section-header-row">
          <div>
            <span class="section-tag">02 / Synthesis Matrix</span>
            <h2>Connecting Research to Design Decisions</h2>
          </div>
        </div>

        <div class="synthesis-grid">
          {researchSynthesis.map((item) => (
            <div class="synthesis-card">
              <span class="synthesis-finding">{item.finding}</span>
              <p class="synthesis-insight"><strong>User Insight:</strong> {item.insight}</p>
              <div class="synthesis-impact">
                <strong>Design Impact:</strong> {item.impact}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- SECTION 3: User Personas -->
      <section class="research-section reveal-on-scroll">
        <div class="section-header-row">
          <div>
            <span class="section-tag">03 / Qualitative Personas</span>
            <h2>User Archetypes & Behavioral Models</h2>
          </div>
        </div>

        <div class="personas-grid">
          {personas.map((persona) => (
            <div class="persona-card">
              
              <!-- Header Profile -->
              <div class="persona-header">
                <img class="persona-avatar" src={persona.avatar} alt={persona.name} />
                <div class="persona-meta">
                  <h3 class="persona-name">{persona.name}</h3>
                  <span class="persona-role">{persona.role}</span>
                  <span class="persona-archetype">{persona.archetype}</span>
                </div>
              </div>

              <!-- Quote Block -->
              <blockquote class="persona-quote">
                "{persona.quote}"
              </blockquote>

              <!-- Details Grid -->
              <div class="persona-details">
                <div class="detail-block">
                  <h4 class="block-title">Goals & Needs</h4>
                  <ul>
                    {persona.goals.map((goal) => (
                      <li>{goal}</li>
                    ))}
                  </ul>
                </div>

                <div class="detail-block">
                  <h4 class="block-title">Frustrations & Pain Points</h4>
                  <ul>
                    {persona.frustrations.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              </div>

            </div>
          ))}
        </div>
      </section>

      <!-- SECTION 4: Visual Persona Artefacts -->
      <section class="research-section reveal-on-scroll">
        <div class="section-header-row">
          <div>
            <span class="section-tag">04 / Research Artifacts</span>
            <h2>Persona Mapping Spectrum</h2>
          </div>
        </div>

        <div class="persona-image-wrapper">
          <img class="persona-full-img" src="/persona.png" alt="User Persona Spectrum Mapping" />
        </div>
      </section>

    </div>
  </main>
  <Footer />
</Layout>

<script>
  // --- 1. Scroll Reveal Animation Observer ---
  function initScrollReveal() {
    const observerCallback: IntersectionObserverCallback = (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    };

    const scrollObserver = new IntersectionObserver(observerCallback, {
      threshold: 0.08,
      rootMargin: '0px 0px -40px 0px'
    });

    document.querySelectorAll('.reveal-on-scroll').forEach((el) => scrollObserver.observe(el));
  }

  // --- 2. Dynamic Counter Calculator Animation ---
  function initCounters() {
    const counters = document.querySelectorAll('.count-up');
    const duration = 600; // Fast 0.6s calculation speed

    const counterObserver = new IntersectionObserver((entries, obs) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const targetEl = entry.target as HTMLElement;
          const targetValue = parseFloat(targetEl.dataset.target || '0');
          const suffix = targetEl.dataset.suffix || '';
          const decimals = parseInt(targetEl.dataset.decimals || '0', 10);
          
          let startTime: number | null = null;

          function updateCount(timestamp: number) {
            if (!startTime) startTime = timestamp;
            const progress = Math.min((timestamp - startTime) / duration, 1);
            
            const easeOutProgress = 1 - Math.pow(1 - progress, 3);
            const currentCount = easeOutProgress * targetValue;

            targetEl.textContent = currentCount.toFixed(decimals) + suffix;

            if (progress < 1) {
              requestAnimationFrame(updateCount);
            } else {
              targetEl.textContent = targetValue.toFixed(decimals) + suffix;
            }
          }

          requestAnimationFrame(updateCount);
          obs.unobserve(targetEl);
        }
      });
    }, { threshold: 0.2 });

    counters.forEach(counter => counterObserver.observe(counter));
  }

  // Master Setup function
  function setupAnimations() {
    initScrollReveal();
    initCounters();
  }

  document.addEventListener('DOMContentLoaded', setupAnimations);
  document.addEventListener('astro:page-load', setupAnimations);
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

  html {
    scroll-behavior: smooth;
  }

  /* --- Base Typography & Reset --- */
  .research-page,
  .research-page p,
  .research-page span,
  .research-page button,
  .research-page a,
  .research-page li {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  .research-page h1,
  .research-page h2 {
    font-family: 'Bodoni Moda', 'Playfair Display', serif;
  }

  .research-page {
    background-color: #f8f7f4;
    color: #1a1a1a;
    min-height: 100vh;
    padding: 40px 5% 120px;
    max-width: 1280px;
    margin: 0 auto;
  }

  .rs-container {
    display: flex;
    flex-direction: column;
    gap: 72px;
  }

  /* --- Scroll Reveal Animations --- */
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), 
                transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .reveal-on-scroll.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* --- Header & Sub Navigation --- */
  .rs-header {
    margin-bottom: 50px;
  }

  .header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 32px;
    flex-wrap: wrap;
    gap: 16px;
  }

  .back-link {
    font-size: 14px;
    font-weight: 500;
    color: #666;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: #000;
  }

  .project-nav {
    display: flex;
    background: #eae8e1;
    padding: 4px;
    border-radius: 100px;
    gap: 4px;
  }

  .nav-tab {
    padding: 6px 16px;
    font-size: 13px;
    font-weight: 500;
    color: #555;
    text-decoration: none;
    border-radius: 100px;
    transition: all 0.2s ease;
  }

  .nav-tab.active,
  .nav-tab:hover {
    background: #ffffff;
    color: #0c0c0c;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  }

  .section-tag {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #7500f3;
    display: block;
    margin-bottom: 8px;
  }

  .rs-title {
    font-size: clamp(2.2rem, 4.5vw, 3.6rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }

  .rs-subtitle {
    font-size: 17px;
    line-height: 1.5;
    color: #555;
    max-width: 680px;
  }

  /* --- Section Header Row --- */
  .section-header-row {
    margin-bottom: 24px;
  }

  .section-header-row h2 {
    font-size: 2rem;
    font-weight: 400;
    margin: 0;
  }

  .research-section {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* --- Metrics Grid --- */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
  }

  .metric-card {
    background: #ffffff;
    border-radius: 20px;
    padding: 24px;
    border: 1px solid #e5e3dc;
    box-shadow: 0 4px 20px rgba(0,0,0,0.02);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .metric-stat {
    font-size: 40px;
    font-weight: 700;
    color: #7500f3;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .metric-label {
    font-size: 13px;
    color: #555;
    font-weight: 500;
    margin: 0;
    line-height: 1.4;
  }

  /* --- Findings Card --- */
  .findings-card {
    background: #ffffff;
    border-radius: 20px;
    padding: 28px;
    border: 1px solid #e5e3dc;
    box-shadow: 0 4px 20px rgba(0,0,0,0.02);
  }

  .card-subtitle {
    font-size: 16px;
    font-weight: 600;
    margin-top: 0;
    margin-bottom: 16px;
  }

  .findings-list {
    margin: 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 14px;
    color: #4a4a4a;
    line-height: 1.6;
  }

  .findings-list strong {
    color: #1a1a1a;
  }

  /* --- Synthesis Matrix --- */
  .synthesis-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
  }

  .synthesis-card {
    background: #ffffff;
    border: 1px solid #e5e3dc;
    border-radius: 20px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.02);
  }

  .synthesis-finding {
    font-size: 15px;
    font-weight: 600;
    color: #7500f3;
  }

  .synthesis-insight {
    font-size: 13px;
    line-height: 1.5;
    color: #555;
    margin: 0;
  }

  .synthesis-impact {
    font-size: 13px;
    line-height: 1.5;
    color: #1a1a1a;
    background: #f7f5f0;
    padding: 12px 14px;
    border-radius: 12px;
    border-left: 3px solid #7500f3;
  }

  /* --- Personas Grid --- */
  .personas-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
  }

  .persona-card {
    background: #ffffff;
    border-radius: 20px;
    padding: 28px;
    border: 1px solid #e5e3dc;
    box-shadow: 0 4px 20px rgba(0,0,0,0.02);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .persona-header {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .persona-avatar {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    object-fit: cover;
    background-color: #f0eee6;
  }

  .persona-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .persona-name {
    font-size: 18px;
    font-weight: 600;
    margin: 0;
  }

  .persona-role {
    font-size: 13px;
    font-weight: 600;
    color: #7500f3;
  }

  .persona-archetype {
    font-size: 12px;
    color: #71717a;
  }

  .persona-quote {
    margin: 0;
    padding: 12px 16px;
    background: #f8f7f4;
    border-left: 3px solid #1a1a1a;
    border-radius: 0 12px 12px 0;
    font-size: 13px;
    font-style: italic;
    color: #27272a;
    line-height: 1.5;
  }

  .persona-details {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .block-title {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #71717a;
    margin-top: 0;
    margin-bottom: 8px;
  }

  .detail-block ul {
    margin: 0;
    padding-left: 18px;
    font-size: 13px;
    color: #4a4a4a;
    display: flex;
    flex-direction: column;
    gap: 6px;
    line-height: 1.5;
  }

  /* --- Image Card Artifact Wrapper --- */
  .persona-image-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    background: #ffffff;
    border-radius: 20px;
    padding: 24px;
    border: 1px solid #e5e3dc;
    box-shadow: 0 4px 20px rgba(0,0,0,0.02);
  }

  .persona-full-img {
    width: 100%;
    max-width: 650px;
    height: auto;
    display: block;
    border-radius: 12px;
  }

  @media (max-width: 768px) {
    .research-page {
      padding: 24px 16px 80px;
    }

    .header-top {
      flex-direction: column;
      align-items: flex-start;
    }

    .personas-grid {
      grid-template-columns: 1fr;
    }
  }
</style>