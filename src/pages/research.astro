---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';

// Key Survey Metrics
const surveyMetrics = [
  { target: "78", suffix: "%", decimals: "0", initial: "0%", label: "Prefer minimal, low-clutter interfaces" },
  { target: "64", suffix: "%", decimals: "0", initial: "0%", label: "Access workflow tools primary via desktop" },
  { target: "3.2", suffix: " hrs", decimals: "1", initial: "0 hrs", label: "Average daily time spent in project tools" },
  { target: "120", suffix: "+", decimals: "0", initial: "0+", label: "Total active survey respondents" }
];

// Agency Research Synthesis (Insight to Action mapping)
const researchSynthesis = [
  {
    finding: "Navigation Overload & Cognitive Fatigue",
    insight: "68% of users expressed frustration when navigating nested university sub-menus.",
    impact: "Designed flat, persistent bottom tabs and unified search for immediate access to core tools."
  },
  {
    finding: "Context Switching between Mobile & Desktop",
    insight: "Students start tasks on desktop but check real-time updates (schedules, grades) on mobile.",
    impact: "Prioritized high-contrast status cards and swipeable deadline drawers for mobile states."
  },
  {
    finding: "Accessibility & Low-Light Usage",
    insight: "Late-night studying requires high-contrast UI components and clear typographic visual hierarchy.",
    impact: "Adopted strict AAA contrast guidelines and clean sans-serif typography for interactive components."
  }
];
---

<Layout title="STU: User Research & Insights">
  <ClientRouter />

  <main class="style-guide-bg">
    <!-- Ambient Blur Glows -->
    <div class="bg-blur-spot spot-1" aria-hidden="true"></div>
    <div class="bg-blur-spot spot-2" aria-hidden="true"></div>

    <div class="container">
      
      <!-- HEADER & NAVIGATION -->
      <header class="rs-header reveal-on-scroll">
        <div class="header-top">
          <a href="/work" class="back-link" aria-label="Back to Work">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M10 12L4 8L10 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Back to Portfolio
          </a>
          
          <nav class="project-nav" aria-label="Project Sections">
            <a href="/stylesheet" class="nav-tab">Style Guide</a>
            <a href="/wireframe" class="nav-tab">Wireframes & Site Map</a>
            <a href="/research" class="nav-tab active" aria-current="page">
              <span class="dot"></span> Research
            </a>
          </nav>
        </div>

        <!-- HERO BANNER -->
        <div class="header-hero">
          <div class="header-content">
            <div class="tag-wrapper">
              <span class="section-tag">UX Methodology</span>
              <span class="status-badge">Behavioral Analysis</span>
            </div>
            
            <h1 class="rs-title">User Research & Behavioral Insights</h1>
            
            <p class="rs-description">
              Informing product architecture through quantitative user surveys and usability mapping. Our methodology prioritizes deep empathetic understanding to synthesize raw data into actionable design directives.
            </p>
          </div>
        </div>
      </header>

      <div class="rs-container">
        
        <!-- SECTION 1: Survey Insights -->
        <section class="research-section reveal-on-scroll">
          <div class="section-heading">
            <span class="section-tag">01 / Quantitative Data</span>
            <h2 class="section-title">Survey Metrics & Core Takeaways</h2>
            <p class="section-desc">Key performance indicators from our active user survey feedback loops.</p>
          </div>
          
          <!-- Metrics Bar with Animated Counters -->
          <div class="metrics-grid">
            {surveyMetrics.map((item) => (
              <div class="ui-card metric-card hover-lift">
                <span 
                  class="metric-stat count-up" 
                  data-target={item.target} 
                  data-suffix={item.suffix} 
                  data-decimals={item.decimals}
                >
                  {item.initial}
                </span>
                <p class="metric-label">{item.label}</p>
              </div>
            ))}
          </div>

          <!-- Key Survey Findings Box -->
          <div class="ui-card findings-card">
            <div class="card-header">
              <h3 class="card-title">Key Quantitative Findings</h3>
            </div>
            <ul class="clean-bullet-list findings-list">
              <li>
                <strong>Efficiency over novelty:</strong> 82% of users cited speed and clear visual hierarchy as their primary requirement.
              </li>
              <li>
                <strong>Mobile vs Desktop split:</strong> While primary work occurs on desktop, 45% perform quick status checks via mobile.
              </li>
              <li>
                <strong>Onboarding drop-off:</strong> Complex initial setups cause a 30% drop in user retention within the first week.
              </li>
            </ul>
          </div>
        </section>

        <!-- SECTION 2: Insight to Action Matrix -->
        <section class="research-section reveal-on-scroll">
          <div class="section-heading">
            <span class="section-tag">02 / Synthesis Matrix</span>
            <h2 class="section-title">Connecting Research to Design Decisions</h2>
            <p class="section-desc">Mapping user friction directly to architectural and component requirements.</p>
          </div>

          <div class="synthesis-grid">
            {researchSynthesis.map((item) => (
              <div class="ui-card synthesis-card hover-lift">
                <span class="synthesis-finding">{item.finding}</span>
                <p class="synthesis-insight"><strong>User Insight:</strong> {item.insight}</p>
                <div class="synthesis-impact">
                  <strong>Design Impact:</strong> {item.impact}
                </div>
              </div>
            ))}
          </div>
        </section>

      </div>
    </div>
  </main>

</Layout>

<script>
  function setupPageInteractions() {
    initScrollReveal();
    initCounters();
  }

  // --- 1. Scroll Reveal Animation Observer ---
  function initScrollReveal() {
    const observerCallback: IntersectionObserverCallback = (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    };

    const scrollObserver = new IntersectionObserver(observerCallback, {
      threshold: 0.08,
      rootMargin: '0px 0px -40px 0px'
    });

    document.querySelectorAll('.reveal-on-scroll').forEach((el) => scrollObserver.observe(el));
  }

  // --- 2. Animated Counter Calculations ---
  function initCounters() {
    const counters = document.querySelectorAll('.count-up');
    const duration = 800; // 0.8s calculation speed

    const counterObserver = new IntersectionObserver((entries, obs) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const targetEl = entry.target as HTMLElement;
          const targetValue = parseFloat(targetEl.dataset.target || '0');
          const suffix = targetEl.dataset.suffix || '';
          const decimals = parseInt(targetEl.dataset.decimals || '0', 10);
          
          let startTime: number | null = null;

          function updateCount(timestamp: number) {
            if (!startTime) startTime = timestamp;
            const progress = Math.min((timestamp - startTime) / duration, 1);
            
            // Cubed EaseOut curve
            const easeOutProgress = 1 - Math.pow(1 - progress, 3);
            const currentCount = easeOutProgress * targetValue;

            targetEl.textContent = currentCount.toFixed(decimals) + suffix;

            if (progress < 1) {
              requestAnimationFrame(updateCount);
            } else {
              targetEl.textContent = targetValue.toFixed(decimals) + suffix;
            }
          }

          requestAnimationFrame(updateCount);
          obs.unobserve(targetEl);
        }
      });
    }, { threshold: 0.2 });

    counters.forEach(counter => counterObserver.observe(counter));
  }

  document.addEventListener('DOMContentLoaded', setupPageInteractions);
  document.addEventListener('astro:page-load', setupPageInteractions);
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');

  html {
    scroll-behavior: smooth;
  }

  /* --- Base Reset & Canvas --- */
  .style-guide-bg {
    position: relative;
    background-color: #f6f5f0;
    color: #1a1a1a;
    min-height: 100vh;
    padding: 40px 24px 120px;
    overflow: hidden;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  .container {
    max-width: 1240px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  /* Ambient Blur Spots */
  .bg-blur-spot {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.35;
    pointer-events: none;
    z-index: 1;
  }

  .spot-1 {
    width: 450px;
    height: 450px;
    top: -100px;
    right: -100px;
    background: radial-gradient(circle, rgba(117, 0, 243, 0.18) 0%, rgba(255, 255, 255, 0) 70%);
  }

  .spot-2 {
    width: 550px;
    height: 550px;
    bottom: 10%;
    left: -150px;
    background: radial-gradient(circle, rgba(117, 0, 243, 0.12) 0%, rgba(255, 255, 255, 0) 70%);
  }

  /* Typography Scale */
  .rs-title,
  .section-title,
  .card-title {
    font-family: 'Instrument Serif', Georgia, serif;
    font-weight: 400;
  }

  /* --- Scroll Reveal Animations --- */
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), 
                transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .reveal-on-scroll.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* --- Header & Navigation --- */
  .rs-header {
    margin-bottom: 40px;
  }

  .header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 28px;
    flex-wrap: wrap;
    gap: 16px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: #444444;
    text-decoration: none;
    padding: 8px 14px;
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(8px);
    border: 1px solid #e5e5de;
    transition: all 0.2s ease;
  }

  .back-link:hover {
    color: #0d0d0d;
    background: #ffffff;
    border-color: #0d0d0d;
  }

  .project-nav {
    display: flex;
    background: rgba(230, 227, 218, 0.7);
    backdrop-filter: blur(12px);
    padding: 4px;
    border-radius: 100px;
    gap: 4px;
    border: 1px solid rgba(255, 255, 255, 0.6);
  }

  .nav-tab {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 18px;
    font-size: 12px;
    font-weight: 600;
    color: #555555;
    text-decoration: none;
    border-radius: 100px;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-tab .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #7500f3;
  }

  .nav-tab.active,
  .nav-tab:hover {
    background: #ffffff;
    color: #0d0d0d;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  }

  /* Hero Banner Card */
  .header-hero {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 20px;
    padding: 36px 40px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
  }

  .tag-wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  .section-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #7500f3;
  }

  .status-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    font-weight: 700;
    background: #eef2ff;
    color: #3730a3;
    padding: 3px 10px;
    border-radius: 100px;
    border: 1px solid #c7d2fe;
  }

  .rs-title {
    font-size: clamp(2.4rem, 4vw, 3.6rem);
    line-height: 1.1;
    color: #0d0d0d;
    margin: 0 0 16px 0;
  }

  .rs-description {
    font-size: 15px;
    line-height: 1.65;
    color: #333333;
    max-width: 900px;
    margin: 0;
  }

  .rs-container {
    display: flex;
    flex-direction: column;
    gap: 64px;
  }

  /* --- Section Cards & Grids --- */
  .research-section {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .section-heading {
    margin-bottom: 8px;
  }

  .section-title {
    font-size: 2.2rem;
    line-height: 1.15;
    color: #0d0d0d;
    margin: 4px 0 8px 0;
  }

  .section-desc {
    font-size: 14px;
    color: #52525b;
    max-width: 600px;
    margin: 0;
  }

  /* Glass Cards */
  .ui-card {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 20px;
    padding: 28px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .hover-lift:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid #eae6db;
  }

  .card-title {
    font-size: 1.6rem;
    color: #0d0d0d;
    margin: 0;
  }

  /* Bullet Lists */
  .clean-bullet-list {
    margin: 0;
    padding-left: 18px;
    font-size: 13.5px;
    color: #4a4a4a;
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .clean-bullet-list li strong {
    color: #0d0d0d;
  }

  /* Metrics Grid */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
  }

  .metric-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: #ffffff;
    border-color: #eae6db;
  }

  .metric-stat {
    font-family: 'JetBrains Mono', monospace;
    font-size: 38px;
    font-weight: 700;
    color: #7500f3;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .metric-label {
    font-size: 13px;
    color: #52525b;
    font-weight: 500;
    margin: 0;
    line-height: 1.45;
  }

  /* Synthesis Matrix */
  .synthesis-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
  }

  .synthesis-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .synthesis-finding {
    font-size: 15px;
    font-weight: 700;
    color: #7500f3;
  }

  .synthesis-insight {
    font-size: 13px;
    line-height: 1.5;
    color: #52525b;
    margin: 0;
  }

  .synthesis-impact {
    font-size: 13px;
    line-height: 1.5;
    color: #0d0d0d;
    background: #f8f7f4;
    padding: 12px 14px;
    border-radius: 12px;
    border-left: 3px solid #7500f3;
  }

  /* Responsive Adjustments */
  @media (max-width: 900px) {
    .header-hero {
      padding: 24px;
    }
  }

  @media (max-width: 768px) {
    .style-guide-bg {
      padding: 24px 16px 80px;
    }

    .header-top {
      flex-direction: column;
      align-items: flex-start;
    }

    .rs-container {
      gap: 48px;
    }
  }
</style>