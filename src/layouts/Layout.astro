---
// src/layouts/Layout.astro
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  hideNav?: boolean; // Toggle site header/footer for standalone layouts
}

const { title = "Lydia Stewart — Portfolio", hideNav = false } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- Native Astro View Transitions for page slide animations -->
    <ClientRouter />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body>
    {hideNav ? (
      /* Clean slot for full-page UI Kit layout without extra padding */
      <slot />
    ) : (
      <div id="page-wrapper">
        <Header />
        <slot />
        <Footer />
      </div>
    )}
  </body>
</html>

<style is:global>
  /* Global CSS Resets */
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html, body {
    min-height: 100%;
    background-color: #ffffff;
    color: #0d0d0d;
    font-family: 'Bodoni Moda', 'Playfair Display', serif;
  }

  #page-wrapper {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100vh;
    padding: 40px 60px;
  }

  @media (max-width: 768px) {
    #page-wrapper {
      padding: 24px;
    }
  }
</style>