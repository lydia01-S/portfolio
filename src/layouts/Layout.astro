---
// src/layouts/Layout.astro
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  hideNav?: boolean; // Toggle site header/footer for standalone layouts
  bg?: string;       // Page background colour. Leave it out to use the site's parchment.
}

const { title = "Lydia Stewart — Portfolio", hideNav = false, bg = "#fcfcee" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" style={`--page-bg: ${bg}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <ClientRouter />

    <!-- 1. Load Lenis core library via CDN -->
    <script src="https://unpkg.com/lenis@1.1.18/dist/lenis.min.js"></script>
  </head>

  <body>
    {hideNav ? (
      /* Clean slot for full-page UI Kit layout without extra padding */
      <slot />
    ) : (
      <div id="page-wrapper">
        <Header />
        <slot />
        <Footer />
      </div>
    )}

    <!-- 2. Global Lenis Initialization Script -->
    <script>
      function initSmoothScroll() {
        const w = window as any;
        const LenisGlobal = w.Lenis;
        if (!LenisGlobal) return;

        // Only ever run one Lenis at a time. Without this, every page change
        // (and the first load, which fires both events below) starts another one.
        if (w.lenisInstance) { w.lenisInstance.destroy(); w.lenisInstance = null; }
        if (w.lenisFrame) { cancelAnimationFrame(w.lenisFrame); w.lenisFrame = null; }

        // People who ask for reduced motion get normal scrolling.
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        const lenis = new LenisGlobal({
          duration: 1.2,
          easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          orientation: 'vertical',
          gestureOrientation: 'vertical',
          smoothWheel: true,
          wheelMultiplier: 1,
          touchMultiplier: 2,
        });

        // Expose instance so index.astro can hook into scroll events
        w.lenisInstance = lenis;

        function raf(time: number) {
          lenis.raf(time);
          w.lenisFrame = requestAnimationFrame(raf);
        }

        w.lenisFrame = requestAnimationFrame(raf);
      }

      // astro:page-load fires on the first load and after every page change
      document.addEventListener('astro:page-load', initSmoothScroll);
    </script>
  </body>
</html>

<style is:global>
  /* --- 1. LENIS CORE CSS --- */
  /* Prevent native smooth scroll from fighting Lenis physics */
  html {
    scroll-behavior: auto !important;
  }

  :focus-visible { outline: 3px solid #3730a3; outline-offset: 3px; }

  @media (prefers-reduced-motion: reduce) {
    .scroll-reveal { opacity: 1; transform: none; transition: none; }
    .scroll-progress-bar, .scroll-top-btn, .cta-primary { transition: none; }
  }

  html.lenis,
  html.lenis body {
    height: auto;
  }

  .lenis.lenis-smooth {
    scroll-behavior: auto !important;
  }

  .lenis.lenis-smooth [data-lenis-prevent] {
    overscroll-behavior: contain;
  }

  .lenis.lenis-stopped {
    overflow: hidden;
  }

  .lenis.lenis-smooth iframe {
    pointer-events: none;
  }

  /* --- 2. GLOBAL LAYOUT CSS --- */
  html, body {
    min-height: 100%;
    font-family: 'Bodoni Moda', 'Playfair Display', serif;
    overflow-x: clip; /* nothing can make the page scroll sideways on a phone */
    -webkit-text-size-adjust: 100%; /* stops iPhones enlarging text when you turn the phone */
    text-size-adjust: 100%;
  }
  img, video, svg { max-width: 100%; }

  /* The page background comes from the bg prop, so each page can choose its own.
     It's set on html too, so overscroll on Mac and phones shows the same colour. */
  html {
    background-color: var(--page-bg, #fcfcee);
  }

  body {
    margin: 0;
    background-color: var(--page-bg, #fcfcee);
    color: #111111;
  }

  #page-wrapper {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100vh;
    min-height: 100svh; /* the real screen height on phones, ignoring the browser bars */
    padding: 40px 60px;
    background-color: var(--page-bg, #fcfcee);
  }

  @media (max-width: 768px) {
    #page-wrapper {
      padding: 20px;
    }
  }
</style>