---
// src/layouts/Layout.astro
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  hideNav?: boolean; // Toggle site header/footer for standalone layouts
}

const { title = "Lydia Stewart — Portfolio", hideNav = false } = Astro.props;
---

<!xhtml>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <ClientRouter />

    <!-- 1. Load Lenis core library via CDN -->
    <script src="https://unpkg.com/lenis@1.1.18/dist/lenis.min.js"></script>
  </head>

  <body>
    {hideNav ? (
      /* Clean slot for full-page UI Kit layout without extra padding */
      <slot />
    ) : (
      <div id="page-wrapper">
        <Header />
        <slot />
   
      </div>
    )}

    <!-- 2. Global Lenis Initialization Script -->
    <script>
      function initSmoothScroll() {
        const LenisGlobal = (window as any).Lenis;
        if (!LenisGlobal) return;

        const lenis = new LenisGlobal({
          duration: 1.2,
          easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          orientation: 'vertical',
          gestureOrientation: 'vertical',
          smoothWheel: true,
          wheelMultiplier: 1,
          touchMultiplier: 2,
        });

        // Expose instance so index.astro can hook into scroll events
        (window as any).lenisInstance = lenis;

        function raf(time: number) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }

        requestAnimationFrame(raf);
      }

      // Initialize on load & Astro View Transitions navigation
      document.addEventListener('DOMContentLoaded', initSmoothScroll);
      document.addEventListener('astro:page-load', initSmoothScroll);
    </script>
  </body>
</html>

<style is:global>
  /* --- 1. LENIS CORE CSS --- */
  /* Prevent native smooth scroll from fighting Lenis physics */
  html {
    scroll-behavior: auto !important;
  }

  html.lenis, 
  html.lenis body {
    height: auto;
  }

  .lenis.lenis-smooth {
    scroll-behavior: auto !important;
  }

  .lenis.lenis-smooth [data-lenis-prevent] {
    overscroll-behavior: contain;
  }

  .lenis.lenis-stopped {
    overflow: hidden;
  }

  .lenis.lenis-smooth iframe {
    pointer-events: none;
  }

  /* --- 2. GLOBAL LAYOUT CSS --- */
  html, body {
    min-height: 100%;
    font-family: 'Bodoni Moda', 'Playfair Display', serif;
  }

  body {
    margin: 0;
    background-color: #fcfcee; /* Warm parchment base */
    color: #111111;
    overflow-x: hidden;
  }

  #page-wrapper {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100vh;
    padding: 40px 60px;
    background-color: #fcfcee
  }

  @media (max-width: 768px) {
    #page-wrapper {
      padding: 24px;
    }
  }
</style>