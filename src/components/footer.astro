---
interface Props {
  name?: string;
  email?: string;
  role?: string;
}

const {
  name = "LYDIA STEWART",
  email = "LYDIASTEW01@GMAIL.COM",
  role = "( CREATIVE DESIGN )",
} = Astro.props;
---

<footer id="footer-info">
  <div class="col left">
    <p class="name">{name}</p>
    <a href={`mailto:${email.toLowerCase()}`} class="email">{email}</a>
    <p> 087 453 7335 </p>
  </div>

  <div class="col center">
    <p class="role">{role}</p>
  </div>

  <div class="col right">

  </div>
</footer>

<style>
  #footer-info {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
    width: 100%;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #1a1a1a;
    line-height: 1.5;
  }

  .col {
    display: flex;
    flex-direction: column;
  }

  .col.center {
    align-items: center;
    text-align: center;
  }

  .col.right {
    align-items: flex-end;
    text-align: right;
  }

  .tag {
    margin-bottom: 12px;
    color: #333;
  }

  .name {
    font-weight: 600;
  }

  a {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  a:hover {
    opacity: 0.6;
  }

  @media (max-width: 768px) {
    #footer-info {
      grid-template-columns: 1fr;
      gap: 24px;
      align-items: start;
    }

    .col.center, .col.right {
      align-items: flex-start;
      text-align: left;
    }
  }
</style>