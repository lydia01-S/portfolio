---
interface Props {
  name?: string;
  role?: string;
  email?: string;
  phone?: string; // as you'd say it, e.g. "087 453 7335"
}

const {
  name = "Lydia Stewart",
  role = "UI designer",
  email = "lydiastew01@gmail.com",
  phone = "087 453 7335",
} = Astro.props;

// Turn "087 453 7335" into "+353874537335" so phones can dial it from a tap.
const tel = phone ? '+353' + phone.replace(/\s/g, '').replace(/^0/, '') : '';


const profiles: { label: string; href: string }[] = [
  // { label: "LinkedIn", href: "https://www.linkedin.com/in/your-name" },
];

const links = [
  { href: '/', label: 'Home' },
  { href: '/aboutMe', label: 'About' },
  { href: '/work', label: 'Work' },
  { href: '/contact', label: 'Contact' }
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="top">
    <div class="intro">
      <p class="name">{name}</p>
      <p class="role">{role}</p>
      <p class="pitch">I'd love to hear about your team.</p>
    </div>

    <div class="contact">
      <p class="label">Get in touch</p>
      <a class="email" href={`mailto:${email}`}>{email}</a>
      {phone && <a class="phone" href={`tel:${tel}`}>{phone}</a>}
      {profiles.length > 0 && (
        <ul class="profiles">
          {profiles.map((p) => (
            <li><a href={p.href} target="_blank" rel="noopener noreferrer">{p.label}<span class="sr"> (opens in a new tab)</span></a></li>
          ))}
        </ul>
      )}
    </div>

    <nav class="links" aria-label="Footer">
      <p class="label">Pages</p>
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
  </div>

  <div class="bottom">
    <p>© {year} {name}</p>
    <p>Designed in Figma and built in Astro by me.</p>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    margin-top: 96px;
    padding-top: 40px;
    border-top: 1px solid rgba(17, 17, 17, .12);
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    color: #111;
  }
  .site-footer p { margin: 0; }
  .site-footer ul { list-style: none; margin: 0; padding: 0; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .top {
    display: grid;
    grid-template-columns: 1.4fr 1fr auto;
    gap: 40px 64px;
    align-items: start;
  }

  /* Name, matching the header */
  .name { font: 600 22px/1.1 'Bodoni Moda', 'Playfair Display', Georgia, serif; letter-spacing: -0.01em; }
  .role {
    margin-top: 4px !important;
    font: 500 11px/1.4 'JetBrains Mono', ui-monospace, monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #555;
  }
  .pitch { margin-top: 16px !important; font-size: 15px; line-height: 1.55; color: #444; max-width: 32ch; }

  .label {
    margin-bottom: 8px !important;
    font: 500 11px/1.4 'JetBrains Mono', ui-monospace, monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #555;
  }

  /* Contact: the email is the main action, so it's the largest link */
  .contact { display: flex; flex-direction: column; align-items: flex-start; }
  .contact a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #111;
    text-decoration: underline;
    text-decoration-color: rgba(17, 17, 17, .3);
    text-underline-offset: 5px;
    transition: text-decoration-color .2s ease;
  }
  .contact a:hover { text-decoration-color: #111; }
  .email { font: 500 clamp(1.1rem, 2vw, 1.35rem)/1.3 'Bodoni Moda', 'Playfair Display', Georgia, serif; overflow-wrap: anywhere; }
  .phone { font-size: 15px; }
  .profiles { display: flex; flex-wrap: wrap; gap: 0 20px; }
  .profiles a { font-size: 15px; }

  /* Page links */
  .links ul { display: flex; flex-direction: column; }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    font-size: 15px;
    color: #444;
    text-decoration: none;
    transition: color .2s ease;
  }
  .links a:hover { color: #111; text-decoration: underline; text-underline-offset: 4px; }

  .bottom {
    display: flex;
    justify-content: space-between;
    gap: 8px 24px;
    flex-wrap: wrap;
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid rgba(17, 17, 17, .08);
    font-size: 13px;
    color: #555;
    padding-right: 72px; /* keeps this line clear of the back-to-top button */
  }

  @media (max-width: 860px) {
    .top { grid-template-columns: 1fr 1fr; }
    .intro { grid-column: 1 / -1; }
  }
  @media (max-width: 560px) {
    .site-footer { margin-top: 64px; padding-top: 32px; }
    .top { grid-template-columns: 1fr; gap: 32px; }
    .links ul { flex-direction: row; flex-wrap: wrap; gap: 0 20px; }
    .bottom { flex-direction: column; }
  }
  @media (prefers-reduced-motion: reduce) {
    .contact a, .links a { transition: none; }
  }
</style>