<button class="btt" type="button" aria-label="Back to top">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 15l-6-6-6 6"/></svg>
</button>

<style>
  .btt {
    position: fixed; right: 24px; bottom: 24px; z-index: 40; width: 48px; height: 48px;
    display: grid; place-items: center; background: #1f2430; color: #fff; border: 0; border-radius: 50%;
    box-shadow: 0 8px 28px rgba(31, 36, 48, .08); cursor: pointer;
    opacity: 0; visibility: hidden; transition: opacity .2s, visibility .2s, transform .2s, background .2s;
  }
  .btt.show { opacity: 1; visibility: visible; }
  .btt:hover { transform: translateY(-2px); background: #3f6b52; }
  .btt:focus-visible { outline: 3px solid #3f6b52; outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) { .btt { transition: none; } }
</style>

<script>
  const sync = () => document.querySelector('.btt')?.classList.toggle('show', window.scrollY > 500);
  addEventListener('scroll', sync, { passive: true });
  document.addEventListener('click', (e) => {
    if ((e.target as Element).closest('.btt')) {
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      scrollTo({ top: 0, behavior: still ? 'auto' : 'smooth' });
    }
  });
  document.addEventListener('astro:page-load', sync);
  sync();
</script>