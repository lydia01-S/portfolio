---
interface Props {
  year?: string;
}

const { year = "2026" } = Astro.props;
---

<main id="hero">
  <h1 class="heading-welcome">welcome to my</h1>
  <div class="heading-portfolio-wrapper">
    <span class="heading-portfolio">portfolio</span>
    <sup class="year">{year}</sup>
  </div>
</main>

<style>
  #hero {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 60px 0;
  }

  .heading-welcome {
    font-family: 'Bodoni Moda', 'Playfair Display', serif;
    font-size: clamp(3.5rem, 8vw, 7.5rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1;
    color: #0c0c0c;
  }

  .heading-portfolio-wrapper {
    position: relative;
    display: inline-block;
    margin-top: -10px;
  }

  .heading-portfolio {
    font-family: 'Bodoni Moda', 'Playfair Display', serif;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(4rem, 10vw, 9.5rem);
    line-height: 0.9;
    color: #0c0c0c;
  }

  

  .year {
    font-family: 'Bodoni Moda', 'Playfair Display', serif;
    font-size: clamp(1rem, 2vw, 1.75rem);
    font-weight: 400;
    position: absolute;
    top: 15%;
    right: -3.5rem;
    font-style: normal;
  }

  @media (max-width: 768px) {
    .year {
      right: -2rem;
    }
  }
</style>